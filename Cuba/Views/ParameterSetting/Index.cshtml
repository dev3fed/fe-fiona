@{
    ViewData["Title"] = "Chart-Widget";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" type="text/css" href="~/assets/css/parameter-setting.css">
<div class="page-body">
    <div class="container-fluid">
        <div class="page-title">
            <div class="row">
                <div class="col-6">
                    <h3>Parameter Setting</h3>
                </div>
                <div class="col-6">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-controller="HomePage" asp-action="Index">
                                <svg class="stroke-icon">
                                    <use href="../assets/svg/icon-sprite.svg#stroke-home"></use>
                                </svg>
                            </a>
                        </li>
                        <li class="breadcrumb-item active">Parameter Setting</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <!-- Container-fluid starts-->
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-12">
                <div class="card" style="border-radius:8px">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-2 p-0">
                                <div class="nav flex-column nav-pills nav-primary gap-2" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                                    <a class="nav-link active" id="v-pills-competency-tab" data-bs-toggle="pill" href="#v-pills-competency" role="tab" aria-controls="v-pills-competency" aria-selected="true" style="font-size: 13px;">Mandatory Competency</a>
                                    <a class="nav-link" id="v-pills-general-tab" data-bs-toggle="pill" href="#v-pills-general" role="tab" aria-controls="v-pills-general" aria-selected="false"  style="font-size: 13px;"><span>General Competency</span></a>
                                    <a class="nav-link" id="v-pills-skill-group-tab" data-bs-toggle="pill" href="#v-pills-skill-group" role="tab" aria-controls="v-pills-skill-group" aria-selected="false"  style="font-size: 13px;"><span> Skill Group Weight</span></a>
                                </div>
                            </div>
                            <div class="col-md-10">
                                <div class="tab-content" id="v-pills-tabContent">
                                    <div class="tab-pane fade show active" id="v-pills-competency" role="tabpanel" aria-labelledby="v-pills-competency-tab">
                                        <div class="mt-2">
                                            <span class="f-12">Last update on 18/08/2024, 08:30 by Dasa (Superadmin)</span>
                                            <div class=" scrollable-table table-wrapper mt-2" style=" max-height: 470px;">
                                                <table class="tbl custom-border-table " style=" table-layout: fixed;">
                                                    <thead id="table-header">
                                                    <tbody id="table-body">
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="tab-pane fade" id="v-pills-general" role="tabpanel" aria-labelledby="v-pills-general-tab">
                                        <div class="mt-2">
                                            <span class="f-12">Last update on 18/08/2024, 08:30 by Dasa (Superadmin)</span>
                                            <div class="media mb-2 switch-sm">
                                                <label class="switch">
                                                    <input type="checkbox" checked="" id="editProficiency"><span class="switch-state"></span>
                                                </label>
                                                <span class="f-12 align-self-flex-end ml-2" style="padding: 8px;">Edit proficiency level general competency</span>
                                            </div>
                                        </div>
                                        <div class="">
                                            <span class="p-2 f-12 bg-warning-outline-custom">
                                            By activate this feature, proficiency level of general competency can be changed below the previous level.
                                            </span>
                                        </div>
                                    </div>
                                    <div class="tab-pane fade" id="v-pills-skill-group" role="tabpanel" aria-labelledby="v-pills-skill-group-tab">
                                        <div class="mt-2">
                                            <span class="f-12">Last update on 18/08/2024, 08:30 by Dasa (Superadmin)</span>
                                            <div class=" mt-2" style=" ">
                                                <table class="tableMasterData table table-hover w-100" id="draftList">
                                                    <thead id="">
                                                        <tr>
                                                            <th class="text-center">No</th>
                                                            <th class="text-center">Total Skill Group per Position</th>
                                                            <th class="text-center">SG & SSG 1</th>
                                                            <th class="text-center">SG & SSG 2</th>
                                                            <th class="text-center">SG & SSG 3</th>
                                                            <th class="text-center">Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="table-body-skill-group">
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <partial name="~/Views/Competency/ModalDetailCompe.cshtml" />
    <partial name="~/Views/ParameterSetting/ModalEditDepthLevel.cshtml" />
    <partial name="~/Views/ParameterSetting/ModalSkillGroup.cshtml" />
    <partial name="~/Views/ParameterSetting/ModalConfirm.cshtml" />

    <!-- Container-fluid Ends-->
</div>
@section Script {
    <!-- Plugins JS start-->
    <script src="../assets/js/sidebar-menu.js"></script>
    <script src="../assets/js/slick/slick.min.js"></script>
    <script src="../assets/js/slick/slick.js"></script>
    <script src="../assets/js/header-slick.js"></script>
    <script src="../assets/js/sweet-alert/sweetalert.min.js"></script>

    <!-- Plugins JS Ends-->
    <!-- Theme js-->
    <script src="../assets/js/parameter-setting/constant.js"></script>
    <script src="../assets/js/parameter-setting/endpoint.js"></script>
    <script src="../assets/js/parameter-setting/helper.js"></script>
    <script src="../assets/js/parameter-setting/index.js"></script>
    <script src="../assets/js/script.js"></script>
}