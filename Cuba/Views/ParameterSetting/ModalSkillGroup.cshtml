<!-- Include Animate.css -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    .modal-dialog.custom-depthlevel {
        max-width: 35% !important;
        margin: 90px auto;
    }
</style>


<div class="modal fade" id="modalSkillGroup" tabindex="-1" role="dialog" aria-labelledby="modalSkillGroupLabel"
    aria-hidden="true">
    <div class="modal-dialog custom-depthlevel bounceInDown animated" role="document">
        <div class="modal-content" style="border-radius: 8px;">
            <div class="modal-header">
                <h5 class="modal-title" id="modalSkillGroupTitle">Edit Skill Group Weight</h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="modal-body-content">
                <div class="row mb-4">
                    <span class="text-muted f-12 font-weight-400">Total Skill Group</span>
                    <br>
                    <span class="f-14 font-weight-600">2 Skill Group</span>
                </div>
                <div class="mb-4 row" id="form-edit-skill-group">
                </div>
                <div class="mb-4 totalWeight" id="total-weight">
                </div>
            </div>
            <div class="modal-footer  ">
                <button class="btn btn-outline-light" type="button" data-bs-dismiss="modal"><i
                        class="icon-arrow-left"></i>
                    Back</button>
                <div>
                    <button class="btn btn-primary" id="btnSaveSkillGroup" type="button"
                        onclick="saveSkillGRoupChanges()"> Save</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Bootstrap JS and Popper.js -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/js/bootstrap.min.js"></script>
