@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Chart-Widget";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .page-wrapper {
        overflow:visible !important;
    }
    #sticky-os-header {
        position: -webkit-sticky; /* For Safari */
        position: sticky !important;
        top: 75px !important; /* Adjusted to ensure it sticks at the top */
        z-index: 2;
        background-color: #fff;
    }

    .container-fluid, .page-body {
        overflow: visible !important; /* Ensure parent elements do not restrict sticky behavior */
        height: 100%; /* Ensure parent elements have a defined height */
    }

    html, body {
        height: 100%; /* Ensure the root elements have a defined height */
    }


    .checkbox-solid-primary label:before {
        background-color: var(--theme-deafult);
        border-color: var(--theme-deafult);
        color: #fff;
    }
    .checkbox input[type="checkbox"]:checked + label::before {
        font-family: themify;
        content: "\e64c";
        text-align: center;
        line-height: 1.2;
        background: #006CA9;
        color: #fff;
    }
    .border-custom {
        border: 1px solid #EAEAEB;
        @* border-radius: 10px; *@
    }
    .widget-1:hover {
    /* transform: translateY(-5px); */
    /* transition: 0.5s; */
    transform: none;
    transition: none;
    }
    .ellipsis {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        width: 150px;
        }
    .no-box-shadow {
        box-shadow: none !important;
    }
    .widget-1 {
        background-image: none;
    }
    .chart-container {
        display: flex;
        align-items: center;
        width: 100%;            /* Pastikan tidak melebihi kolom card */
    }

    #rasci-notations{
        display: flex;
        gap:10px;
        width: 100%;            /* Pastikan tidak melebihi kolom card */
    }

    .card-buspro {
        box-shadow: 0px 0px 0px 0px !important;
        margin: 0px !important;
    }
    .card-rasci-notations {
        box-shadow: 0px 0px 0px 0px !important;
        margin: 0px !important;
        width: 23%;
    }

    .chart-label {
        writing-mode: vertical-lr;
        transform: rotate(180deg);
        width: 60px;
        font-size: 14px;
        font-weight: bold;
        text-align: center;
        color: #9F9FA5;
        margin: 0px !important;
        padding-bottom: 0px;
    }

    .widget-round-buspro{
        border-width: 0px !important;
    }

    .bg-round-buspro{
        box-shadow: 0px 0px 0px 0px !important;
    }

    .card-body-buspro {
        border: solid 1px #EAEAEB;
        border-radius: 10px;
    }
    #chart-competency-spesific{
        width: 95% !important;
        max-width: 100% !important;
        height: 800px !important;
    }

    #chart-rasci-buspro-level, #chart-rasci-position-level, #chart-rasci-notaions-formation,#chart-os-position-level {
        max-width: 100% !important;
        height: 500px !important;
    }
    .m-checkbox-inline label {
        margin-right: 2px !important;
    }
    @* .select2-selection__rendered li.select2-selection__choice {
        display: none !important;
        } *@
        /* Change the background color of the Select2 dropdown */
       
</style>

