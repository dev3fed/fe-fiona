<link rel="stylesheet" type="text/css" href="~/assets/css/organization-structure.css">
<div class="modal fade" id="modalPreviewOrgChart" tabindex="-1" role="dialog" aria-labelledby="modalPreviewOrgChart" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="">Preview Org Chart</h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row mt-4">
                    <div class="col-4 align-content-center">
                        <select class="form-select digits" name="searchOrgNode" id="searchOrgNode">
                            <option></option>
                        </select>
                    </div>
                    <div class="col-1" style="padding-left: 0">
                        <button class="btn btn-primary w-100" type="button" id="searchOrgNodeButton">Search</button>
                    </div>
                    <div class="col-5 offset-2 d-flex gap-3 justify-content-end" style="padding-left: 0;">
                        @* span *@
                        <div class="d-flex gap-2 align-items-center align-self-center"> 
                            <div class="square bg-primary-outline-custom"></div>
                            <span>New / Edited Position</span>
                        </div>
                        @* <div class="d-flex gap-2 align-items-center align-self-center"> 
                            <div class="square bg-warning-outline-custom"></div>
                            <span>Edited Position</span>
                        </div> *@
                        <div class="d-flex gap-2 align-items-center align-self-center"> 
                            <div class="square bg-danger-outline-custom"></div>
                            <span>Deleted Position</span>
                        </div>
                            
                    </div>
                    <div class="col-12 mt-2">
                        <!-- Chart Container - ISOLATED from Bootstrap Grid -->
                        <div class="chart-container-custom" style="background-color: aliceblue;"></div>
                        
                        <div class="card-body" style="padding:15px 5px 15px 5px !important">
                            <div class="row">
                                <div class="col-12 mt-2">
                                    <button class="btn btn-primary btn-sm" onclick="chartExportIMG()">Export Image</button>
                                    <button class="btn btn-primary btn-sm" onclick="chartExportSVG()">Export SVG</button>
                                    <button class="btn btn-primary btn-sm" onclick="chartExportPDF()">Export PDF</button>
                                    @* <button class="btn btn-primary btn-sm" onclick="chartExportPDFTest()">Export Test</button> *@
                                    @* <button class="btn btn-primary btn-sm" onclick="chart.fit();">Fit to the screen</button> *@
                                    <button class="btn btn-primary btn-sm" onclick="chartFit()">Fit to the screen</button>
                                    @* zoom in zoom out *@
                                    @* <button onclick="chart.zoomIn();" class="btn btn-primary btn-sm">
                                        <i class="fas fa-search-plus"></i> zoom in
                                    </button> *@
                                    <button onclick="chartZoomIn()" class="btn btn-primary btn-sm">
                                        <i class="fas fa-search-plus"></i> zoom in
                                    </button>
                                    <button onclick="chartZoomOut()" class="btn btn-primary btn-sm">
                                        <i class="fas fa-search-minus"></i> zoom out
                                    </button>
                                    <button onclick="chartCompact()" class="btn btn-primary btn-sm">
                                    @* <button onclick="chart.compact(!!(compact++%2)).render().fit();" class="btn btn-primary btn-sm"> *@
                                        <i class="fas fa-sitemap"></i> compact
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer" >
                <div class="text-end " id="">
                    <button class="btn btn-outline-light" type="button" data-bs-dismiss="modal">
                        Back
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
