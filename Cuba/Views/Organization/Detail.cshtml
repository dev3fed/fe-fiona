@{
    ViewData["Title"] = "Chart-Widget";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .os-container {
        height: 480px;
        background-color: #F5F5F5;
    }
</style>
<div class="page-body">
    <div class="container-fluid">
        <div class="page-title">
            <div class="row">
                <div class="col-6">
                    <h3>Create New Job</h3>
                </div>
                <div class="col-6">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-controller="HomePage" asp-action="Index">
                                <svg class="stroke-icon">
                                    <use href="../assets/svg/icon-sprite.svg#stroke-home"></use>
                                </svg>
                            </a>
                        </li>
                        <li class="breadcrumb-item ">Organization Structure</li>
                        <li class="breadcrumb-item active">Create New Job</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <!-- Container-fluid starts-->
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-12">
                <div class="card" style="border-radius:8px">
                    @* step attr *@
                    <div class="" style="height:1000px">
                        <div class="step-capsule p-t-20 p-b-2" style="">
                            <span class="capsule active p-2 text-center" style="z-index:2;display: flex;justify-content: end;width:150px"> 
                                <span class="capsule-number active" style="">1</span>
                                <span class="" style="">Input Atribute</span>
                            </span>
                            <span class="capsule  p-2 text-center " style="z-index:2;display: flex;justify-content: end;width:180px"> 
                                <span class="capsule-number " style="">2</span> 
                                Input Subordinate
                            </span>
                            <span class="capsule  p-2 text-center " style="z-index:2;display: flex;justify-content: end;width:160px"> 
                                <span class="capsule-number " style="">3</span> 
                                Input SG & SSG
                            </span>
                            <span class="capsule  p-2 text-center " style="z-index:2;display: flex;justify-content: end;width:115px"> 
                                <span class="capsule-number " style="">4</span> 
                                Preview
                            </span>
                            @* hr *@
                            <hr style="position: absolute;width: 95%; margin-top: 20px; margin-bottom: 10px;z-index: 1;" />

                        </div>
                        <div class="card p-t-10">
                            <div class="card-body">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label" for="validationDefault02">Last name</label>
                                            <input class="form-control" id="validationDefault02" type="text" placeholder="Last name" required="">
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label" for="validationDefault02">Last name</label>
                                            <input class="form-control" id="validationDefault02" type="text" placeholder="Last name" required="">
                                        </div>
                                        <div class="col-md-6">
                                            <div class="media-body switch-sm d-flex align-items-center justify-content-between w-100">
                                                <label class="reset-label mb-0" for="validationDefault01">Reset</label>
                                                <div class="d-flex align-items-center">
                                                    <label class="switch m-0">
                                                        <input type="checkbox" checked=""><span class="switch-state"></span>
                                                    </label>
                                                    <label class="col-form-label mb-0" style="margin-top: -4px; margin-left: 5px;">Director</label>
                                                </div>
                                            </div>
                                            <input class="form-control m-t-5" id="validationDefault01" type="text" placeholder="First name" required="">
                                        </div>
                                        
                                        <div class="col-md-4 mb-3">
                                            <label class="form-label" for="validationDefaultUsername">Username</label>
                                            <div class="input-group">
                                                <span class="input-group-text" id="inputGroupPrepend2">@Html.Raw("@")</span>
                                                <input class="form-control" id="validationDefaultUsername" type="text" placeholder="Username" aria-describedby="inputGroupPrepend2" required="">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label" for="validationDefault03">City</label>
                                            <input class="form-control" id="validationDefault03" type="text" placeholder="City" required="">
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label" for="validationDefault04">State</label>
                                            <select class="form-select" id="validationDefault04" required="">
                                                <option selected="" disabled="" value="">Choose...</option>
                                                <option>...</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3 mb-3">
                                            <label class="form-label" for="validationDefault05">Zip</label>
                                            <input class="form-control" id="validationDefault05" type="text" placeholder="Zip" required="">
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <div class="form-check">
                                            <div class="checkbox p-0">
                                                <input class="form-check-input" id="invalidCheck2" type="checkbox" required="">
                                                <label class="form-check-label" for="invalidCheck2">Agree to terms and conditions</label>
                                            </div>
                                        </div>
                                    </div>
                                    <button class="btn btn-primary" type="submit">Submit form</button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Container-fluid Ends-->
</div>
@section Script {
    <!-- Plugins JS start-->
    <script src="../assets/js/sidebar-menu.js"></script>
    <script src="../assets/js/slick/slick.min.js"></script>
    <script src="../assets/js/slick/slick.js"></script>
    <script src="../assets/js/header-slick.js"></script>
    <script src="../assets/js/scrollable/perfect-scrollbar.min.js"></script>
    <script src="../assets/js/scrollable/scrollable-custom.js"></script>

    <!-- Plugins JS Ends-->
    <!-- Theme js-->
    <script src="../assets/js/script.js"></script>
}

<style>
    .step-capsule{
        display: flex;
        justify-content: space-evenly;
    }

    .capsule{
        text-align: center; 
        position:relative;
        padding: 8px ;
        gap: 4px;
        border-radius: 20px 20px 20px 20px;
        border: 1px 0px 0px 0px;
        opacity: 0px;
        font-size: 15px;
        color: #BFBFC2;
        background-color: #fff;
    }

    .capsule-number{
        background-color: #BFBFC2;
        color: white;
        border-radius: 50%;
        padding: 8px 11px;
        position: absolute;
        left: 0;
        top: 0;
        font-weight: bold;
    }

    .capsule.active{
        padding: 8px ;
        gap: 4px;
        border-radius: 20px 20px 20px 20px;
        border: 1px 0px 0px 0px;
        opacity: 0px;
        background-color: #E6F0F6;
        border: 1px solid #006CA9;  
        color: #006CA9; 
    }

    .capsule-number.active{
        background-color: #006CA9;
        color: white;
        border-radius: 50%;
        padding: 8px 11px;
        position: absolute;
        left: 0;
        top: 0;
    }
</style>