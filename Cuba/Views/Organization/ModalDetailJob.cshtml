                            Position List
                        </div>
                        <div class="row m-t-10">
                            <div class="col-12" id="positionList" style="">
                                <table class="tableMasterData table table-hover w-100 m-t-10" id="tablePositionList" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th>No</th>
                                            <th>Position Name</th>
                                            <th>Career Level</th>
                                            <th>Job Grade</th>
                                            <th>Formation</th>
                                        </tr> 
                                    </thead>
                                    <tbody id="tablePositionListBody">
                                    </tbody>
                                </table>
                            </div>
                        </div>
