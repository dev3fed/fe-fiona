<link rel="stylesheet" type="text/css" href="~/assets/css/organization-structure.css">

<div class="modal fade" id="modalDetailJob" tabindex="-1" role="dialog" aria-labelledby="modalJobInfo" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalJobInfoHeader">Job Info</h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div style="padding:5px">
                    <h5 class="f-w-600" id="jobName">Job Name</h5>
                    <input type="text" class="form-control" id="positionCode" hidden>
                    <!-- Card info start-->
                    <div class="custom-card-draft">
                        <div class="header-card-draft">
                            Job Attribute
                        </div>
                        <div class="row p-20 p-t-30" >
                            <div class="col-3">
                                <span style="font-size: 12px;">Directorate</span>
                                <br>
                                <span id="modalDirectorate"
                                style="font-size:16px" class="f-w-600">-</span>
                            </div>
                            <div class="col-3">
                                <span style="font-size: 12px;">Division</span>
                                <br>
                                <span id="modalDivision"
                                style="font-size:16px" class="f-w-600">-</span>
                            </div>
                            <div class="col-3">
                                <span style="font-size: 12px;">Sub Division</span>
                                <br>
                                <span id="modalSubDivision"
                                style="font-size:16px" class="f-w-600">-</span>
                            </div>
                            <div class="col-3">
                                <span style="font-size: 12px;">Department</span>
                                <br>
                                <span id="modalDepartment"
                                style="font-size:16px" class="f-w-600">-</span>
                            </div>
                            <hr class="m-t-20">
                            <div class="col-3">
                                <span style="font-size: 12px;">Section</span>
                                <br>
                                <span id="modalSection"
                                style="font-size:16px" class="f-w-600">-</span>
                            </div>
                            <div class="col-3">
                                <span style="font-size: 12px;">Org Unit Name</span>
                                <br>
                                <span id="modalOrgUnitName"
                                style="font-size:16px" class="f-w-600">-</span>
                            </div>
                            <div class="col-3">
                                <span style="font-size: 12px;">Org PRL</span>
                                <br>
                                <span id="modalOrgPRL"
                                style="font-size:16px" class="f-w-600">-</span>
                            </div>
                            <div class="col-3">
                                <span style="font-size: 12px;">Career Type</span>
                                <br>
                                <span id="modalCareerType"
                                style="font-size:16px" class="f-w-600">-</span>
                            </div>
                            <hr class="m-t-20">
                            <div class="col-3">
                                <span style="font-size: 12px;">Career Level</span>
                                <br>
                                <span id="modalCareerLevel"
                                style="font-size:16px" class="f-w-600">-</span>
                            </div>
                            <div class="col-3">
                                <span style="font-size: 12px;">Direct Report</span>
                                <br>
                                <span id="modalDirectReport"
                                style="font-size:16px" class="f-w-600">-</span>
                            </div>
                            <div class="col-3">
                                <span style="font-size: 12px;">Personnel Area Name</span>
                                <br>
                                <span id="modalPersonnelAreaName"
                                style="font-size:16px" class="f-w-600">KP Jakarta</span>
                            </div>
                            <div class="col-3">
                                <span style="font-size: 12px;">Personnel Area Subname</span>
                                <br>
                                <span id="modalPersonnelAreaSubname"
                                style="font-size:16px" class="f-w-600">-</span>
                            </div>
                            <hr class="m-t-20">
                            <div class="col-5">
                                <span style="font-size: 12px;">SK Number</span>
                                <br>
                                <span id="modalSKNumber"
                                style="font-size:16px" class="f-w-600">-</span>
                            </div>
                        </div>
                    </div>
                    <!-- Card info end-->

                    <div class="custom-card-draft">
                        <div class="header-card-draft">
                            Skill Group & Sub Skill Group
                        </div>
                        <div style="padding-top: 20px;display:flex" >
                            <div style="padding:10px;margin:10px;border:1px solid #EAEAEB;width: 33%;border-radius: 5px;">
                                <div style="margin: 10px;">
                                    <span style="font-size: 12px;">Main Skill Group</span>
                                    <br>
                                    <span 
                                    id="modalMainSkillGroup"
                                    class="f-w-600" style="font-size: 16px;">-</span>
                                    <br>
                                </div>
                                <div style="margin: 10px;">
                                    <span style="font-size: 12px;">Main Sub Skill Group</span>
                                    <br>
                                    <span 
                                    id="modalMainSubSkillGroup"
                                    class="f-w-600" style="font-size: 16px;">-</span>
                                    <br>
                                </div>
                            </div>
                            <div style="padding:10px;margin:10px;border:1px solid #EAEAEB;width: 33%;border-radius: 5px;">
                                <div style="margin: 10px;">
                                    <span style="font-size: 12px;">Second Skill Group</span>
                                    <br>
                                    <span 
                                    id="modalSecondSkillGroup"
                                    class="f-w-600" style="font-size: 16px;">-</span>
                                    <br>
                                </div>
                                <div style="margin: 10px;">
                                    <span style="font-size: 12px;">Second Sub Skill Group</span>
                                    <br>
                                    <span 
                                    id="modalSecondSubSkillGroup"
                                    class="f-w-600" style="font-size: 16px;">-</span>
                                    <br>
                                </div>
                            </div>
                            <div style="padding:10px;margin:10px;border:1px solid #EAEAEB;width: 33%;border-radius: 5px;">
                                <div style="margin: 10px;">
                                    <span style="font-size: 12px;">Third Skill Group</span>
                                    <br>
                                    <span 
                                    id="modalThirdSkillGroup"
                                    class="f-w-600" style="font-size: 16px;">-</span>
                                    <br>
                                </div>
                                <div style="margin: 10px;">
                                    <span style="font-size: 12px;">Third Sub Skill Group</span>
                                    <br>
                                    <span 
                                    id="modalThirdSubSkillGroup"
                                    class="f-w-600" style="font-size: 16px;">-</span>
                                    <br>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="custom-card-draft">
                        <div class="header-card-draft">
                            Incumbent
                        </div>
                        <div class="row m-t-10">
                            <div class="col-5" style="display: flex;justify-content: space-between;padding:20px;">
                                <div>
                                    <span style="font-size: 12px;">Employee ID</span>
                                    <br>
                                    <span id="incumbentId""
                                    style="font-size:16px" class="f-w-600">746757</span>
                                </div>
                                <div>
                                    <span style="font-size: 12px;">Employee Name</span>
                                    <br>
                                    <span id="incumbentName""
                                    style="font-size:16px" class="f-w-600">John Doe</span>
                                </div>
                                <div>
                                    <span style="font-size: 12px;">PRL Plan Comp</span>
                                    <br>
                                    <span id="prlPlanComp"
                                    style="font-size:16px" class="f-w-600">19</span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <div class="text-end ">
                    <button class="btn btn-outline-light" type="button" data-bs-dismiss="modal">
                        Back
                    </button>
                    <button class="btn btn-outline-light" type="button" onclick="handleDeleteJob()">
                        <i class="icon-trash" style="font-size: 1em;"></i> Delete
                    </button>
                    <button class=" btn btn-outline-light" type="button" onclick="handleEditJob()">
                        <img src="~/assets/images/rasci/pen_outline.svg" alt="Filter Icon" style="margin-right: 8px;">Edit
                    </button>
                    <button class="btn btn-primary" type="button" onclick="showJobDesc()"> Show Jobdesc </button>
                    <button class="btn btn-primary" type="button" onclick="showRasciMatrix()"> Show Rasci Matrix </button>
                </div>
            </div>
        </div>
    </div>
</div>




