<link rel="stylesheet" type="text/css" href="~/assets/css/organization-structure.css">
<div class="modal fade" id="modalUploadFinalized" tabindex="-1" role="dialog" aria-labelledby="modalUploadFinalized" >
    <div class="modal-dialog modal-md" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalConfirm">modal Title</h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="card-body">
                <div id="after-finalize" style="display: none;">
                    <div class="row">
                        <div class="col-md-12">
                            <span class="label-warning-custom f-16 b-r-8 p-15 w-100">Finalize data will affect to master data</span>
                        </div>
                    </div>
                    <div class="p-15 row b-grey b-r-8 m-l-5 m-r-5 m-t-10">
                        <div class="col-md-1">
                            <img src="../assets/images/organization-structure/excel.png" alt="Excel" style="">
                        </div>
                        <div class="col-md-9">
                            <h6 class="p-l-10" id="finalize-file-name">File Name</h6>
                            <span class="f-12 p-l-10 text-black-50 m-t-2" id="finalize-file-size">File Size</span>
                        </div>
                        <div class="col-md-2 text-end align-content-center">
                            <i class="icon-trash f-24" id="removeFinalizedFile"></i>
                        </div>
                    </div>
                </div>
                <div>
                <div id="drop-zone">Drop files here or click to upload</div>
                <input type="file" id="file-input"  accept=".xlsx" style="display: none;"/>
                </div>
            </div>
            <div class="modal-footer" >
                <div class="text-end " id="">
                    @* button back and confirm Finalize *@
                    <button class="btn btn-outline-light" type="button" data-bs-dismiss="modal">Back</button>
                    <button class="btn btn-primary" id="finalizeConfirm" type="button">Finalize</button>
                </div>
            </div>
        </div>
    </div>
</div>
