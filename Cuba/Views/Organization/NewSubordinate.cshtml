                                        <h6 class="p-t-15" style="color: #9F9FA5;font:14px">No Sub Position</h6>
                                        <div class="p-t-15">
                                            <button type="button" class="btn btn-primary " id="addSubPosition">  
                                                <img src="~/assets/images/rasci/plus.svg" alt="Filter Icon" style="margin-top: -1px;margin-right: 2px;">Add Sub Position
                                            </button>
                                        </div>
                                    </div>
                                    <div class="p-t-10" id="dataSubPosition">
                                        <div class="table-responsive">
                                            <table class="tableMasterData table table-hover w-100" id="subPositionList">
                                            </table>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-12">
                                    <label class="form-label" for="directReport">Direct Report</label>
                                    <select class="form-select digits" class="select-class" id="selectDirectReport" name="directReport"  > 
                                    </select>
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label" for="neckFunction">Fungsi Leher</label>
                                    <select class="form-select digits" class="select-class" id="selectNeckFunction" name="neckFunction" id="neckFunction" > 
                                        @* YES NO *@
                                        <option value="No">No</option>
                                        <option value="Yes">Yes</option>
                                    </select>
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label" for="isProject">Project / Non Project</label>
                                    <select class="form-select digits" class="select-class" id="selectIsProject" name="isProject" id="isProject" > 
                                        @* project non project *@
                                        <option value="No">No</option>
                                        <option value="Yes">Yes</option>
                                    </select>
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label" for="coordination">Coordination</label>
                                    <select class="form-select digits" class="select-class" id="selectCoordination" name="coordination" id="coordination" > 
                                        <option value="No">No</option>
                                        <option value="Yes">Yes</option>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label" for="coordinationWith">Coordination With</label>
                                    <select class="form-select digits" class="select-class" id="selectCoordinationWith" name="coordinationWith" id="coordinationWith" > 
                                    </select>
                                </div>

                                <div class="col-md-4">
                                    <div class="media-body switch-sm d-flex align-items-center justify-content-between w-100">
                                        <label class="new-switch mb-0" for="Function">Function</label>
                                        <div class="d-flex align-items-center">
                                            <label class="switch m-0">
                                                <input type="checkbox" onchange="onChangeSwith(event,'Function')" ><span class="switch-state"></span>
                                            </label>
                                            <label class="col-form-label mb-0" style="margin-top: -4px; margin-left: 5px;">New</label>
                                        </div>
                                    </div>
                                    <select class="form-select digits" class="select-class" id="selectFunction" name="function" id="function" > 
                                    </select>
                                    <input class="form-control" style="display: none;" class="select-class" id="inputFunction" type="text" placeholder="Input Function" required="">
                                </div>

                                <div class="col-md-4">
                                    <div class="media-body switch-sm d-flex align-items-center justify-content-between w-100">
                                        <label class="new-switch mb-0" for="Division">Division</label>
                                        <div class="d-flex align-items-center">
                                            <label class="switch m-0">
                                                <input type="checkbox" onchange="onChangeSwith(event,'Division')" ><span class="switch-state"></span>
                                            </label>
                                            <label class="col-form-label mb-0" style="margin-top: -4px; margin-left: 5px;">New</label>
                                        </div>
                                    </div>
                                    <select class="form-select digits" class="select-class" id="selectDivision" name="division" > 
                                    </select>
                                    <input class="form-control" style="display: none;" class="select-class" id="inputDivision" type="text" placeholder="Input Division" required="">
                                </div>

                                <div class="col-md-4">
                                    <div class="media-body switch-sm d-flex align-items-center justify-content-between w-100">
                                        <label class="new-switch mb-0" for="SubDivision">Sub Division (Optional)</label>
                                        <div class="d-flex align-items-center">
                                            <label class="switch m-0">
                                                <input type="checkbox" onchange="onChangeSwith(event,'SubDivision')" ><span class="switch-state"></span>
                                            </label>
                                            <label class="col-form-label mb-0" style="margin-top: -4px; margin-left: 5px;">New</label>
                                        </div>
                                    </div>
                                    <select class="form-select digits" class="select-class" id="selectSubDivision" name="subDivision" id="subDivision" > 
                                    </select>
                                    <input class="form-control" style="display: none;" class="select-class" id="inputSubDivision" type="text" placeholder="Input Sub Division" required="">
                                </div>

                                <div class="col-md-4">
                                    <div class="media-body switch-sm d-flex align-items-center justify-content-between w-100">
                                        <label class="new-switch mb-0" for="Department">Department (Optional)</label>
                                        <div class="d-flex align-items-center">
                                            <label class="switch m-0">
                                                <input type="checkbox" onchange="onChangeSwith(event,'Department')" ><span class="switch-state"></span>
                                            </label>
                                            <label class="col-form-label mb-0" style="margin-top: -4px; margin-left: 5px;">New</label>
                                        </div>
                                    </div>
                                    <select class="form-select digits" class="select-class" id="selectDepartment" name="department" > 
                                    </select>
                                    <input class="form-control" style="display: none;" class="select-class" id="inputDepartment" type="text" placeholder="Input Department" required="">
                                </div>

                                <div class="col-md-4">
                                    <div class="media-body switch-sm d-flex align-items-center justify-content-between w-100">
                                        <label class="new-switch mb-0" for="Section">Section (Optional)</label>
                                        <div class="d-flex align-items-center">
                                            <label class="switch m-0">
                                                <input type="checkbox" onchange="onChangeSwith(event,'Section')" ><span class="switch-state"></span>
                                            </label>
                                            <label class="col-form-label mb-0" style="margin-top: -4px; margin-left: 5px;">New</label>
                                        </div>
                                    </div>
                                    <select class="form-select digits" class="select-class" id="selectSection" name="section" id="section" > 
                                    </select>
                                    <input class="form-control" style="display: none;" class="select-class" id="inputSection" type="text" placeholder="Input Section" required="">
                                </div>
                                
                                <div class="col-md-4">
                                    <div class="media-body switch-sm d-flex align-items-center justify-content-between w-100">
                                        <label class="new-switch mb-0" for="PersonalAreaName">Personal Area Name (Optional)</label>
                                        <div class="d-flex align-items-center">
                                            <label class="switch m-0">
                                                <input type="checkbox" onchange="onChangeSwith(event,'PersonalAreaName')" ><span class="switch-state"></span>
                                            </label>
                                            <label class="col-form-label mb-0" style="margin-top: -4px; margin-left: 5px;">New</label>
                                        </div>
                                    </div>
                                    <select class="form-select digits" class="select-class" id="selectPersonalAreaName" name="personalAreaName" id="personalAreaName" > 
                                    </select>
                                    <input class="form-control" style="display: none;" class="select-class" id="inputPersonalAreaName" type="text" placeholder="Input Personal Area Name" required="">
                                </div>

                                <div class="col-md-4">
                                    <div class="media-body switch-sm d-flex align-items-center justify-content-between w-100">
                                        <label class="new-switch mb-0" for="PersonalSubareaName">Personal Subarea Name (Optional)</label>
                                        <div class="d-flex align-items-center">
                                            <label class="switch m-0">
                                                <input type="checkbox" onchange="onChangeSwith(event,'PersonalSubareaName')" ><span class="switch-state"></span>
                                            </label>
                                            <label class="col-form-label mb-0" style="margin-top: -4px; margin-left: 5px;">New</label>
                                        </div>
                                    </div>
                                    <select class="form-select digits" class="select-class" id="selectPersonalSubareaName" name="personalSubareaName" id="personalSubareaName" > 
                                    </select>
                                    <input class="form-control" style="display: none;" class="select-class" id="inputPersonalSubareaName" type="text" placeholder="Input Personal Subarea Name" required="">
                                </div>

                            </div>
                        </div>
                    </div>

                    <div class="tab " id="inputSubordinate">
                        <div class="container">
                            <div class="os-container" id="noDataSubordinate" style="text-align: center;align-content: center;">
                                <img src="../assets/images/organization-structure/Vector.png" alt="organization-structure" style="height:100px">
                                <h6 class="p-t-10" style="color: #9F9FA5;font:14px" id="titleSubordinate">There is no subordinate</h6>
                                <div class="p-t-10" id="buttonSubordinateDiv">
                                    <button type="button" class="btn btn-primary m-r-15" id="duplicateSubordinate">  
                                        <img src="~/assets/images/rasci/plus.svg" alt="Filter Icon" style="margin-top: -1px;margin-right: 2px;">Duplicate Subordinate
                                    </button>
                                    <button type="button" class="btn btn-primary m-r-15" id="newSubordinate">  
                                        <img src="~/assets/images/rasci/plus.svg" alt="Filter Icon" style="margin-top: -1px;margin-right: 2px;">Add New Subordinate
                                    </button>
                                </div>
                            </div>
                            <div class="" id="dataSubordinate" >
                                <div class="table-responsive">
                                    <table class="tableMasterData table table-hover w-100" id="subordinateList">
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="tab" id="inputSgSsg">
                        <div class="container-fluid">
                            <div class="row g-3" style="height: 500px;border: 1px solid gray;padding: 10px;margin-top:5px;border-radius:5px;">
                                <div class="col-md-4 col-border" style="">
                                    <h6 style="font-weight: bolder;">Main SKill Group</h6>
                                    <hr style="margin: 20px 0px;">
                                    <div class="" style="margin: 10px 0px;"> 
                                        <label class="form-label">Skill Group</label>
                                        <select class="form-select digits" name="skillGroupMain" id="skillGroupMain">
                                        </select>
                                    </div>
                                    <div class="" style="margin: 20px 0px;"> 
                                        <label class="form-label">Sub Skill Group</label>
                                        <select class="form-select digits" name="subSkillGroupMain" id="subSkillGroupMain">
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-4 col-border" style="">
                                    <h6 style="font-weight: bolder;">Secod SKill Group</h6>
                                    <hr style="margin: 20px 0px;">
                                    <div class="" style="margin: 10px 0px;"> 
                                        <label class="form-label">Skill Group</label>
                                        <select class="form-select digits" name="skillGroupMain" id="skillGroupMain">
                                        </select>
                                    </div>
                                    <div class="" style="margin: 20px 0px;"> 
                                        <label class="form-label">Sub Skill Group</label>
                                        <select class="form-select digits" name="subSkillGroupMain" id="subSkillGroupMain">
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-4 col-border" style="">
                                    <h6 style="font-weight: bolder;">Third SKill Group</h6>
                                    <hr style="margin: 20px 0px;">
                                    <div class="" style="margin: 10px 0px;"> 
                                        <label class="form-label">Skill Group</label>
                                        <select class="form-select digits" name="skillGroupMain" id="skillGroupMain">
                                        </select>
                                    </div>
                                    <div class="" style="margin: 20px 0px;"> 
                                        <label class="form-label">Sub Skill Group</label>
                                        <select class="form-select digits" name="subSkillGroupMain" id="subSkillGroupMain">
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="tab" id="preview">
                        <div class="os-container" id="noDataSubordinate" style="text-align: center;align-content: center;">
                        </div>
                    </div>
                    <div class="col-md-12 mt-4 p-20">
                        <div class="text-end">
                            <button type="button" id="backToDetail" class="btn btn-outline-dark" style="margin-right: 5px;">Back</button>
                            <button type="button" id="saveSubordinate" class="btn btn-primary" >Save</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
    <!-- Container-fluid Ends-->
    <partial name="~/Views/Organization/ModalAddSubPosition.cshtml" />
</div>
@section Script {
    <!-- Plugins JS start-->
    <script src="../assets/js/sidebar-menu.js"></script>
    <script src="../assets/js/slick/slick.min.js"></script>
    <script src="../assets/js/slick/slick.js"></script>
    <script src="../assets/js/header-slick.js"></script>
    <script src="../assets/js/scrollable/perfect-scrollbar.min.js"></script>
    <script src="../assets/js/scrollable/scrollable-custom.js"></script>
    <script src="../assets/js/select2/select2.full.min.js"></script>
    <script src="../assets/js/select2/select2-custom.js"></script>
    <script src="../assets/js/sweet-alert/sweetalert.min.js"></script>


    @* datatable *@
    <script src="../assets/js/datatable/datatables/jquery.dataTables.min.js"></script>
    <script src="../assets/js/datatable/datatable-extension/dataTables.buttons.min.js"></script>

    @* custom js *@
    <script src="../assets/js/organization-structure/table-custom.js"></script>
    <script src="../assets/js/authentication.js"></script>
    <script src="../assets/js/organization-structure/multiple-select.js"></script>
    <script src="../assets/js/organization-structure/helper.js"></script>
    <script src="../assets/js/organization-structure/constant.js"></script>
    <script src="../assets/js/organization-structure/endpoint.js"></script>
    <script src="../assets/js/organization-structure/new-subordinate.js"></script>
    <script src="../assets/js/script.js"></script>
}

