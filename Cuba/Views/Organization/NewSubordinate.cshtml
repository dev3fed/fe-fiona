                        </div>
                    </div> *@
                    

                    <div class="tab active" id="inputAttribute">
                        <div class="container vertical-scroll scroll-content">
                            <div class="row g-3">

                                @* <div class="col-md-6">
                                    <label class="form-label" for="inputDraftName">Draft Name</label>
                                    <input class="form-control" id="inputDraftName" type="text" placeholder="Input Draft Name" required="">
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label" for="selectDraftType">Draft Type</label>
                                    <select class="form-select digits" name="selectDraftType" id="selectDraftType">
                                        <option value=0>Create New Draft</option>
                                    </select>
                                </div> *@

                                @*  for duplicate *@
                                @* <div class="col-md-10">
                                    <label class="form-label">Job Reference</label>
                                    <select class="form-select digits" name="selectJobReference" id="selectJobReference">
                                    </select>
                                </div>
                                <div class="col-md-2" style="text-align: center;align-content: end;">
                                    <button type="button" class="btn btn-primary" >  
                                        Duplicate
                                    </button>
                                </div> *@

                                <div class="col-md-4">
                                    <label class="form-label" for="selectCareerType">Career Type</label>
                                    <select class="form-select digits" name="selectCareerType" id="selectCareerType" >
                                    </select>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">Career Level</label>
                                    <select class="form-select digits" name="selectCareerLevel" id="selectCareerLevel">
                                    </select>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label" for="selectBasket">Basket</label>
                                    <select class="form-select digits" name="selectBasket" id="selectBasket"> 
                                        <option value="No">No</option>
                                        <option value="Yes">Yes</option>
                                    </select>
                                </div>
                                
                                <div class="col-md-6" id="abbrvPositionDiv">
                                    <div class="media-body switch-sm d-flex align-items-center justify-content-between w-100">
                                        <label class="new-switch mb-0" for="inputClassAbbrvPosition">Abbrv Position</label>
                                        <div class="d-flex align-items-center">
                                            <label class="switch m-0">
                                                <input type="checkbox" onchange="onChangeSwith(event,'AbbrvPosition')" ><span class="switch-state"></span>
                                            </label>
                                            <label class="col-form-label mb-0" style="margin-top: -4px; margin-left: 5px;">New</label>
                                        </div>
                                    </div>
                                    <select class="form-select digits" class="select-class" class="selectAbbrvPosition" id="selectAbbrvPosition"  name="abbrvPosition" > 
                                    </select>
                                    <input class="form-control" style="display: none;" class="select-class" id="inputAbbrvPosition" type="text" placeholder="Input Abbrv Position" required="">
                                </div>

                                <div class="col-md-6">
                                    <div class="media-body switch-sm d-flex align-items-center justify-content-between w-100">
                                        <label class="new-switch mb-0" for="inputClassOrgUnitName">Org Unit Name</label>
                                        <div class="d-flex align-items-center">
                                            <label class="switch m-0">
                                                <input type="checkbox" onchange="onChangeSwith(event,'OrgUnitName')" ><span class="switch-state"></span>
                                            </label>
                                            <label class="col-form-label mb-0" style="margin-top: -4px; margin-left: 5px;">New</label>
                                        </div>
                                    </div>
                                    <select class="form-select digits" class="select-class" id="selectOrgUnitName" name="orgUnitName"  > 
                                    </select>
                                    <input class="form-control" style="display: none;" class="select-class" id="inputOrgUnitName" type="text" placeholder="Input Abbrv Position" required="">
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label" for="inputPositionName">Position Name</label>
                                    <input class="form-control" id="inputPositionName" type="text" placeholder="Insert Position Name" required="" >
                                </div>

                                <div class="col-md-5" id="">
                                    <div class="row">
                                        <div class="col-md-3">
                                            <label class="form-label" for="prlOrg">PRL Org</label>
                                            <select class="form-select digits" class="select-class" id="selectPrlOrg" name="prlOrg"  > 
                                            </select>
                                        </div>  
                                        <div class="col-md-2 text-center" style="align-self: end;">
                                            <h2>-</h2>
                                        </div>  
                                        <div class="col-md-3" style="align-self: end;">
                                            <select class="form-select digits" class="select-class" id="selectPrlOrgTo" name="prlOrgTo"  > 
                                            </select>
                                        </div>    
                                        <div class="col-md-4" id="formationDiv">
                                            <label class="form-label" for="inputFormation">Formation</label>
                                            <input class="form-control" id="inputFormation" type="text" placeholder="Insert Formation" required="" >
                                        </div>    
                                    </div>
                                </div>
                                <div class="col-md-12" id="subPositionDiv">
                                    <div class="os-container" id="noDataSubPosition" style="text-align: center;align-content: center;">
