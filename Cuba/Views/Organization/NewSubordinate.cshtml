                        </li>
                        <li class="breadcrumb-item ">Organization Structure</li>
                        <li class="breadcrumb-item active">Add New Subordinate</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <!-- Container-fluid starts-->
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-12">
                <div class="card" style="border-radius:8px">
