@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Chart-Widget";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .osContainerNew {
        width: 100%;
        height: 600px;
    }
    

    #orgThree .no-children .jstree-icon {
        display: none !important;
        /* Use !important to ensure it overrides other styles */
    }
</style>

<style id="myStyle">
    [data-l-id] path {
        stroke: #000000;
        stroke-width: 0.6px;
    }

    [data-n-id] circle {
        stroke: #000000;
        stroke-width: 0.6px;
    }

    [data-n-id] rect {
        stroke: #000000;
        stroke-width: 0.6px;
    }

    [data-ctrl-ec-id] circle,
    [data-ctrl-ec-id] line {
        stroke: #000000;
        stroke-width: 0.6px;
    }

    [data-l-id].direktur>path {
        stroke-dasharray: 3, 3;
    }

    @* class edit *@
    [data-n-id].edit rect {
        fill: #e6f6fe;
        stroke: #03a9f4;
    }
    [data-n-id].create rect {
        fill: #e6f6fe;
        stroke: #03a9f4;
    }
    [data-n-id].update rect {
        fill: #e6f6fe;
        stroke: #03a9f4;
    }

    [data-n-id].delete rect {
        fill: #f8d7da;
        stroke: #dc3545;
    }

    [data-n-id].pointed rect {
        stroke: #03A9F4;
        stroke-width: 3;
    }

    .match rect:nth-child(2) {
        fill: #F57C00;
        stroke: #F57C00;
    }

    .match path,
    .match circle {
        stroke: #F57C00;
    }

    [data-n-id].bracket_4_edit rect {
        fill: #FFD700;
    }
</style>
@* <script src="~/assets/js/balkan/orgchart.js"></script> *@
<script src="~/assets/js/organization-structure/data_detail_position.js"></script>
<script src="~/assets/js/organization-structure/data_cnt.js"></script>


<link rel="stylesheet" type="text/css" href="~/assets/css/organization-structure.css">
@* style link *@
<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/buttons/3.1.2/css/buttons.dataTables.css">
<div class="page-body">
    <div id="loader">
        <div class="spinner"></div>
    </div>
    <div class="container-fluid content">
        <div class="page-title">
            <div class="row">
                <div class="col-6">
                    <h3>Organization Structure</h3>
                </div>
                <div class="col-6">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-controller="HomePage" asp-action="Index">
                                <svg class="stroke-icon">
                                    <use href="~/assets/svg/icon-sprite.svg#stroke-home"></use>
                                </svg>
                            </a>
                        </li>
                        <li class="breadcrumb-item active">Organization Structure</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <!-- Container-fluid starts-->
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-12">
                <div class="card" style="border-radius:8px">
                    <div style="padding:10px">
                        <ul class="nav nav-tabs nav-primary" id="pillsSoSection">
                            <li class="nav-item"><a class="nav-link active" id="pillsChart" data-bs-toggle="pill"
                                    href="#chart" role="tab" aria-controls="pills-matrix" aria-selected="true">Chart</a>
                            </li>
                            <li class="nav-item"><a class="nav-link" id="pillsDraft" data-bs-toggle="pill"
                                    href="#draft" role="tab" aria-controls="pills-draft" aria-selected="false">Draft
                                </a></li>
                            <li class="nav-item"><a class="nav-link" id="pillsRequest" data-bs-toggle="pill"
                                    href="#request" role="tab" aria-controls="pills-request"
                                    aria-selected="false">Approval List
                                </a></li>
                            <li class="nav-item"><a class="nav-link" id="pillsLog" data-bs-toggle="pill" href="#log"
                                    role="tab" aria-controls="pills-log" aria-selected="false">Log History
                                </a></li>
                        </ul>
                        <div class="tab-content" id="pillsRasciTabContent">
                            <div class="tab-pane fade show active" id="chart" role="tabpanel"
                                aria-labelledby="pillsChart">
                                <div class="card-body" style="padding:15px 5px 15px 5px !important">
                                    <div class="row">
                                        <div class="col-3">
                                            <label for="">Organization Data Source</label>
                                            <select class="form-select digits" name="selectDraftOrganization"
                                                id="selectDraftOrganization">
                                                <option></option>
                                            </select>
                                        </div>
                                        <div class="col-3 align-content-center">
                                            <label for="">Search Position</label>
                                            <select class="form-select digits" name="searchOrgNode" id="searchOrgNode">
                                            </select>
                                        </div>
                                        <div class="col-6"
                                            style="margin-bottom: 4px;align-self: end; justify-content: end;text-align:end">
                                            <button class="btn btn-primary me-2 btn-icon" type="button"
                                                id="createDraft">
                                                <img src="/assets/images/rasci/plus.svg" alt="Filter Icon"
                                                    style="margin-top: -1px;margin-right: 2px;"> Create Draft
                                            </button>
                                            <button class="btn btn-primary me-2 btn-icon" type="button"
                                                id="viewOrgTree">
                                                <img src="~/assets/images/rasci/org-tree.svg" alt="Filter Icon"
                                                    class="pr-2" style="margin-top: -1px;">
                                                View Org Tree
                                            </button>
                                            <button class="btn btn-primary me-2 btn-icon" type="button"
                                                id="designCost">
                                                <img src="~/assets/images/rasci/design-cost.svg" alt="Filter Icon"
                                                    class="pr-2" style="margin-top: -1px;">
                                                Design Cost
                                            </button>
                                            <button class="btn btn-primary me-2 btn-icon" type="button"
                                                id="createJob">
                                                <img src="~/assets/images/rasci/plus.svg" alt="Filter Icon" class="pr-2"
                                                    style="margin-top: -1px;">
                                                Add Position
                                            </button>
                                        </div>
                                        <div class="col-5 m-t-10 p-l-15">
                                            <div class="d-flex gap-3" id="labelChart" >
                                                <div class="d-flex gap-2 align-items-center align-self-center"> 
                                                    <div class="square bg-primary-outline-custom"></div>
                                                    <span>New / Edited Position</span>
                                                </div>
                                                <div class="d-flex gap-2 align-items-center align-self-center""> 
                                                    <div class="square bg-danger-outline-custom"></div>
                                                    <span>Deleted Position</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12 mt-2">
                                            <div class="osContainerNew" style="">
                                            </div>
                                            @* <div id="osContainer" class="chart-container" style=""></div> *@
                                            <button onclick="chart.exportImg()">Export Current</button>
                                            <button onclick="chart.exportImg({full:true})">Export Full</button>
                                            <button onclick="prepareAndExportSVG()">Export SVG (Clean)</button>
                                            <button onclick="downloadPdf(chart)">Export PDF</button>
                                            <button onclick="chart.fit()">Fit to the screen</button>
                                            <button onclick="updateDataChart()">Update Data</button>
                                            @* zoom in zoom out *@
                                            <button
                                                onclick="chart.zoomIn().render().fit()"
                                                class="btn btn-action-button waves-effect waves-light">
                                                <i class="fas fa-search-plus"></i> zoom in
                                            </button>
                                            <button
                                                onclick="chart.zoomOut().render().fit()"
                                                class="btn btn-action-button waves-effect waves-light">
                                                <i class="fas fa-search-minus"></i> zoom out
                                            </button>
                                            <button
                                            onclick="chart.compact(!!(compact++%2)).render().fit()"
                                            class="btn btn-action-button waves-effect waves-light"
                                            >
                                            <i class="fas fa-sitemap"></i> compact
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="draft" role="tabpanel" aria-labelledby="pillsDraft">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-12">
                                            <div class="table-responsive">
                                                <table class="tableMasterData table table-hover w-100" id="draftList">
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="request" role="tabpanel" aria-labelledby="pillsRequest">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-2">
                                            <div class="input-group date" id="dtMinimum" data-target-input="nearest">
                                                <div class="input-group-text" data-target="#dtMinimum"
                                                    data-toggle="datetimepicker"><i data-feather="calendar"
                                                        style="width: 20px;"></i></div>
                                                <input class="form-control" type="text" name="datePicker"
                                                    id="createDate" placeholder="Submitted Date">
                                            </div>
                                        </div>
                                        <div class="col-2">
                                            <div class="input-group date" id="dtMinimum2" data-target-input="nearest">
                                                <div class="input-group-text" data-target="#dtMinimum2"
                                                    data-toggle="datetimepicker"><i data-feather="calendar"
                                                        style="width: 20px;"></i></div>
                                                <input class="form-control" type="text" name="datePicker"
                                                    placeholder="Approved/Reject Date">
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="faq-form">
                                                <input class="form-control" type="text" placeholder="Search.."><i
                                                    class="search-icon" data-feather="search"></i>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row m-t-10">
                                        <div class="col-12">
                                            <div class="table-responsive">
                                                <table class="tableMasterData table table-hover w-100"
                                                    id="approvalList">
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="log" role="tabpanel" aria-labelledby="pillsLog">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-3">
                                            <div class="input-group date" id="dtMinimum3" data-target-input="nearest">
                                                <div class="input-group-text" data-target="#dtMinimum3"
                                                    data-toggle="datetimepicker"><i data-feather="calendar"
                                                        style="width: 20px;"></i></div>
                                                <input class="form-control" type="text" name="datePicker"
                                                    placeholder="Date">
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="faq-form">
                                                <input class="form-control" type="text" placeholder="Search.."><i
                                                    class="search-icon" data-feather="search"></i>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row m-t-10">
                                        <div class="col-12">
                                            <div class="table-responsive">
                                                <table class="tableMasterData table table-hover w-100" id="logList">
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <partial name="~/Views/Organization/ModalOrgTree.cshtml" />
    <partial name="~/Views/Organization/ModalConfirm.cshtml" />
    <partial name="~/Views/Organization/ModalPreviewDesignCost.cshtml" />
    <partial name="~/Views/Organization/ModalCreateDraftSO.cshtml" />
    <partial name="~/Views/Organization/ModalDetailJob.cshtml" />
</div>
