@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Chart-Widget";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .chart-container-custom{
        width: 100%;
        height: 700px;
        }

    .svg-chart-container {
        width: 100%;
        height: 700px;
    }

    .chart-exp-mid{
        width: 1100px;
        height: 600px;
        position: relative
    }
    
    
    #orgThree .no-children .jstree-icon {
        display: none !important;
        /* Use !important to ensure it overrides other styles */
    }
</style>

<style id="myStyle">
    [data-l-id] path {
        stroke: #000000;
        stroke-width: 0.6px;
    }

    [data-n-id] circle {
        stroke: #000000;
        stroke-width: 0.6px;
    }

    [data-n-id] rect {
        stroke: #000000;
        stroke-width: 0.6px;
    }

    [data-ctrl-ec-id] circle,
    [data-ctrl-ec-id] line {
        stroke: #000000;
        stroke-width: 0.6px;
    }

    [data-l-id].direktur>path {
        stroke-dasharray: 3, 3;
    }

    @* class edit *@
    [data-n-id].edit rect {
        fill: #e6f6fe;
        stroke: #03a9f4;
    }
    [data-n-id].create rect {
        fill: #e6f6fe;
        stroke: #03a9f4;
    }
    [data-n-id].update rect {
        fill: #e6f6fe;
        stroke: #03a9f4;
    }

    [data-n-id].delete rect {
        fill: #f8d7da;
        stroke: #dc3545;
    }

    [data-n-id].pointed rect {
        stroke: #03A9F4;
        stroke-width: 3;
    }

    .match rect:nth-child(2) {
        fill: #F57C00;
        stroke: #F57C00;
    }

    .match path,
    .match circle {
        stroke: #F57C00;
    }

    [data-n-id].bracket_4_edit rect {
        fill: #FFD700;
    }
</style>
<script src="../assets/js/balkan/orgchart.js"></script>
<script src="../assets/js/organization-structure/data_detail_position.js"></script>
<script src="../assets/js/organization-structure/data_cnt.js"></script>
<link rel="stylesheet" type="text/css" href="~/assets/css/organization-structure.css">
@* style link *@
<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/buttons/3.1.2/css/buttons.dataTables.css">
<div class="page-body">
    <div class="container-fluid">
        <div class="page-title">
            <div class="row">
                <div class="col-6">
                    <h3 id="detailTitle">Draft Detail</h3>
                </div>
                <div class="col-6">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-controller="HomePage" asp-action="Index">
                                <svg class="stroke-icon">
                                    <use href="../assets/svg/icon-sprite.svg#stroke-home"></use>
                                </svg>
                            </a>
                        </li>
                        <li class="breadcrumb-item ">Organization Structure</li>
                        <li class="breadcrumb-item"></li>
                        <li class="breadcrumb active" id="draftDetailBreadcrumb">Draft Detail</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <!-- Container-fluid starts-->
    <div class="container-fluid">
        <div class="card" style="border-radius:8px">
            <div style="padding:15px">
                <!-- Card detail start-->
                <div class="custom-card-draft">
                    <div class="header-card-draft">
                        Info
                    </div>
                    <div class="row" style="margin-top: 20px;" id="infoDraft">
                        <div class="col-4 text-center d-flex flex-column" style="padding: 10px;border-right: 1px solid #bfbfc2;">
                                <span id="" class="text-black-50" style="font-size: 14px;">Draft Name</span>
                            <div>
                                <span id="draftName" class="f-w-600" style="font-size: 18px;"></span>
                                <img src="~/assets/images/rasci/pen_outline.svg" alt="Filter Icon" class="p-l-5" style="margin-top: -1px;" id="editDraftName">
                            </div>
                            <span id="requestId" class="f-w-200" style="font-size: 14px;"></span>
                        </div>
                        <div class="col-4 text-center d-flex flex-column" style="padding: 10px;border-right: 1px solid #bfbfc2;">
                            <span id="" class="text-black-50" style="font-size: 14px;">Created by</span>
                            <span id="createdDate" class="f-w-200" style="font-size: 14px;"></span>
                            <span id="createdBy" class="f-w-600" style="font-size: 16px;"></span>
                        </div>
                        <div class="col-4 text-center d-flex flex-column" style="padding: 10px;border-right: 1px solid #bfbfc2;">
                            <span id="" class="text-black-50" style="font-size: 14px;">Updated by</span>
                            <span id="updatedDate" class="f-w-200" style="font-size: 14px;"></span>
                            <span id="updatedBy" class="f-w-600" style="font-size: 16px;"></span>
                        </div>
                    </div>
                    <div class="row" style="margin-top: 20px;" id="infoApproval">
                        <div class="col-3 text-center d-flex flex-column" style="padding: 10px;border-right: 1px solid #bfbfc2;">
                                <span id="" class="text-black-50" style="font-size: 14px;">Draft Name</span>
                            <div>
                                <span id="draftNameApproval" class="f-w-600" style="font-size: 18px;"></span>
                                <img src="~/assets/images/rasci/pen_outline.svg" alt="Filter Icon" class="p-l-5" style="margin-top: -1px;" id="editDraftName">
                            </div>
                            <span id="requestIdApproval" class="f-w-200" style="font-size: 14px;"></span>
                        </div>
                        <div class="col-3 text-center d-flex flex-column" style="padding: 10px;border-right: 1px solid #bfbfc2;">
                            <span id="" class="text-black-50" style="font-size: 14px;">Submitted Date</span>
                            <span id="submittedDate" class="f-w-200" style="font-size: 14px;"></span>
                            <span id="submittedBy" class="f-w-600" style="font-size: 16px;"></span>
                        </div>
                        <div class="col-3 text-center d-flex flex-column" style="padding: 10px;border-right: 1px solid #bfbfc2;">
                            <span id="" class="text-black-50" style="font-size: 14px;">Approved/Reject Date</span>
                            <span id="approvedRejectDate" class="f-w-200" style="font-size: 14px;"></span>
                            <span id="approvedRejectBy" class="f-w-600" style="font-size: 16px;"></span>
                        </div>
                        <div class="col-3 text-center d-flex flex-column" style="padding: 10px;border-right: 1px solid #bfbfc2;">
                            <span id="" class="text-black-50" style="font-size: 14px;">Status</span>
                            <span id="statusApproval" class="f-w-600" style="font-size: 16px;"></span>
                        </div>
                    </div>
                </div>
                <div class="custom-card-draft">
                    <div class="header-card-draft">
                        Detail
                    </div>
                    <div class="row mt-4">
                        <div class="col-md-6" id="activityType d-flex flex-column" style="padding: 10px;">
                            <label class="f-12" for="">Activity Type : </label>
                            <button id="all" class="tab-custom active">All</button>
                            <button id="Create" class="tab-custom">Created New Job</button>
                            <button id="Update" class="tab-custom">Edit Job</button>
                            <button id="Delete" class="tab-custom">Delete Job</button>
                        </div>
                        <div class="col-md-5 offset-1 d-flex gap-2" id="divButton" style="justify-content: end;padding: 10px;">
                            <div class="" id="importButton">
                                <input type="file" id="fileImportDraft" style="display: none;" />
                                <button class="btn btn-primary" type="button" id="exportTemplate">
                                    Expoort Template
                                    <img src="~/assets/images/rasci/download.svg" alt="Download Icon" class="p-l-5" style="margin-top: -1px;">
                                </button>
                            </div>
                            <div class="" id="importButton">
                                <input type="file" id="fileImportDraft" style="display: none;" />
                                <button class="btn btn-primary" type="button" id="exportDataDraft">
                                    Export Data
                                    <img src="~/assets/images/rasci/download.svg" alt="Download Icon" class="p-l-5" style="margin-top: -1px;">
                                </button>
                            </div>
                            <div class="" id="importButton">
                                <input type="file" id="fileImportDraft" style="display: none;" />
                                <button class="btn btn-primary" type="button" id="importDataDraft">
                                    Import Draft
                                    <img src="~/assets/images/rasci/upload.svg" alt="Upload Icon" class="p-l-5" style="margin-top: -1px;">
                                </button>
                            </div>
                        </div>  
                        <div class="col-md-2 offset-4 align-self-center" id="import">
                        </div>
                    </div>
                    <div class="row mt-4 p-t-0 m-t-1">
                        <div class="col-12">
                            <div class="table-responsive">
                                <table class="tableMasterData table table-hover w-100" id="draftListDetail">
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- card footer start-->
                <div class="text-end mt-4 mb-2">
                    <button class="btn btn-outline-light" type="button" onclick="backToOrg()">
                        Back
                    </button>
                    <button class="btn btn-outline-danger" id="deleteDraft" type="button" onclick="deleteDraft()">
                        <i class="icon-trash" style="font-size: 1em;"></i> Delete Draft
                    </button>
                    <button class="btn btn-outline-light" type="button" id="previewDesignCost" onclick="previewDesignCost()">
                        Design Cost
                    </button>
                    <button class=" btn btn-outline-light" type="button" id="previewOrgChart" onclick="previewOrgChart()">
                        Preview Organization Chart
                    </button>
                    <button class="btn btn-primary" type="button" id="submitApproval" onclick="submitToApproval()"> Submit To Approval
                    </button>
                    @* <button class="btn btn-primary" type="button" id="exportFile" onclick="exportFileApproval()"> Export Data
                    </button> *@
                    <button class="btn btn-success" type="button" id="finalize" onclick="finalizeApproval()"> Finalize
                    </button>
                    <button class="btn btn-danger" type="button" id="rejectApproval" onclick="rejectApproval()"> Reject
                    </button>
                    <button class="btn btn-success" type="button" id="acceptApproval" onclick="acceptApproval()"> Approve
                    </button>
                </div>
                <!-- card footer end-->
            </div>
        </div>

    </div>
    <!-- Container-fluid Ends-->
    <partial name="~/Views/Organization/ModalAddSubPosition.cshtml" />
    @* <partial name="~/Views/Organization/modalDetailJob.cshtml" /> *@
    <partial name="~/Views/Organization/ModalDetailJobDraft.cshtml" />
    <partial name="~/Views/Organization/ModalPreviewOrgChart.cshtml" />
    <partial name="~/Views/Organization/ModalPreviewDesignCost.cshtml" />
    <partial name="~/Views/Organization/ModalCreateDraftSO.cshtml" />
    <partial name="~/Views/Organization/ModalConfirm.cshtml" />
    <partial name="~/Views/Organization/ModalUploadFinalized.cshtml" />
    <partial name="~/Views/Organization/ModalDetailJob.cshtml" />

</div>
