<style>
    .os-container {
        height: 480px;
        background-color: #F5F5F5;
    }
</style>
<style id="myStyle">
    [data-l-id] path {
        stroke: #000000;
        stroke-width: 0.6px;
    }
    [data-n-id] circle {
        stroke: #000000;
        stroke-width: 0.6px;
    }
    [data-n-id] rect {
        stroke: #000000;
        stroke-width: 0.6px;
    }
    [data-ctrl-ec-id] circle,
    [data-ctrl-ec-id] line {
        stroke: #000000;
        stroke-width: 0.6px;
    }
    [data-l-id].direktur > path {
        stroke-dasharray: 3, 3;
    }

    @* class edit *@
    [data-n-id].edit rect {
        fill: #FFD700;
    }
    .match rect:nth-child(2){
        fill: #F57C00;
        stroke: #F57C00;
    }

    .match path, .match circle{
        stroke: #F57C00;
    }

    [data-n-id].bracket_4_edit rect {
        fill: #FFD700;
    }
</style>
