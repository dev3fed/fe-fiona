<link rel="stylesheet" type="text/css" href="~/assets/css/organization-structure.css">
<div class="modal fade" id="modalPreviewDesignCost" tabindex="-1" role="dialog" aria-labelledby="modalPreviewDesignCost" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="">Preview Design Cost</h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-3">
                        @* label *@
                        <label class="form-label digits" for="selectDraftFilterByDataSource">Filter By</label>
                        <select class="form-select digits" name="selectDraftFilterByDataSource" id="selectDraftFilterByDataSource" placeholder="Filter By">
                            <option value="function">Function</option>
                            <option value="division">Division</option>
                            <option value="level">Level</option>
                        </select>
                    </div>
                    <div class="col-md-12">
                        <div class="table-responsive m-t-25">
                            <table class="tableMasterData table table-hover w-100" id="tableDesignCost">
                                <thead>
                                    <tr>
                                        <th rowspan="2" class="text-center">No</th>
                                        <th rowspan="2" class="text-center" id="titleFilter">Function</th>
                                        <th colspan="2" class="text-center">Proposed</th>
                                        <th colspan="2" class="text-center">Existing</th>
                                        <th colspan="2" class="text-center">Total Adjustment</th>
                                    </tr>
                                    <tr>
                                        <th class="text-center">Formation</th>
                                        <th class="text-center">Design Cost (IDR)</th>
                                        <th class="text-center">Formation</th>
                                        <th class="text-center">Design Cost (IDR)</th>
                                        <th class="text-center">Formation</th>
                                        <th class="text-center">Design Cost (IDR)</th>
                                    </tr>
                                </thead>
                                <tbody id="tableDesignCostBody">
                                <tfoot id="tableDesignCostFooter">
                                    <tr>
                                        <td class="text-center"></td>
                                        <td class="text-center">Total</td>
                                        <td class="text-center">-</td>
                                        <td class="text-center">-</td>
                                        <td class="text-center">-</td>
                                        <td class="text-center">-</td>
                                        <td class="text-center">-</td>
                                        <td class="text-center">-</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer" >
                <div class="text-end " id="">
                    <button class="btn btn-outline-light" type="button" data-bs-dismiss="modal">
                        Back
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
