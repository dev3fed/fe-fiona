<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.14.305/pdf.min.js"></script>

<style>
    /* MODAL CONFIG */
    .modal-dialog.modal-previewsk {
        max-width: 60%;
        width: 100%;
        margin: 2rem auto;
        display: flex;
        flex-direction: column;
        height: calc(100vh - 60px);
    }

    .modal-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border-radius: 8px;
    }

    .modal-previewSk {
        flex: 1;
        overflow: hidden;
        padding: 0;
    }

    .pdf-scroll-container {
        height: 100%;
        overflow-y: auto;
        padding: 1rem;
    }

    .pdf-scroll-container canvas {
        width: 100%;
        height: auto;
        display: block;
        margin-bottom: 16px;
    }

    /* Scrollbar styling (optional) */
    .pdf-scroll-container::-webkit-scrollbar {
        width: 6px;
    }

    .pdf-scroll-container::-webkit-scrollbar-thumb {
        background-color: rgba(0, 0, 0, 0.2);
        border-radius: 3px;
    }

    /* Prevent body scroll when modal open */
    body.modal-open {
        overflow: hidden !important;
        padding-right: 0 !important;
    }
</style>
<div class="modal fade" id="ModalPreviewSk" tabindex="-1" aria-hidden="true" data-bs-backdrop="static"
    data-bs-keyboard="false">
    <div class="modal-dialog modal-previewsk bounceInDown animated" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Preview SK</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-previewSk">
                <div class="pdf-scroll-container">
                    <div class="row" id="pdf-container">
                        <!-- PDF canvas akan dirender di sini -->
                    </div>
                </div>
            </div>

            <div class="modal-footer d-flex justify-content-end">
                <button class="btn btn-outline-light" type="button" data-bs-dismiss="modal">
                    <i class="icon-arrow-left"></i> Back
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap JS and Popper.js -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/js/bootstrap.min.js"></script>
