<!-- Include Animate.css -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
<style>
    .modal-dialog.modal-formsk {
        max-width: 50%;
        margin: 120px auto;
    }
</style>
<div class="modal fade" id="ModalFormsk" tabindex="-1" role="dialog" aria-labelledby="ModalFormskLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-formsk bounceInDown  animated" role="document">
        <div class="modal-content" style="border-radius: 8px;">
            <div class="modal-header">
                <h5 class="modal-title" id="ModalFormskTitle">Confirm Upload SK</h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="body-formsk">
                <div class="row">
                    <div class="col-12">
                        <label class="form-label">SK Number</label>
                        <input class="form-control" type="text">
                    </div>
                    <div class="col-12 mt-3">
                        <label class="form-label">SK Title</label>
                        <textarea class="form-control" rows="3"></textarea>
                    </div>
                    <div class="col-12 mt-3">
                        <label class="form-label">Note (Optional)</label>
                        <textarea class="form-control" rows="3"></textarea>
                    </div>
                    <div class="col-12 mt-3">
                        <label class="form-label">Upload SK File (only PDF maximum 20 mb)</label>
                        <input class="form-control" type="file">
                    </div>
                </div>
            </div>
            <div class="modal-footer  d-flex justify-content-end">
                <div>
                    <button class="btn btn-outline-light" type="button" data-bs-dismiss="modal"><i
                            class="icon-arrow-left"></i> Back</button>
                    <button id="applyFilterBtn" class="btn btn-primary" type="button">
                        <div class="d-flex align-items-center">
                            <div class="spinner-border spinner-border-sm text-light me-2" style="display: none;"
                                id="loadingCreateuser" role="status"></div>
                            <span class="btn-text">Upload</span>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Bootstrap JS and Popper.js -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/js/bootstrap.min.js"></script>
