<style>
    .tbl-border-sklist {
        width: 100%;
        border-top: 1px solid #b0d1e4;
        border-right: 1px solid #b0d1e4;
        border-bottom: 1px solid #b0d1e4;
        border-left: 1px solid #b0d1e4;
        border-collapse: collapse;
        font-size: 12px !important;
    }

    .tbl-border-sklist th {
        color: #006CA9;
        font-weight: bold;
        height: 40px;
    }

    .tbl-border-sklist thead th {
        position: sticky;
        top: 0;
        background-color: #E6F0F6;
        z-index: 1;
        /* To ensure it stays above the content */
    }

    .tbl-border-sklist th,
    .tbl-border-sklist td {
        padding: 8px !important;
        border-right: 1px solid #b0d1e4;
        border-bottom: 1px solid #b0d1e4;
        border-left: 1px solid #b0d1e4;
    }

    th,
    td {
        vertical-align: middle;
        padding: 0;
    }
</style>
<div class="row">
    <div class="col-4">
        <div class="faq-form">
            <div class="input-group date" id="dt-minimum" data-target-input="nearest">
                <div class="input-group-text" data-target="#dt-minimum" data-toggle="datetimepicker"><i
                        data-feather="calendar" style="width: 20px;"></i></div>
                <input class="datepicker-here form-control digits" type="text" data-language="en"
                    data-multiple-dates-separator=", " data-position="bottom left" placeholder="Date Range">
            </div>
        </div>
    </div>
    <div class="col-5">
        <div class="faq-form">
            <input class="form-control" type="text" placeholder="Search.."><i class="search-icon"
                data-feather="search"></i>
        </div>
    </div>
    <div class="col-3 d-flex justify-content-end">
        <button class="btn btn-primary  btn-icon" type="button" onclick="openModalUploadsk()">
            <img src="~/assets/images/rasci/plus.svg" alt="Filter Icon" style="margin-top: -1px;">
            Upload SK
        </button>
    </div>
    <div class="col-12 mt-3">
        <div class="table-responsive" style=" max-height: 450px;">
            <table class="table tbl-border-sklist">
                <thead id="tbl-sklist-header" style="background-color: #006CA9;">
                    <tr>
                        <th scope="col" style="width: 50px;text-align:center">
                            No
                        </th>
                        <th scope="col" style="width: 180px;">Upload Date</th>
                        <th scope="col" style="width: 150px;">Upload By</th>
                        <th scope="col" style="width: 180px;">SK Number</th>
                        <th scope="col" style="width: 280px;">SK Title</th>
                        <th scope="col" style="width: 150px;">Note</th>
                        <th scope="col" style="width: 80px;">Action</th>
                    </tr>
                </thead>
                <tbody id="body-sklist">
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-10 mt-3">
        <div id="total-sklist-page">
        </div>
    </div>
    <div class="col-2 mt-3">
        <div id="list-sklist-page">
        </div>
    </div>
</div>