@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description"
        content="Cuba admin is super flexible, powerful, clean &amp; modern responsive bootstrap 5 admin template with unlimited possibilities.">
    <meta name="keywords"
        content="admin template, Cuba admin template, dashboard template, flat admin template, responsive admin template, web app">
    <meta name="author" content="pixelstrap">
    <link rel="icon" href="~/assets/images/favicon.svg" type="image/x-icon">
    <link rel="shortcut icon" href="~/assets/images/favicon.svg" type="image/x-icon">
    <title>RASCI APP</title>
    <!-- Google font-->
    <link href="https://fonts.googleapis.com/css?family=Rubik:400,400i,500,500i,700,700i&amp;display=swap"
        rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,300i,400,400i,500,500i,700,700i,900&amp;display=swap"
        rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&amp;display=swap" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="~/assets/css/font-awesome.css">
    <link rel="icon" href="~/assets/svg/landing-icons.svg">
    <link rel="stylesheet" type="text/css" href="~/assets/css/vendors/slick.css">
    <link rel="stylesheet" type="text/css" href="~/assets/css/vendors/slick-theme.css">
    <link rel="stylesheet" type="text/css" href="~/assets/css/vendors/animate.css">
    <!-- Bootstrap css-->
    <link rel="stylesheet" type="text/css" href="~/assets/css/vendors/bootstrap.css">
    <!-- App css-->
    <link rel="stylesheet" type="text/css" href="~/assets/css/style.css">
    <!-- Responsive css-->
    <link rel="stylesheet" type="text/css" href="~/assets/css/responsive.css">

    <!-- themify icon css -->
    <link rel="stylesheet" type="text/css" href="~/assets/css/vendors/themify.css">

    <link href="https://cdnjs.cloudflare.com/ajax/libs/feather-icons/4.28.0/feather.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    </link>
    <style>
        .card {
            width: 26vh;
            text-align: center;
            cursor: pointer;
        }

        .card-container {
            position: absolute;
            top: 33vh;
            justify-content: space-around;
            z-index: 1;

        }

        .profile-nav {
            position: relative;
        }

        .profile-dropdown {
            display: none;
            position: absolute;
            right: 0;
            margin-top: -30px;
            /* Adjust this value */
            background: white;
            /* Set desired width */
            border-radius: 4px;
            z-index: 1000;
        }

        .profile-nav:hover .profile-dropdown,
        .profile-dropdown:hover {
            display: block;
        }

        .profile-dropdown li {
            padding: 10px
        }

        .profile-dropdown li a {
            display: flex;
            align-items: center;
            text-decoration: none;
            color: #333;
        }

        .profile-dropdown li a:hover {
            background-color: #f5f5f5;
        }

        .card:hover {
            transform: translateY(-15px);

        }

        .card-body img {
            margin-top: 10px;
            margin-bottom: 10px;
        }

        .button-group {
            display: flex;
            justify-content: center;
            margin-top: -100px;

        }

        .header-card h3 {
            color: #FFFFFF;
            margin-top: 20px;
        }

        .footer-content {
            position: absolute;
            top: 220px;
            width: 100%;
            text-align: center;

        }

        .custom-icon path {
            fill: currentColor;
            stroke-width: 1;
        }

        .sidebar-link:hover .custom-icon path {
            fill: #006CA9;
            stroke-width: 0.1;
        }

        .sidebar-link.active .custom-icon path {
            fill: #fff;
            stroke: #fff;
            stroke-width: 0.1;
        }
        .notification-box {
            position: relative;
            margin-top: -12px;
            margin-right: 190px;
        }
        .badge {
            position: absolute;
            right: -5px;
            top: -6px;
            padding: 2px 4px;
            font-size: 11px;
            font-weight: 700;
            font-family: work-Sans, sans-serif;
        }
        .notification-dropdown {
            top: 52px;
            width: 350px;
            right: 20px !important;
            left: unset;
        }
        .dropdown-title {
            padding: 20px;
            text-align: center;
            border-bottom: 1px solid rgba(145, 142, 153, 0.3);
        }
        .primary {
            color: #006CA9;
        }
        .bg-primary-light {
            background-color: #E6F0F6;
        }

        .badge-icon-menu {
            position: absolute;
            right: -5%;
            top: -5%;
            padding: 5px 13px;
            font-size: 20px;
            color: white;
            font-weight: 700;
        }

    </style>

</head>

<body class="page-body">
    <div class="header-card">
        <div class="profile-nav pe-0 py-0" style="position: absolute; top: 20px; right: 0px;">
            <li class="onhover-dropdown">
                <div class="notification-box">
                    <i data-feather="bell" style="stroke: white;"></i><span
                        class="badge rounded-pill badge-secondary">4 </span>
                </div>
                <div class="onhover-show-div notification-dropdown">
                    <h6 class="f-18 mb-0 dropdown-title">Notitications </h6>
                    <ul class="">
                        <li class="b-primary bg-primary-light border-1 p-10 m-2 b-r-3">
                            <span class="f-14 primary f-w-600 mb-1">Organization Structure Approval</span>
                            <p class="f-12 f-w-400">There is a approval request for organization structure #Req/SO/01122024/001. Click here to see detail.</p>
                            <span class="f-12 f-w-400 text-muted">20/08/2024, 13:30</span>
                        </li>
                    </ul>
                </div>
            </li>
        </div> 
        <div class="profile-nav onhover-dropdown pe-0 py-0" style="position: absolute; top: 20px; right: 20px;">
            <div class="media profile-media" style="margin-right:10px">
                <img src="~/assets/images/homepage/user_profile.png" alt="User Profile"
                    style="border-radius: 50%; width: 40px; height: 40px;margin-right:10px">
                <div class="media-body">
                    <span style="color:#ffffff;font-weight:bold;font-size:14px">Superadmin</span>
                    <p class="mb-0 font-roboto" style="color:#ffffff;font-size:12px">Superadmin <i
                            class="middle fa fa-angle-down"></i>
                    </p>
                </div>
            </div>
            <ul class="profile-dropdown onhover-show-div">
                <li><a href="#"><i data-feather="user" width="18" style="margin-right:5px"></i><span>My
                            Profile</span></a></li>
                <li onclick="handleLogout()"><a>
                        <i data-feather="log-in" width="18" style="margin-right:5px"></i><span>Logout</span></a>
                </li>
            </ul>
        </div>
        <img src="~/assets/images/homepage/logo.svg" alt="Logo" style="max-height: 80px; margin-top:-20px">
        <h3>INTEGRATED ORGANIZATION MANAGEMENT SYSTEM</h3>
    </div>
    <div class="content-card ">
        <div class="row card-container" id="mainMenu">

        </div>
        <div class="row">
            <div class=" col-12">
                <div class="button-group" id="setting">
                </div>
            </div>
            <div class="col-12">
                <div class="footer-content">
                    <p>Copyright © 2024 PT Pertamina Patra Niaga</p>
                </div>
            </div>
        </div>
    </div>
    <script src="https://unpkg.com/feather-icons"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/feather-icons/4.28.0/feather.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/wow/1.1.2/wow.min.js"></script>
    <script>
        const baseImageUrl = '@Url.Content("~/assets/images/homepage/")';
        feather.replace();
        new WOW().init();
        document.addEventListener('DOMContentLoaded', function () {
            const profileNav = document.querySelector('.profile-nav');
            const dropdown = profileNav.querySelector('.profile-dropdown');

            profileNav.addEventListener('click', function () {
                dropdown.style.display = dropdown.style.display === 'block' ? 'none' : 'block';
            });

            document.addEventListener('click', function (event) {
                if (!profileNav.contains(event.target)) {
                    dropdown.style.display = 'none';
                }
            });
        });

    </script>
    <script src="../assets/js/authentication.js"></script>
    <script src="../assets/js/homepage.js"></script>
</body>

</html>
