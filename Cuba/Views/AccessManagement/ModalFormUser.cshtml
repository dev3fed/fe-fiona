<!-- Include Animate.css -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
<style>
    .modal-dialog.modal-formuser {
        max-width: 50%;
        margin: 120px auto;
    }
</style>
<div class="modal fade" id="modalFormuser" tabindex="-1" role="dialog" aria-labelledby="modalFormuserLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-formuser bounceInDown  animated" role="document">
        <div class="modal-content" style="border-radius: 8px;">
            <div class="modal-header">
                <h5 class="modal-title" id="modalFormuserTitle">Create User</h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="body-formuser">
                <div class="row">
                    <div class="col-6">
                        <label class="form-label">Employee ID</label>
                        <select class="form-select">
                            <option selected="" disabled="" value="">Choose</option>
                            <option>...</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Employee Name</label>
                        <input class="form-control" type="text" id="input-draftname" disabled>
                    </div>
                    <div class="col-12 mt-3">
                        <label class="form-label">Role</label>
                        <select class="form-select">
                            <option selected="" disabled="" value="">Choose</option>
                            <option>...</option>
                        </select>
                    </div>
                    <div class="col-6 mt-2">
                        <label class="col-form-label">Password</label>
                        <div class="form-input ">
                            <input class="form-control" type="password" id="password" required="">
                            <div class="show-hide" onclick="togglePasswordVisibility('password')"><span class="show">
                                </span></div>
                        </div>
                    </div>
                    <div class="col-6 mt-2">
                        <label class="col-form-label">Re-Type Password</label>
                        <div class="form-input ">
                            <input class="form-control" type="password" id="confirmPassword" required="">
                            <div class="show-hide" onclick="togglePasswordVisibility('confirmPassword')"><span
                                    class="show"> </span></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer  d-flex justify-content-end">
                <div>
                    <button class="btn btn-outline-light" type="button" data-bs-dismiss="modal"><i
                            class="icon-arrow-left"></i> Back</button>
                    <button id="applyFilterBtn" class="btn btn-primary" type="button">
                        <div class="d-flex align-items-center">
                            <div class="spinner-border spinner-border-sm text-light me-2" style="display: none;"
                                id="loadingCreateuser" role="status"></div>
                            <span class="btn-text">Create</span>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Bootstrap JS and Popper.js -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/js/bootstrap.min.js"></script>
