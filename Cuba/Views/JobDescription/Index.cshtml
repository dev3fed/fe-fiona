@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Chart-Widget";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .os-container {
        height: 500px;
        background-color: #F5F5F5;
    }

    #orgThree .no-children .jstree-icon {
        display: none !important;
        /* Use !important to ensure it overrides other styles */
    }


    /* Hide the node icons */
</style>
<link rel="stylesheet" type="text/css" href="~/assets/css/job-description.css">
@* style link *@
<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/buttons/3.1.2/css/buttons.dataTables.css">
<div class="page-body">
    <div class="container-fluid">
        <div class="page-title">
            <div class="row">
                <div class="col-6">
                    <h3>Job Description</h3>
                </div>
                <div class="col-6">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-controller="HomePage" asp-action="Index">
                                <svg class="stroke-icon">
                                    <use href="../assets/svg/icon-sprite.svg#stroke-home"></use>
                                </svg>
                            </a>
                        </li>
                        <li class="breadcrumb-item active">Job Description</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <!-- Container-fluid starts-->
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-12">
                <div class="card" style="border-radius:8px">
                    <div style="padding:10px">
                        <ul class="nav nav-tabs nav-primary d-none" id="pills-warningtab" role="tablist">
                            <li class="nav-item"><a class="nav-link active" id="pills-jobdesc" data-bs-toggle="pill"
                                    href="#jobdesc" role="tab" aria-controls="pills-matrix"
                                    aria-selected="true">Summary</a></li>
                            <li class="nav-item"><a class="nav-link" id="pills-draft" data-bs-toggle="pill"
                                    href="#draft" role="tab" aria-controls="pills-draft" aria-selected="false">Draft
                                </a></li>
                            <li class="nav-item"><a class="nav-link" id="pills-request" data-bs-toggle="pill"
                                    href="#request" role="tab" aria-controls="pills-request"
                                    aria-selected="false">Approval
                                </a></li>
                            <li class="nav-item"><a class="nav-link" id="pills-log" data-bs-toggle="pill" href="#log"
                                    role="tab" aria-controls="pills-log" aria-selected="false">Log History
                                </a></li>
                        </ul>
                        <div class="tab-content" id="pills-rasci-tabcontent">
                            <div class="tab-pane fade show active" id="jobdesc" role="tabpanel"
                                aria-labelledby="pills-jobdesc">
                                <div class="card-body" style="padding:15px 5px 15px 5px !important">
                                    <div class="row">
                                        <div class="col-3">
                                            <label for="">Job Desc Data Source</label>
                                            <select class="form-select digits" id="selectJobDescDraft"
                                                name="selectJobDescDraft">
                                            </select>
                                        </div>
                                        <div class="col-3">
                                            <label for="searchJobDesc">Search</label>
                                            @* <input class="form-control" type="text" placeholder="Search" id="searchJobDesc" style="border-top-left-radius: 0; border-bottom-left-radius: 0;"> *@
                                            <div class="btn-group w-100" role="group"
                                                aria-label="Button group with nested dropdown"
                                                style="border-top-left-radius: 0; border-bottom-left-radius: 0;">
                                                <div class="btn-group" role="group">
                                                    <button class="btn btn-light dropdown-toggle" id="btnSearchType"
                                                        type="button" data-bs-toggle="dropdown" aria-haspopup="true"
                                                        aria-expanded="false">Position</button>
                                                    <div class="dropdown-menu" aria-labelledby="btnSearchType">
                                                        <a class="dropdown-item di" value="position">Position</a>
                                                        <a class="dropdown-item di" value="function">Function</a>
                                                        <a class="dropdown-item di" value="division">Division</a>
                                                        <a class="dropdown-item di" value="department">Department</a>
                                                    </div>
                                                </div>
                                                <input class="form-control" type="text" placeholder="Search"
                                                    id="searchJobDesc"
                                                    style="border-top-left-radius: 0; border-bottom-left-radius: 0;">
                                            </div>
                                        </div>
                                        <div class="col-2" style="padding-left: 0;place-self: end;">
                                            <select class="form-select digits" name="selectStatusJobDesc"
                                                id="selectStatusJobDesc">
                                                <option value="all">All Status</option>
                                                <option value="not available">Not Available</option>
                                                <option value="on progress">On Progress</option>
                                                <option value="available">Available</option>
                                                <option value="waiting approval">Waiting Approval</option>
                                            </select>
                                        </div>
                                        <div class="col-4 d-flex" style="padding-left: 0;">
                                            <button class="btn btn-outline-primary me-2 btn-icon"
                                                style="height: 42px;place-self: end;width:75px" type="button"
                                                id="clearFilter">
                                                Clear
                                            </button>
                                            <button class="btn btn-primary me-2 btn-icon"
                                                style="height: 42px;place-self: end;width:75px" type="button"
                                                id="searchFilter">
                                                Search
                                            </button>
                                            <button class="btn btn-primary me-2 btn-icon dropdown-toggle d-none" id="downloadJobDesc" style="height: 42px;place-self: end;width:100px" type="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Option</button>
                                            <div class="dropdown-menu" aria-labelledby="downloadJobDesc">
                                                <a class="dropdown-item" href="#" style="padding: 12px;">
                                                    <img src="~/assets/images/rasci/download-black.svg"
                                                        alt="Filter Icon" class=""
                                                        style="margin-top: -1px;padding-right: 5px;">
                                                    Download
                                                </a>
                                                <a class="dropdown-item" href="#" id="createDraft"
                                                    style="padding: 12px;">
                                                    <img src="~/assets/images/rasci/plus-black.svg" alt="Filter Icon"
                                                        class="" style="margin-top: -1px;padding-right: 5px;">
                                                    Create Draft
                                                </a>

                                            </div>
                                            @* <button class="btn btn-primary me-2 btn-icon"  style="height: 42px;place-self: end;" type="button" id="downloadJobDesc"><img src="~/assets/images/rasci/vector.svg" alt="Filter Icon" style="margin-top: -5px;margin-right: 7px;">Download</button> *@
                                        </div>
                                    </div>
                                    <div class="row d-none">
                                        <div class="col-12 mt-1">
                                            <span class="notifDanger">There are 5 positions with job descriptions not
                                                available <span><b>[Click here to show]</b></span></span>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-12 mt-2">
                                            <div class="table-responsive">
                                                <table class="tableMasterData table table-hover w-100" id="jobdescList">
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="draft" role="tabpanel" aria-labelledby="pills-draft">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-12">
                                            <div class="table-responsive">
                                                <table class="tableMasterData table table-hover w-100" id="draftList">
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="request" role="tabpanel" aria-labelledby="pills-request">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-2">
                                            <div class="input-group date" id="dt-minimum" data-target-input="nearest">
                                                <div class="input-group-text" data-target="#dt-minimum"
                                                    data-toggle="datetimepicker"><i data-feather="calendar"
                                                        style="width: 20px;"></i></div>
                                                <input class="form-control" type="text" name="datePicker"
                                                    id="createDate" placeholder="Submitted Date">
                                            </div>
                                        </div>
                                        <div class="col-2">
                                            <div class="input-group date" id="dt-minimum" data-target-input="nearest">
                                                <div class="input-group-text" data-target="#dt-minimum"
                                                    data-toggle="datetimepicker"><i data-feather="calendar"
                                                        style="width: 20px;"></i></div>
                                                <input class="form-control" type="text" name="datePicker"
                                                    placeholder="Approved/Reject Date">
                                            </div>
                                        </div>
                                        <div class="col-2">
                                            @* select *@
                                            <select class="form-select digits" name="selectDraftOrganizationNew"
                                                id="selectDraftOrganizationNew" placeholder="Organization">
                                                <option value="0">Choose</option>
                                                <option value="1">Status 1</option>
                                                <option value="2">Status 2</option>
                                                <option value="3">Status 3</option>
                                            </select>

                                        </div>
                                        <div class="col-4">
                                            <div class="faq-form">
                                                <input class="form-control" type="text" placeholder="Search.."><i
                                                    class="search-icon" data-feather="search"></i>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row m-t-10">
                                        <div class="col-12">
                                            <div class="table-responsive">
                                                <table class="tableMasterData table table-hover w-100"
                                                    id="approvalList">
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="log" role="tabpanel" aria-labelledby="pills-log">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-3">
                                            <div class="input-group date" id="dt-minimum" data-target-input="nearest">
                                                <div class="input-group-text" data-target="#dt-minimum"
                                                    data-toggle="datetimepicker"><i data-feather="calendar"
                                                        style="width: 20px;"></i></div>
                                                <input class="form-control" type="text" name="datePicker"
                                                    placeholder="Date">
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="faq-form">
                                                <input class="form-control" type="text" placeholder="Search.."><i
                                                    class="search-icon" data-feather="search"></i>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row m-t-10">
                                        <div class="col-12">
                                            <div class="table-responsive">
                                                <table class="tableMasterData table table-hover w-100" id="logList">
                                                </table>
                                            </div>
                                        </div>
                                        @* <div class="col-12">
                                            <div id="empty-data-container" class="empty-data-container text-center align-content-center " style="">
                                                <img src="../assets/images/organization-structure/Vector.png" alt="Filter Icon" style="margin-top: -1px;margin-right: 2px;">
                                                <br>
                                                <h5 class="text-black-50 m-t-10">Coming Soon</h5>
                                            </div>
                                        </div> *@
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>



    <partial name="~/Views/JobDescription/ModalConfirm.cshtml" />
    <partial name="~/Views/JobDescription/ModalCreateDraftJobDesc.cshtml" />
</div>
@section Script {
    <script>
        const url_api = "@Configuration["AppSettings:ApiUrl"]";
    </script>
    <!-- Plugins JS start-->
    <script src="../assets/js/sidebar-menu.js"></script>
    <script src="../assets/js/slick/slick.min.js"></script>
    <script src="../assets/js/slick/slick.js"></script>
    <script src="../assets/js/header-slick.js"></script>
    <script src="../assets/js/tree/jstree.min.js"></script>
    <script src="../assets/js/sweet-alert/sweetalert.min.js"></script>

    @* <script src="../assets/js/tree/tree.js"></script> *@
    <!-- Plugins JS Ends-->
    @* datatable *@
    <script src="../assets/js/datatable/datatables/jquery.dataTables.min.js"></script>
    <script src="../assets/js/datatable/datatable-extension/dataTables.buttons.min.js"></script>

    @* custom js *@
    <script src="../assets/js/job-description/constant.js"></script>
    <script src="../assets/js/job-description/multiple-select.js"></script>
    <script src="../assets/js/job-description/table-custom.js"></script>
    <script src="../assets/js/authentication.js"></script>
    <script src="../assets/js/job-description/helper.js"></script>
    <script src="../assets/js/job-description/endpoint.js"></script>
    <script src="../assets/js/job-description/index.js"></script>

    <script src="../assets/js/script.js"></script>
    @* <script src="../assets/js/script.js"></script> *@

}