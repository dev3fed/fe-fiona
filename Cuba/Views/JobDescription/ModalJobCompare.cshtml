<!-- Include Animate.css -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    .modal-dialog.modal-compare {
        max-width: 50% !important;
        margin: 30px auto;
    }

    .modal-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .btn-outline-light .icon-arrow-left {
        font-size: 12px;
        margin-right: 8px;
    }

    .reset-label-compare {
        color: #9F9FA5;
    }

    .custom-card {
        height: 600px !important;
        border: 1px solid #BFBFC2;
        border-radius: 4px;
        padding: 10px;
        margin-top: 10px
    }

    .custom-card-Bottom {
        height: 45px;
        border: 1px solid #BFBFC2;
        border-radius: 4px;
        padding: 10px;
        margin-top: 10px
    }

    .scrollable {
        max-height: 480px;
        overflow-y: auto;
        padding-right: 10px;
    }

    .scrollable::-webkit-scrollbar {
        width: 10px;
        height: 8px;
    }

    .scrollable::-webkit-scrollbar-track {
        box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.3);
        border-radius: 10px;
    }

    .scrollable::-webkit-scrollbar-thumb {
        background: #006ca9;
        border-radius: 10px;
    }

    .scrollable::-webkit-scrollbar-thumb:hover {
        background: #006ca9;
    }

    .tooltip-inner {
        background-color: #ffffff !important;
        color: #000000;
        border: 1px solid #cccccc;
    }

    .row-item {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
    }

    .column-checkbox {
        flex: 0 0 10px;
        margin-right: 10px;
    }

    .column-item-name {
        @* flex: 1; *@
        padding-right: 5px;
        word-wrap: break-word;
    }

    .remove-item {
        cursor: pointer;
        transition: color 0.3s ease;
        color: red;
        margin-top: 5px;
    }
</style>

<div class="modal fade" id="modalJobCompare" tabindex="-1" role="dialog" aria-labelledby="modalJobCompareLabel"
    aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-compare bounceInDown  animated modal-xl" role="document">
        <div class="modal-content" style="border-radius: 8px;">
            <div class="modal-header">
                <h5 class="modal-title" id="modalJobCompareLabel">Add Jobdesc Reference</h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="chooseJob">
                    <div class="row">
                        <div class="col-12">
                            <div class="media">
                                <div class="media-body switch-sm d-flex align-items-center justify-content-between w-100">
                                    <div class="col">
                                        <div class="m-t-15 m-checkbox-inline custom-radio-ml">
                                            <div class="form-check form-check-inline radio radio-primary">
                                                <input class="form-check-input" id="searchByPercentage" type="radio" name="searchReferenceBy" value="searchByPercentage" checked >
                                                <label class="form-check-label mb-0" for="searchByPercentage">Search by RASCI similarities (%)</span></label>
                                            </div>
                                            <div class="form-check form-check-inline radio radio-primary">
                                                <input class="form-check-input" id="searchByName" type="radio" name="searchReferenceBy" value="searchByName" >
                                                <label class="form-check-label mb-0" for="searchByName">Search by Job Name</span></label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12" id="searchDiv">
                            <div class="custom-card">
                                <input class="form-control" type="text" placeholder="Search" id="inputSearchCompare"
                                    oninput="debounceSearchJobCompare(event)">
                                <div class="animate-chk mt-3 scrollable" style="height: 500px;background: #f8f9fa;padding: 10px;">
                                    <div id="chk-job-list" class="chk-job-list" style="height: 480px; background: #f8f9fa; display: flex; flex-direction: column;">
                                    <div style="text-align: center; color: #b9c0c7;display: flex; flex-direction: column; justify-content: center; align-items: center; height: 100%;">
                                            <p class="mt-2 mb-0">Search job by name </p>
                                        </div>
                                        </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12" id="percentageDiv">
                            <div class="custom-card">
                                @* <div class="col-md-12">
                                    <input id="rangePercentage" type="text"  oninput="searchJobCompare(event,'pecentage')">
                                </div> *@
                                <div class="row">
                                    <div class="col-6">
                                        <select class="form-select digits" id="selectSK" name="selectSK">
                                        </select>
                                    </div>
                                    <div class="col-6">
                                        <div id="form-wrapper">
                                            <form id="percentage-amount-form">
                                                <div id="percentage-amount-slider">
                                                    <input type="radio" name="percentage-amount" id="50" value="50" required>
                                                    <label for="50" data-percentage-amount="50%"></label>
                                                    <input type="radio" name="percentage-amount" id="60" value="60" required>
                                                    <label for="60" data-percentage-amount="60%"></label>
                                                    <input type="radio" name="percentage-amount" id="70" value="70" required>
                                                    <label for="70" data-percentage-amount="70%"></label>
                                                    <input type="radio" name="percentage-amount" id="80" value="80" required>
                                                    <label for="80" data-percentage-amount="80%"></label>
                                                    <input type="radio" name="percentage-amount" id="90" value="90" required>
                                                    <label for="90" data-percentage-amount="90%"></label>
                                                    <input type="radio" name="percentage-amount" id="100" value="100" required>
                                                    <label for="100" data-percentage-amount="100%"></label>
                                                    <div id="percentage-amount-pos"></div>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                                @* <input class="form-control" type="text" placeholder="Search" id="inputSearchCompare"
                                    oninput="searchJobCompare(event)"> *@
                                <div class="animate-chk mt-3 scrollable" style="height: 500px;background: #f8f9fa;padding: 10px;">
                                    <div id="chk-job-list-percentage" class="chk-job-list-percentage" style="height: 480px; background: #f8f9fa; display: flex; flex-direction: column;">
                                        <div style="text-align: center; color: #b9c0c7;display: flex; flex-direction: column; justify-content: center; align-items: center; height: 100%;">
                                            <p class="mt-2 mb-0">Select criteria to view job matches</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        @* <div class="col-6">
                            <div class="custom-card">
                                <div class="mt-3 scrollable">
                                    <div id="job-selected-list"></div>
                                </div>
                            </div>
                        </div> *@
                    </div>
                </div>
                @* <div id="detailJob">
                </div> *@
            </div>
            <div class="modal-footer  d-flex justify-content-end">
                <div>
                    <button class="btn btn-outline-light" type="button" data-bs-dismiss="modal"
                        onclick="handleCloseModal()">
                        @* <i class="icon-arrow-left"></i> *@
                         Back</button>
                    @* <button class="btn btn-primary" type="button" onclick="applyCompare()">
                        Apply Compare
                    </button> *@
                    @* <button class="btn btn-primary" type="button" id="saveReference">
                        <img src="~/assets/images/rasci/incon_success.svg" alt="Filter Icon" style="margin-right: 8px;">
                        save
                    </button> *@
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Bootstrap JS and Popper.js -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/js/bootstrap.min.js"></script>
