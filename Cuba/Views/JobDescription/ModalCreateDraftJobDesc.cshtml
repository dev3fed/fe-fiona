<link rel="stylesheet" type="text/css" href="~/assets/css/organization-structure.css">
<div class="modal fade" id="modalCreateDraftJobDesc" tabindex="-1" role="dialog" aria-labelledby="modalLabelCreateDrafeJobDesc" aria-hidden="true">
    <div class="modal-dialog modal-md" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="modalLabelCreateDrafeJobDesc">Create Job Desc Draft</h6>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row m-t-10 mb-2">
                    <div class="col-md-12 mb-3">
                        <div class="form-group">
                            <label for="selectDraftRacsi">Rasci Matrix Data Source</label>
                            <select class="form-select digits" style="" class="select-class" id="selectDraftRacsi" name="selectDraftRacsi"> 
                            </select>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group">
                            <label for="draftName">Draft Name</label>
                            <input class="form-control" class="select-class" id="inputDraftName" type="text" placeholder="Input Draft Name" required="">
                        </div>
                    </div>
                </div> 
            </div>
            <div class="modal-footer d-flex justify-content-end">
                <div class="text-end ">
                    <button class="btn btn-outline-light" type="button" data-bs-dismiss="modal">
                        Back
                    </button>
                    <button class="btn btn-primary" type="button" id="saveDraft">
                        Save Draft
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

