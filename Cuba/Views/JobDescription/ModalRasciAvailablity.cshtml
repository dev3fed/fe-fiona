<style>
    .modal-dialog{
        max-width:65% !important;
        width:50% !important;
        margin: 30px auto;
    }
</style>

<link rel="stylesheet" type="text/css" href="~/assets/css/organization-structure.css">
<div class="modal fade" id="modalRasciAvailability" tabindex="-1" role="dialog" aria-labelledby="modalRasciAvailability" aria-hidden="true">
    <div class="modal-dialog " role="document">
        <div class="modal-content">
            <div class="modal-header" id="modalRasciAvailabilityHeader">
                <span class="notifWarningModalBP" id="notifWarningModalBP" style="border-radius:4px"></span>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="filterRasciAvailablity" class="m-b-3">
                    <input type="text" id="searchRasciAvailability" placeholder="Search Business Process..." class="form-control mb-2" />
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="availableCheckbox" value="available">
                        <label class="form-check-label" for="availableCheckbox">Available</label>   
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="notAvailableCheckbox" value="notAvailable">
                        <label class="form-check-label" for="notAvailableCheckbox">Not Available</label>
                    </div>
                </div>
                <div id="modalRasciAvailabilityBody"> </div>
            </div>
            <div class="modal-footer d-flex justify-content-end">
                <div class="text-end " id="modalRasciAvailabilityFooter">
                </div>
            </div>
        </div>
    </div>
</div>
