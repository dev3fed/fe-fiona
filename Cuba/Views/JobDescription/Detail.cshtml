@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Chart-Widget";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    #os-container {
        height: 480px !important;
        background-color: #F5F5F5;
    }
</style>
<style id="myStyle">
    [data-l-id] path {
        stroke: #000000;
        stroke-width: 0.6px;
    }
    [data-n-id] circle {
        stroke: #000000;
        stroke-width: 0.6px;
    }
    [data-n-id] rect {
        stroke: #000000;
        stroke-width: 0.6px;
    }
    [data-ctrl-ec-id] circle,
    [data-ctrl-ec-id] line {
        stroke: #000000;
        stroke-width: 0.6px;
    }
    [data-l-id].direktur > path {
        stroke-dasharray: 3, 3;
    }

    @* class edit *@
    
    [data-n-id].delete rect {
        fill: #f8d7da;
        stroke: #dc3545;
    }
    [data-n-id].pointed rect {
        fill: #cec9c9 !important;
    }
    .match rect:nth-child(2){
        fill: #F57C00;
        stroke: #F57C00;
    }

    .match path, .match circle{
        stroke: #F57C00;
    }

    [data-n-id].bracket_4_edit rect {
        fill: #FFD700;
    }

    
</style>
<script src="../assets/js/balkan/orgchart.js"></script>
