@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Chart-Widget";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .chart-container-custom{
        width: 100%;
        height: 700px;
        }

    .svg-chart-container {
        width: 100%;
        height: 700px;
    }

    .chart-exp-mid{
        width: 1100px;
        height: 600px;
        position: relative
    }
    
    
    #orgThree .no-children .jstree-icon {
        display: none !important;
        /* Use !important to ensure it overrides other styles */
    }
    
    /* CKEditor custom styling */
    .ck-editor__editable {
        min-height: 100px;
        border: 1px solid #ced4da;
        border-radius: 0.25rem;
    }
    
    .ck-editor__editable:focus {
        border-color: #80bdff;
        box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
    }
    
    .ck-toolbar {
        border: 1px solid #ced4da;
        border-bottom: none;
        border-radius: 0.25rem 0.25rem 0 0;
    }
    
    /* Ensure CKEditor plays well with Bootstrap modals */
    .modal .ck-editor {
        position: relative;
        z-index: 1060;
    }

    .ck-content ul {
        list-style-type: disc !important;
        padding-left: 15px;
        margin-bottom: 0;
    }
    
    .modal .ck-dropdown__panel {
        z-index: 2000;
    }
    
    /* Hide CKEditor branding completely */
    .ck-powered-by,
    .ck-powered-by-balloon {
        display: none !important;
        visibility: hidden !important;
    }
    
    .ck-balloon-panel .ck-powered-by {
        display: none !important;
    }
</style>
<style id="myStyle">
    [data-l-id] path {
        stroke: #000000;
        stroke-width: 0.6px;
    }

    [data-n-id] circle {
        stroke: #000000;
        stroke-width: 0.6px;
    }

    [data-n-id] rect {
        stroke: #000000;
        stroke-width: 0.6px;
    }

    [data-ctrl-ec-id] circle,
    [data-ctrl-ec-id] line {
        stroke: #000000;
        stroke-width: 0.6px;
    }

    [data-l-id].direktur>path {
        stroke-dasharray: 3, 3;
    }

    @* class edit *@
    [data-n-id].edit rect {
        fill: #e6f6fe;
        stroke: #03a9f4;
    }
    [data-n-id].create rect {
        fill: #e6f6fe;
        stroke: #03a9f4;
    }
    [data-n-id].update rect {
        fill: #e6f6fe;
        stroke: #03a9f4;
    }

    [data-n-id].delete rect {
        fill: #f8d7da;
        stroke: #dc3545;
    }

    [data-n-id].pointed rect {
        stroke: #03A9F4;
        stroke-width: 3;
    }

    .match rect:nth-child(2) {
        fill: #F57C00;
        stroke: #F57C00;
    }

    .match path,
    .match circle {
        stroke: #F57C00;
    }

    [data-n-id].bracket_4_edit rect {
        fill: #FFD700;
    }
</style>
