@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Chart-Widget";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" type="text/css" href="~/assets/css/rasci-matrix.css">
<link href="~/assets/css/clusterize.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/clusterize.js/0.18.0/clusterize.min.css">
<style>
    #draft-detail {
        display: none;
    }

    #header-detail-draft {
        display: none;
    }

    #approval-detail {
        display: none;
    }

    #header-detail-approval {
        display: none;
    }

    #main-matrix {
        display: block;
    }

    #header-matrix {
        display: block;
    }

    .organization-alert {
        display: inline-block;
        margin: 0 0 14px 12px;
        padding: 6px;
        border: solid 1px #D53C50;
        background-color: #FAE9EB;
        border-radius: 4px;
        width: auto;
        word-wrap: break-word;
    }

    .organization-alert .alert-text {
        color: #D02138;
        font-size: 12px;
    }

    .hover-style {
        cursor: pointer;
        text-decoration: none;
    }

    .hover-style:hover {
        text-decoration: underline;
    }

    .swal-custom-popup {
        top: 10% !important;
        /* Atur nilai sesuai keinginan Anda */
        transform: translate(-50%, -10%) !important;
    }
</style>
<div class="page-body">
    <div class="container-fluid">
        <div class="page-title">
            <div class="row">
                <div class="col-6">
                    <h3>RASCI Matrix</h3>
                </div>
                <div class="col-6" id="header-matrix">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-controller="HomePage" asp-action="Index">
                                <svg class="stroke-icon">
                                    <use href="../assets/svg/icon-sprite.svg#stroke-home"></use>
                                </svg>
                            </a>
                        </li>
                        <li class="breadcrumb-item active">RASCI Matrix</li>
                    </ol>
                </div>
                <div class="col-6" id="header-detail-draft">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-controller="HomePage" asp-action="Index">
                                <svg class="stroke-icon">
                                    <use href="../assets/svg/icon-sprite.svg#stroke-home"></use>
                                </svg>
                            </a>
                        </li>
                        <li class="breadcrumb-item">RASCI Matrix</li>
                        <li class="breadcrumb-item active">Detail Draft</li>
                    </ol>
                </div>
                <div class="col-6" id="header-detail-approval">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-controller="HomePage" asp-action="Index">
                                <svg class="stroke-icon">
                                    <use href="../assets/svg/icon-sprite.svg#stroke-home"></use>
                                </svg>
                            </a>
                        </li>
                        <li class="breadcrumb-item">RASCI Matrix</li>
                        <li class="breadcrumb-item active">Approval Detail</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <!-- Container-fluid starts-->
    <div class="container-fluid">
        <div class="row">
            <div class="col-12" id="draft-detail">

                <partial name="ModalEditBp" />
                <partial name="ModalDraftApproval" />
                <partial name="ModalDeleteProsbisdraft" />
                <partial name="DetailDraft" />
            </div>
            <div class="col-12" id="approval-detail">
                <partial name="DetailApproval" />
            </div>
            <div class="col-12" id="main-matrix">
                <div class="card" style="border-radius:8px">
                    <div style="padding:10px">
                        <ul class="nav nav-tabs nav-primary" id="pills-warningtab" role="tablist">
                            <li class="nav-item"><a class="nav-link active" id="pills-chain-tab" data-bs-toggle="pill"
                                    href="#pills-chain" role="tab" aria-controls="pills-chain"
                                    aria-selected="true">Value Chain
                                </a></li>
                            <li class="nav-item"><a class="nav-link " id="pills-matrix-tab" data-bs-toggle="pill"
                                    href="#pills-matrix" role="tab" aria-controls="pills-matrix"
                                    aria-selected="false">RASCI Matrix</a></li>
                            <li class="nav-item"><a class="nav-link" id="pills-draft-tab" data-bs-toggle="pill"
                                    href="#pills-draft" role="tab" aria-controls="pills-draft"
                                    aria-selected="false">Draft
                                </a></li>
                            <li class="nav-item"><a class="nav-link" id="pills-approval-tab" data-bs-toggle="pill"
                                    href="#pills-approval" role="tab" aria-controls="pills-approval"
                                    aria-selected="false">Approval List
                                </a></li>
                            <li class="nav-item"><a class="nav-link" id="pills-log-history-tab" data-bs-toggle="pill"
                                    href="#pills-log-history" role="tab" aria-controls="pills-log-history"
                                    aria-selected="false">Log History
                                </a></li>
                        </ul>
                        <div class="tab-content" id="pills-rasci-tabcontent">
                            <div class="tab-pane fade show active" id="pills-chain" role="tabpanel"
                                aria-labelledby="pills-chain-tab">
                                <div class="card-body" style="padding:15px 5px 15px 5px !important">
                                    <div class="row">
                                        <partial name="RasciChain" />
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade " id="pills-matrix" role="tabpanel"
                                aria-labelledby="pills-matrix-tab">
                                <div class="card-body" style="padding:15px 5px 15px 5px !important">
                                    <div class="row">
                                        <div class="col-12">
                                            <!-- Starts Modal Filter-->
                                            <partial name="RasciFilter" />
                                            <!-- Ends Modal Filter-->

                                            <!-- Starts Modal Job Compare-->
                                            <partial name="ModalJobCompare" />
                                            <!-- Ends Modal Job Compare-->

                                            <!-- Start Modal Search -->
                                            <partial name="ModalSearch" />
                                            <!-- End Modal Search -->

                                            <!-- Start Modal business Process -->
                                            <partial name="ModalBusinessProcess" />
                                            <!-- End Modal business Process -->

                                            <!-- Start Modal series process -->
                                            <partial name="ModalSeriesProses" />
                                            <!-- End Modal series process -->

                                            <!-- Start Modal Detail job -->
                                            <partial name="ModalDetailJob" />
                                            <!-- End Modal Detail job -->

                                            <!-- Start Modal choose RASCI Matrix Draft -->
                                            <partial name="ModalChooseDraft" />
                                            <!-- End Modal choose RASCI Matrix Draft -->

                                            <!-- Start Modal Add Business Process -->
                                            <partial name="ModalAddBp" />
                                            <!-- End Modal Add Business Process -->

                                            <!-- Start Modal add notification -->
                                            <partial name="ModalAddNotation" />
                                            <!-- End Modal add notification -->

                                            <!-- Start Modal add notation by row column-->
                                            <partial name="ModalNotationRow" />
                                            <!-- End Modal add notation by row column-->

                                            <!-- Start Modal add notation by reference column-->
                                            <partial name="ModalEditNotationref" />
                                            <!-- End Modal add notation by reference column-->

                                            <!-- Start Modal edit business process-->
                                            <partial name="ModalEditBusinessProcess" />
                                            <!-- End Modal edit business process-->

                                            <!-- Start Modal delete business process-->
                                            <partial name="ModalDeleteBp" />
                                            <!-- End Modal delete business process-->

                                            <!-- Start Modal save as draft  -->
                                            <partial name="ModalSaveDraft" />
                                            <!-- End Modal save as draft  -->

                                            <!-- Start Modal Approval  -->
                                            <partial name="ModalApproval" />
                                            <!-- End Modal Approval  -->

                                            <!-- Start Modal Add Mapping  -->
                                            <partial name="ModalAddMapping" />
                                            <!-- End Modal Add Mapping  -->

                                            <!-- Start Modal Create Draft  -->
                                            <partial name="ModalCreateDraft" />
                                            <!-- End Modal Create Draft  -->

                                        </div>
                                        <div class="col-12 d-flex align-items-center mb-2">
                                            <span class="me-3" style="min-width: 130px;">RASCI Data Source</span>
                                        </div>
                                        <div class="col-4">
                                            <select class="form-select digits" id="dataSource-rasci">
                                                <option value="master">Master data RASCI</option>
                                            </select>
                                        </div>
                                        @* <div class="row">
                                            <div class="col-9 d-flex align-items-center mb-3 organization-alert">
                                                <span class="alert-text">
                                                    Organization Data Source is from draft Evaluasi Struktur Organisasi
                                                    2025, with 3 positions unmapping to RASCI.
                                                    <b class="hover-style" onclick="handleClickAlert()">[Click here for
                                                        details]</b>
                                                </span>
                                            </div>
                                        </div> *@
                                        <div class="col-5 d-flex justify-content-end">
                                            <div class="btn-group w-100" role="group"
                                                aria-label="Button group with nested dropdown">
                                                <div class="btn-group" role="group">
                                                    <button class="btn btn-light dropdown-toggle" id="btnGroupDrop1"
                                                        type="button" data-bs-toggle="dropdown" aria-haspopup="true"
                                                        aria-expanded="false">RASCI
                                                        by Pos..</button>
                                                    <div class="dropdown-menu" aria-labelledby="btnGroupDrop1">
                                                        <a class="dropdown-item"
                                                            onclick="setSelectedText('RASCI by Pos...')">RASCI by
                                                            Position</a>
                                                        <a class="dropdown-item"
                                                            onclick="setSelectedText('RASCI by Bus...')">RASCI
                                                            by Business
                                                            Process</a>
                                                        <a class="dropdown-item"
                                                            onclick="setSelectedText('Business Pro...')">Business
                                                            Process</a>
                                                    </div>
                                                </div>
                                                <input class="form-control" type="text" placeholder="Search"
                                                    id="inputText"
                                                    style="border-top-left-radius: 0; border-bottom-left-radius: 0;">
                                            </div>
                                        </div>
                                        <div class="col-3 d-flex justify-content-end" style="padding-left: 0;">
                                            <button id="searchButton" class="btn btn-primary me-2" type="button"
                                                style="width: 100px;" disabled>
                                                <div class="d-flex align-items-center justify-content-center w-100">
                                                    <div class="spinner-border spinner-border-sm text-light me-2"
                                                        style="display: none;" id="loadingSearch" role="status"></div>
                                                    <span class="btn-text">Search</span>
                                                </div>
                                            </button>
                                            <button id="clearButton" class="btn btn-outline-primary me-2" type="button"
                                                onclick="clearInput()" style="width: 100px;">
                                                <div class="d-flex align-items-center justify-content-center w-100">
                                                    <div class="spinner-border spinner-border-sm text-light me-2"
                                                        style="display: none;" id="loadingClear" role="status"></div>
                                                    <span class="btn-text">Clear</span>
                                                </div>
                                            </button>
                                            <div class="btn-group" role="group">
                                                <button class="btn btn-primary dropdown-toggle btn-icon"
                                                    id="btnGroupVerticalDrop1" type="button" data-bs-toggle="dropdown"
                                                    aria-haspopup="true" aria-expanded="false"><img
                                                        src="~/assets/images/rasci/icon_menudots.svg" alt="Filter Icon"
                                                        style="margin-top: -1px;">Option</button>
                                                <div class="dropdown-menu" aria-labelledby="btnGroupVerticalDrop1">
                                                    <a class="dropdown-item" onclick="onModalFilter()">
                                                        <img src="~/assets/images/rasci/icon_filter.svg"
                                                            alt="Filter Icon">Filter
                                                    </a>
                                                    <a class="dropdown-item" data-bs-toggle="modal"
                                                        data-bs-target="#modalJobCompare">
                                                        <img src="~/assets/images/rasci/icon_compare.svg"
                                                            alt="Filter Icon"> Position Compare
                                                    </a>
                                                    <a class="dropdown-item" onclick="handleExportMatrix()">
                                                        <img src="~/assets/images/rasci/icon_export.svg"
                                                            alt="Filter Icon" style="margin-top: -5px;"> Export
                                                    </a>
                                                    <a class="dropdown-item" onclick="onModalAddBp()" id="btnAddBp">
                                                        <img src="~/assets/images/rasci/plus-black.svg"
                                                            alt="Filter Icon" style="margin-top: -1px;">Add New Business
                                                        Process
                                                    </a>
                                                    <a class="dropdown-item" onclick="onModalAddNotation()"
                                                        id="btnAddNotation">
                                                        <img src="~/assets/images/rasci/plus-black.svg"
                                                            alt="Filter Icon" style="margin-top: -1px;">Add RASCI
                                                    </a>
                                                    <a class="dropdown-item" onclick="openModalCreatedraft()"
                                                        id="btnFormdraft">
                                                        <img src="~/assets/images/rasci/plus-black.svg"
                                                            alt="Filter Icon" style="margin-top: -1px;">Create Draft
                                                    </a>
                                                </div>
                                            </div>
                                            @* <button class="btn btn-primary btn-icon" type="button"> <img
                                                    src="~/assets/images/rasci/vector.svg" alt="Filter Icon"
                                                    style="margin-top: -5px;">Export</button> *@
                                        </div>
                                        <div class="col-12 mt-2">
                                            <div class="loading-container">
                                                <div id="icon-container" class="loading-icon"></div>
                                                <div id="text-info"></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class=" mt-2">
                                        <div id="table-container" class="scrollable-table table-wrapper">
                                            <!-- begin :: List RASCI Matrix Table -->
                                            <table class="table  custom-border-table rasci-matrix"
                                                style="table-layout: fixed;">
                                                <thead id="table-header">
                                                </thead>
                                                <tbody id="table-body">

                                                </tbody>
                                            </table>
                                            <!-- end :: List RASCI Matrix Table -->
                                        </div>
                                        <div id="loader">
                                            <div class="spinner"></div>
                                            <p class="loading-text">Loading Data...</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="pills-draft" role="tabpanel"
                                aria-labelledby="pills-draft-tab">
                                <div class="card-body" style="padding:15px 5px 15px 5px !important">
                                    <div class="row">
                                        <partial name="RasciDraft" />
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="pills-approval" role="tabpanel"
                                aria-labelledby="pills-approval-tab">
                                <div class="card-body" style="padding:15px 5px 15px 5px !important">
                                    <div class="row">
                                        <partial name="RasciApproval" />
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="pills-log-history" role="tabpanel"
                                aria-labelledby="pills-log-history-tab">
                                <div class="card-body" style="padding:15px 5px 15px 5px !important">
                                    <div class="row">
                                        <partial name="RasciHistory" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Container-fluid Ends-->
</div>

@section Script {
    <script>
        const token = localStorage.getItem("token");
        const url_api = "@Configuration["AppSettings:ApiUrl"]";
        console.log("url_api:", url_api);
        function handleCloseModal() {
            const applyButton = document.getElementById("apply-search");
            if (applyButton) {
                applyButton.disabled = true;
            }
        }

        $(document).ready(function () {
            $('#inputText').keyup(function () {
                if ($(this).val() == '') {
                    $('#searchButton').prop('disabled', true);
                } else {
                    $('#searchButton').prop('disabled', false);
                }
            });
        });

    </script>
    <!-- Plugins JS start-->
    <script src="../assets/js/sidebar-menu.js"></script>
    <script src="../assets/js/slick/slick.min.js"></script>
    <script src="../assets/js/slick/slick.js"></script>
    <script src="../assets/js/header-slick.js"></script>
    <script src="../assets/js/datepicker/date-picker/datepicker.js"></script>
    <script src="../assets/js/datepicker/date-picker/datepicker.en.js"></script>
    <script src="../assets/js/datepicker/date-picker/datepicker.custom.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bodymovin/5.7.4/lottie.min.js"></script>
    <script src="../assets/js/datatable/datatables/jquery.dataTables.min.js"></script>
    <script src="../assets/js/datatable/datatables/datatable.custom.js"></script>
    <script src="../assets/js/sweet-alert/sweetalert.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pako/2.1.0/pako.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/clusterize.js/0.18.0/clusterize.min.js"></script>
    <!-- Plugins JS Ends-->
    <!--Theme js-->
    <script src="../assets/js/script.js"></script>
    <script src="../assets/js/rasci-matrix/store.js"></script>
    <script src="../assets/js/rasci-matrix/endpoint.js"></script>
    <script src="../assets/js/rasci-matrix/index.js"></script>
    <script src="../assets/js/rasci-matrix/table-list.js"></script>
    <script src="../assets/js/rasci-matrix/event-scroll.js"></script>
    <script src="../assets/js/rasci-matrix/table-matrix.js"></script>
    <script src="../assets/js/rasci-matrix/job-compare.js"></script>
    <script src="../assets/js/rasci-matrix/detail-prosbis.js"></script>
    <script src="../assets/js/rasci-matrix/add-prosbis.js"></script>
    <script src="../assets/js/rasci-matrix/rasci-draft.js"></script>
    <script src="../assets/js/rasci-matrix/add-notation.js"></script>
    <script src="../assets/js/rasci-matrix/add-rascireference.js"></script>
    <script src="../assets/js/rasci-matrix/edit-businesspro.js"></script>
