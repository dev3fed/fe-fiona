    <script src="../assets/js/rasci-matrix/joblist-card.js"></script>
    <script src="../assets/js/rasci-matrix/filter-rasci.js"></script>
    <script src="../assets/js/rasci-matrix/activity-detaildraft.js"></script>
    <script src="../assets/js/rasci-matrix/add-activitynotation.js"></script>
    <script src="../assets/js/rasci-matrix/detail-job.js"></script>
    <script src="../assets/js/rasci-matrix/edit-notation.js"></script>
    <script src="../assets/js/rasci-matrix/table-loghistory.js"></script>
    <script src="../assets/js/rasci-matrix/table-approval.js"></script>
    <script src="../assets/js/rasci-matrix/detail-approval.js"></script>
    <script src="../assets/js/rasci-matrix/scroll-jobcard.js"></script>


