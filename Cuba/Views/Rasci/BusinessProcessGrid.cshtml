<style>
    /* Fullscreen mode styles */
    body.luckysheet-fullscreen-body-lock {
        overflow: hidden !important;
    }

    #luckysheet-business-process-card.luckysheet-fullscreen-active,
    #luckysheet-business-process-card.fortune-fullscreen-active {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
        bottom: 0 !important;
        width: 100vw !important;
        height: 100vh !important;
        max-width: 100vw !important;
        max-height: 100vh !important;
        z-index: 999999 !important;
        background: #ffffff !important;
        padding: 10px !important;
        margin: 0 !important;
        box-sizing: border-box !important;
    }

    #luckysheet-business-process-card.luckysheet-fullscreen-active .card,
    #luckysheet-business-process-card.fortune-fullscreen-active .card {
        height: 100% !important;
        width: 100% !important;
        max-height: 100% !important;
        max-width: 100% !important;
        display: flex !important;
        flex-direction: column !important;
        padding: 0 !important;
        margin: 0 !important;
        border: none !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        background: transparent !important;
    }

    #luckysheet-business-process-card.luckysheet-fullscreen-active .card-body,
    #luckysheet-business-process-card.fortune-fullscreen-active .card-body {
        height: 100% !important;
        width: 100% !important;
        max-height: 100% !important;
        max-width: 100% !important;
        display: flex !important;
        flex-direction: column !important;
        padding: 0 !important;
        margin: 0 !important;
        box-sizing: border-box !important;
        overflow: hidden !important;
    }

    #luckysheet-business-process-card.luckysheet-fullscreen-active .luckysheet-wrapper,
    #luckysheet-business-process-card.fortune-fullscreen-active .luckysheet-wrapper {
        position: relative !important;
        flex: 1 1 0% !important;
        height: 100% !important;
        width: 100% !important;
        min-height: 0 !important;
        max-height: none !important;
        margin: 0 !important;
        border-radius: 0 !important;
    }

    #luckysheet-business-process-card.luckysheet-fullscreen-active #luckysheet-business-process-container,
    #luckysheet-business-process-card.fortune-fullscreen-active #luckysheet-business-process-container,
    #luckysheet-business-process-card.luckysheet-fullscreen-active .fortune-workbook-container,
    #luckysheet-business-process-card.fortune-fullscreen-active .fortune-workbook-container,
    #luckysheet-business-process-card.luckysheet-fullscreen-active [class*="fortune-container"],
    #luckysheet-business-process-card.fortune-fullscreen-active [class*="fortune-container"] {
        position: absolute !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
        bottom: 0 !important;
        height: 100% !important;
        width: 100% !important;
    }

    /* Hide entire bottom sheetbar container, add sheet (+) button, and menu sheet (㗊) button */
    .fortune-sheet-area-bottom,
    .fortune-sheetbar,
    .fortune-sheets-bottom,
    #luckysheet-sheet-area,
    .luckysheet-sheet-area,
    [class*="sheet-area-bottom"],
    [class*="sheetbar"],
    .fortune-sheet-add,
    .fortune-sheet-tab-add,
    .fortune-sheet-sheets-add,
    .fortune-sheet-sheets-m,
    .fortune-sheet-sheets-item-add,
    #luckysheet-sheets-add,
    #fortune-sheet-sheets-add,
    #fortune-sheets-add,
    .fortune-sheets-add,
    .luckysheet-sheets-add,
    #luckysheet-sheets-m,
    #fortune-sheet-sheets-m,
    #fortune-sheets-m,
    .fortune-sheets-m,
    .luckysheet-sheets-m,
    .fortune-sheet-menu-icon,
    .fortune-sheet-all-sheet-btn,
    .fortune-sheet-list-btn,
    .fortune-sheet-add-btn,
    .fortune-sheet-add-icon,
    [class*="sheet-add"],
    [class*="sheets-add"],
    [class*="add-sheet"],
    [class*="sheets-m"],
    [class*="sheet-menu"],
    [class*="all-sheet"] {
        display: none !important;
        visibility: hidden !important;
        opacity: 0 !important;
        pointer-events: none !important;
        height: 0 !important;
        max-height: 0 !important;
        overflow: hidden !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    /* Hide insert image & insert link in cell right click context menu */
    .fortune-sheet-cols-menu-item[data-action="image"],
    .fortune-sheet-cols-menu-item[data-action="link"],
    .fortune-sheet-cols-menu-item[data-action="insertImage"],
    .fortune-sheet-cols-menu-item[data-action="insertLink"],
    .fortune-sheet-cols-menu-item[data-action="chart"],
    .fortune-context-menu-item[data-action="image"],
    .fortune-context-menu-item[data-action="link"],
    .fortune-context-menu-item[data-action="insertImage"],
    .fortune-context-menu-item[data-action="insertLink"],
    .fortune-sheet-rightclick-menu-item-image,
    .fortune-sheet-rightclick-menu-item-link,
    #luckysheet-rightclick-menu-item-image,
    #luckysheet-rightclick-menu-item-link,
    #luckysheet-rightclick-menu-item-insertImage,
    #luckysheet-rightclick-menu-item-insertLink,
    .luckysheet-cols-menu-item[data-action="image"],
    .luckysheet-cols-menu-item[data-action="link"] {
        display: none !important;
        visibility: hidden !important;
        height: 0 !important;
        max-height: 0 !important;
        margin: 0 !important;
        padding: 0 !important;
        overflow: hidden !important;
        border: none !important;
    }
</style>

<div class="col-12" id="luckysheet-business-process-card">
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body p-3">
            <div class="row align-items-center mb-3">
                <div class="col-md-4 col-12 d-flex align-items-center mb-2 mb-md-0">
                    <select class="form-select digits" id="dataSource-prosbis"
                            style="border-radius: 6px; height: 38px;">
                        <option value="master">Master data Prosbis</option>
                    </select>
                </div>
                <div class="col-md-8 col-12 d-flex justify-content-end align-items-center gap-2 flex-wrap">
                    <button id="btn-create-prosbis-draft"
                            class="btn btn-prosbis-light btn-sm d-flex align-items-center gap-1" data-bs-toggle="modal"
                            data-bs-target="#modalCreateDraft">
                        <i class="fa fa-plus"></i> Create Draft
                    </button>
                    <button id="btn-import-prosbis"
                            class="btn btn-prosbis-light btn-sm d-flex align-items-center gap-1">
                        <i class="fa fa-upload"></i> Import
                    </button>
                    <button id="btn-export-prosbis"
                            class="btn btn-prosbis-light btn-sm d-flex align-items-center gap-1">
                        <i class="fa fa-download"></i> Export
                    </button>
                    <button id="btn-save-prosbis-grid" class="btn btn-primary btn-sm d-flex align-items-center gap-1" type="button" style="white-space: nowrap;">
                        <div class="spinner-border spinner-border-sm text-light" style="display: none;" id="loadingSaveSheet" role="status"></div>
                        <span class="btn-text">Save Changes</span>
                    </button>
                    <button id="btn-fullscreen-prosbis-grid"
                            class="btn btn-prosbis-light btn-sm d-flex align-items-center gap-1" title="Toggle Fullscreen">
                        <i class="fa fa-expand" id="fullscreen-icon"></i> Fullscreen
                    </button>
                </div>
            </div>

            <div class="luckysheet-wrapper border rounded"
                 style="position: relative; width: 100%; height: 580px; overflow: hidden; overscroll-behavior: none;">
                <div id="luckysheet-business-process-container"
                     style="margin: 0px; padding: 0px; position: absolute; width: 100%; height: 100%; left: 0px; top: 0px; overscroll-behavior: none;">
                </div>
            </div>
        </div>
    </div>
</div>
