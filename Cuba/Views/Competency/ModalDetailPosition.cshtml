<!-- Include Animate.css -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    .modal-dialog.modal-detailpos {
        max-width: 80% !important;
        margin: 50px auto;
    }

    /* Custom scrollbar styles */
    .scrollable-posdetail {
        max-height: 460px;
        overflow-y: auto;
        padding-right: 10px;
    }

    .scrollable-posdetail::-webkit-scrollbar {
        width: 10px;
        height: 8px;
    }

    .scrollable-posdetail::-webkit-scrollbar-track {
        box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.3);
        border-radius: 10px;
    }

    .scrollable-posdetail::-webkit-scrollbar-thumb {
        background: #006ca9;
        border-radius: 10px;
    }

    .scrollable-posdetail::-webkit-scrollbar-thumb:hover {
        background: #006ca9;
    }

    .tbl-border {
        width: 100%;
        border-top: 1px solid #b0d1e4;
        border-right: 1px solid #b0d1e4;
        border-bottom: 1px solid #b0d1e4;
        border-left: 1px solid #b0d1e4;
        border-collapse: collapse;
        font-size: 12px !important;
    }

    .tbl-border th {
        color: #006CA9;
        font-weight: bold;
        height: 40px;
    }

    .tbl-border thead th {
        position: sticky;
        top: 0;
        background-color: #E6F0F6;
        z-index: 1;
        /* To ensure it stays above the content */
    }

    .tbl-border th,
    .tbl-border td {
        padding: 8px !important;
        border-right: 1px solid #b0d1e4;
        border-bottom: 1px solid #b0d1e4;
        border-left: 1px solid #b0d1e4;
    }

    th,
    td {
        vertical-align: middle;
    }

    .split-card-row {
        display: flex;
        border: 1px solid #dee2e6;
        border-radius: 5px;
        background-color: #fff;
        overflow: hidden;
        /* agar garis tengah nyambung rapi dengan border luar */
    }

    .split-card-row>div {
        flex: 1;
        padding: 10px;
    }

    .split-card-row>div:first-child {
        border-right: 1px solid #dee2e6;
    }
</style>


<div class="modal fade" id="ModalDetailPos" tabindex="-1" role="dialog" aria-labelledby="ModalDetailPosLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-detailpos bounceInDown animated" role="document">
        <div class="modal-content" style="border-radius: 8px;">
            <div class="modal-header">
                <h5 class="modal-title" id="ModalDetailPosTitle">Position Detail</h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div>
                    <h6 id="position-name">

                    </h6>
                    <ul class="nav nav-tabs nav-primary mt-3" id="pills-competency-tab" role="tablist">
                        <li class="nav-item"><a class="nav-link active" id="pills-competencyinfo-tab"
                                data-bs-toggle="pill" href="#pills-competencyinfo" role="tab"
                                aria-controls="pills-competencyinfo" aria-selected="true">Competency</a></li>
                        <li class="nav-item"><a class="nav-link" id="pills-jobinfo-tab" data-bs-toggle="pill"
                                href="#pills-jobinfo" role="tab" aria-controls="pills-jobinfo"
                                aria-selected="true">Position Info</a></li>
                        @* <li class="nav-item"><a class="nav-link" id="pills-mandatorycomp-tab" data-bs-toggle="pill"
                                href="#pills-mandatorycomp" role="tab" aria-controls="pills-mandatorycomp"
                                aria-selected="false">Mandatory Competency</a></li>
                        <li class="nav-item"><a class="nav-link" id="pills-technicalcomp-tab" data-bs-toggle="pill"
                                href="#pills-technicalcomp" role="tab" aria-controls="pills-technicalcomp"
                                aria-selected="false">Technical Competency</a></li>
                        <li class="nav-item"><a class="nav-link" id="pills-behaviorcomp-tab" data-bs-toggle="pill"
                                href="#pills-behaviorcomp" role="tab" aria-controls="pills-behaviorcomp"
                                aria-selected="false">Behavior Competency</a></li> *@
                    </ul>
                    <div class="tab-content" id="pills-businessContent">
                        <div class="tab-pane fade show active" id="pills-competencyinfo" role="tabpanel"
                            aria-labelledby="pills-competencyinfo-tab">
                            <div class="mt-3">
                                <!-- Card job attribut start-->
                                <div class="split-card-row ">
                                    <div>
                                        <div class="table-responsive m-t-6 scrollable-posdetail">
                                            <h6 id="labelMandatory"></h6>
                                            <table class="mt-2 mb-3 table tbl-border">
                                                <thead id="mandatory-competency-header">
                                                </thead>
                                                <tbody id="mandatory-competency-body">
                                                </tbody>
                                            </table>

                                            <h6 id="labelCore"></h6>
                                            <table class="table mb-3 tbl-border mt-2">
                                                <thead id="technical-competency-header">
                                                </thead>
                                                <tbody id="technical-competency-body">
                                                </tbody>
                                            </table>

                                            <h6 id="labelSpecific"> </h6>
                                            <table class="table mb-3 tbl-border mt-2">
                                                <thead id="technical-specifit-header">
                                                </thead>
                                                <tbody id="technical-specifit-body">
                                                </tbody>
                                            </table>

                                        </div>
                                    </div>
                                    <div>
                                        <div class="table-responsive m-t-6 scrollable-posdetail">
                                            <table class="mt-2 mb-3 table tbl-border">
                                                <h6>Behavior</h6>
                                                <thead id="mandatory-behavior-header">
                                                </thead>
                                                <tbody id="mandatory-behavior-body">
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <!-- Card job attribut end-->
                            </div>
                        </div>
                        <div class="tab-pane fade " id="pills-jobinfo" role="tabpanel"
                            aria-labelledby="pills-jobinfo-tab">
                            <div class="mt-1 scrollable-posdetail">
                                <!-- Card job attribut start-->
                                <div class="custom-card-draft">
                                    <div class="header-card-draft">
                                        Info
                                    </div>
                                    <div class="row" style="padding-top: 20px;" id="job-info">
                                    </div>
                                </div>
                                <!-- Card job attribut end-->

                                <!-- Card skill Group & subskill start-->
                                <div class="custom-card-draft">
                                    <div class="header-card-draft">
                                        Skill Group & Sub Skill Group
                                    </div>
                                    <div class="row" id="skill-group-content">

                                    </div>
                                </div>
                                <!-- Card skill Group & subskill end-->

                                <!-- Card Incumbent start-->
                                <div class="custom-card-draft">
                                    <div class="header-card-draft">
                                        Incumbent
                                    </div>
                                    <div class="row mt-4" id="incumbent-content">

                                    </div>
                                </div>
                                <!-- Card Incumbent end-->

                            </div>
                        </div>
                        @* <div class="tab-pane fade" id="pills-mandatorycomp" role="tabpanel"
                            aria-labelledby="pills-mandatorycomp-tab">
                            <div class="table-responsive m-t-15">
                                <table class="table tbl-border">
                                    <thead id="mandatory-competency-header">
                                    </thead>
                                    <tbody id="mandatory-competency-body">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="pills-technicalcomp" role="tabpanel"
                            aria-labelledby="pills-technicalcomp-tab">
                            <div class="table-responsive m-t-15">
                                <div class="d-flex justify-c    ontent-between align-items-center mb-2">
                                    <span>Technical Competency Total :
                                        <span id="technical-competency-total"></span>
                                    </span>
                                </div>
                                <table class="table tbl-border">
                                    <thead id="technical-competency-header">
                                    </thead>
                                    <tbody id="technical-competency-body">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="pills-behaviorcomp" role="tabpanel"
                            aria-labelledby="pills-behaviorcomp-tab">
                            <div class="m-t-15" id="behavior-competency-body">
                            </div>
                        </div> *@
                    </div>
                </div>
            </div>
            <div class="modal-footer  d-flex justify-content-end">
                <div>
                    <button class="btn btn-outline-light" type="button" data-bs-dismiss="modal"><i
                            class="icon-arrow-left"></i> Back</button>
                    <button class="btn btn-primary btn-icon" type="button" onclick="openSpecificCompetency()" disabled>
                        <img src="~/assets/images/rasci/plus.svg" alt="Filter Icon" />
                        Add Specific Competency
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>
