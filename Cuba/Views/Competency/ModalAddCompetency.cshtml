<!-- Include Animate.css -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    .modal-dialog.custom-competency {
        max-width: 85% !important;
        margin: 30px auto;
    }

    .tbl-border-competency {
        width: 100%;
        border-top: 1px solid #b0d1e4;
        border-right: 1px solid #b0d1e4;
        border-bottom: 1px solid #b0d1e4;
        border-left: 1px solid #b0d1e4;
        border-collapse: collapse;
        font-size: 12px !important;
    }

    .tbl-border-competency th {
        color: #006CA9;
        font-weight: bold;
        height: 40px;
    }

    .tbl-border-competency thead th {
        position: sticky;
        top: 0;
        background-color: #E6F0F6;
        z-index: 1;
        /* To ensure it stays above the content */
    }

    .tbl-border-competency th,
    .tbl-border-competency td {
        padding: 8px !important;
        border-right: 1px solid #b0d1e4;
        border-bottom: 1px solid #b0d1e4;
        border-left: 1px solid #b0d1e4;
    }

    .checkbox-label {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        margin: 0;
    }

    .checkbox_animated {
        width: 12px;
        height: 12px;
        transform: scale(0.8);
        margin-right: 5px;
    }

    .radio-label {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        margin: 0;
        text-align: center;
    }

    .radio_animated {
        margin-right: 5px;
    }

    th,
    td {
        vertical-align: middle;
        padding: 0;
    }

    .card-tblspesific {
        height: 400px;
        border: 1px solid #BFBFC2;
        border-radius: 4px;
        padding: 15px;
        margin-top: 5px
    }

    .card-tablebusinessreference {
        height: 370px;
        border: 1px solid #BFBFC2;
        border-radius: 4px;
        padding: 15px;
        margin-top: 5px
    }

    .card-listjob {
        height: auto;
        border: 1px solid #BFBFC2;
        border-radius: 4px;
        padding: 15px;
    }

    /* Custom scrollbar styles */
    .scrollable-competency::-webkit-scrollbar {
        width: 10px;
        height: 8px;
    }

    .scrollable-competency::-webkit-scrollbar-track {
        box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.3);
        border-radius: 10px;
    }

    .scrollable-competency::-webkit-scrollbar-thumb {
        background: #006ca9;
        border-radius: 10px;
    }

    .scrollable-competency::-webkit-scrollbar-thumb:hover {
        background: #006ca9;
    }

    .scrollable-competency {
        max-height: 620px;
        overflow-y: auto;
        margin-right: 5px;
        margin-top: 5px;
        margin-bottom: 5px
    }


    .scrollable-cardbusiness::-webkit-scrollbar {
        width: 10px;
        height: 8px;
    }

    .scrollable-cardbusiness::-webkit-scrollbar-track {
        box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.3);
        border-radius: 10px;
    }

    .scrollable-cardbusiness::-webkit-scrollbar-thumb {
        background: #006ca9;
        border-radius: 10px;
    }

    .scrollable-cardbusiness::-webkit-scrollbar-thumb:hover {
        background: #006ca9;
    }

    .scrollable-cardbusiness {
        max-height: 520px;
        overflow-y: auto;
    }

    .position-ref-item {
        padding: 8px;
        margin-bottom: 6px;
        border: 1px solid #ddd;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .position-ref-item:hover {
        background-color: #E9F5FF;
        border-color: #03A9F4;
    }

    .warning-alert {
        display: inline-block;
        padding: 4px;
        margin-right: 4px;
        border: solid 1px #D53C50;
        background-color: #FAE9EB;
        border-radius: 4px;
        width: auto;
        word-wrap: break-word;
        color: #D02138;
        font-size: 10px;
    }

    .circle-option {
        display: inline-block;
        width: 25px;
        height: 25px;
        border: 1.5px solid #006CA9;
        color: #006CA9;
        font-size: 12px;
        font-weight: 500;
        text-align: center;
        line-height: 24px;
        border-radius: 50%;
        cursor: pointer;
        transition: 0.2s;
        background-color: white;
    }

    .circle-option:hover,
    .btn-check:checked+.circle-option {
        background-color: #006CA9;
        color: white;
        border-color: #006CA9;
    }

    .oval-option {
        display: inline-block;
        padding: 3px 16px;
        font-size: 14px;
        border-radius: 999px;
        border: 1.5px solid #006CA9;
        color: #006CA9;
        font-weight: 500;
        cursor: pointer;
        transition: 0.2s;
        background-color: white;
    }

    .oval-option:hover,
    .btn-check:checked+.oval-option {
        background-color: #006CA9;
        color: white;
        border-color: #006CA9;
    }

    /* container baris horizontal */
    .option-row {
        display: flex;
        align-items: flex-start;
        flex-wrap: wrap;
    }

    .competency-box {
        background-color: #f0f0f0;
        border-radius: 4px;
        padding: 30px 10px;
        text-align: center;
        position: relative;
    }

    .competency-box .icon {
        font-size: 24px;
        color: #b0b0b0;
        display: block;
        margin-bottom: 6px;
    }

    .competency-box .desc {
        color: #999;
        font-size: 13px;
    }

    .compref-box {
        background-color: #f0f0f0;
        border-radius: 4px;
        padding: 30px 10px;
        text-align: center;
        position: relative;
    }

    .compref-box .icon {
        font-size: 24px;
        color: #b0b0b0;
        display: block;
        margin-bottom: 6px;
    }

    .compref-box .desc {
        color: #999;
        font-size: 13px;
    }

    /* Custom scrollbar styles */
    .scrollable-tbl::-webkit-scrollbar {
        width: 10px;
        height: 8px;
    }

    .scrollable-tbl::-webkit-scrollbar-track {
        box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.3);
        border-radius: 10px;
    }

    .scrollable-tbl::-webkit-scrollbar-thumb {
        background: #006ca9;
        border-radius: 10px;
    }

    .scrollable-tbl::-webkit-scrollbar-thumb:hover {
        background: #006ca9;
    }

    .scrollable-tbl {
        max-height: 120px;
        overflow-y: auto;
        padding-right: 6px;
    }

    .position-item-container {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 8px;
        overflow-y: auto;
    }

    .position-item {
        padding: 8px;
        border: 1px solid #ddd;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .position-item:hover {
        background-color: #E9F5FF;
        border-color: #03A9F4;
    }

    .position-item-title {
        font-weight: 600;
        color: #03A9F4;
        margin-bottom: 4px;
    }

    .position-item-code {
        font-size: 12px;
        color: #999;
    }
</style>


<div class="modal fade" id="modalAddCompetency" tabindex="-1" role="dialog" aria-labelledby="modalAddCompetencyLabel"
     aria-hidden="true">
    <div class="modal-dialog custom-competency bounceInDown animated" role="document">
        <div class="modal-content" style="border-radius: 8px;">
            <div class="modal-header">
                <h5 class="modal-title" id="modalAddCompetencyTitle">Add Technical Competency</h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"
                        onclick="closeModalCompetency()"></button>
            </div>
            <div class="modal-body scrollable-competency" id="modal-body-content">
                <div class="row">
                    <div class="col-12">
                        <div class="row" id="form-competency">

                        </div>
                    </div>
                    @* <div class="col-12" style="display: none;" id="comperef">

                    </div> *@
                    <div class="col-12" style="display: none;" id="card-positionlistref">
                        <div class="row g-2">
                            <div class="col-8">
                                <div class="card-tablebusinessreference">
                                    <div class="row g-2">
                                        <div class="col-6 " style="display: flex; flex-direction: column;">
                                            <div class="faq-form">
                                                <input class="form-control" type="text" placeholder="Search position"
                                                       id="search-position-ref" style="margin-bottom: 10px;"
                                                       oninput="searchPositionRef(this.value)">
                                            </div>
                                            <div id="default-position-ref" class="compref-box" style="flex: 1; display: flex; flex-direction: column; justify-content:
                                                center; align-items: center; text-align: center;">
                                                <span class="icon"><img
                                                    src="/assets/images/competency/magnifer.svg"></span>
                                                    <span class="desc">Search position to show data </span>
                                                </div>
                                                <div id="position-ref-list" class="scrollable-tbl"
                                                     style="display: none; max-height: 290px; flex-direction: column; gap: 8px; overflow-y: auto; padding-right: 6px; flex: 1;">

                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="compref-box " id="position-comperef-default"
                                                     style="height: 340px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center;">
                                                    <span class="icon"><img
                                                        src="/assets/images/competency/magnifer.svg"></span>
                                                        <span class="desc">Select position reference to show
                                                        </span>
                                                        <br />
                                                        <span class="desc" style="margin-top: -20px;">its specific
                                                            competencies</span>
                                                        </div>

                                                        <div id="position-comperef" style="display: none;">

                                                    
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="card-tablebusinessreference">
                                                <label class="form-label">Selected Specific Competencies</label>
                                                <div style="border-top: 1px solid #ddd; margin: 2px 0;"></div>
                                                <div id="selected-comperef">

                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                                <div class="col-6 mb-4" style="display: block;" id="specCompe">
                                    <label class="form-label">Choose Competencies</label>
                                    <div class="card-tblspesific">
                                        <div id="select-speccompe">
                                        </div>
                                        <div class="table-responsive  mt-2" style=" max-height: 360px;">
                                            <table class="table tbl-border-competency">
                                                <thead id="tbl-competency-header">
                                                </thead>
                                                <tbody id="tbl-competency-body">
                                                </tbody>
                                            </table>
                                        </div>
                                        <div class="d-flex mt-1 justify-content-end">
                                            <button class="btn btn btn-primary" type="button" id="btn-selectedCompe"
                                                    onclick="triggleSelectCompe()" disabled>
                                                Select Competency</button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6" style="display: block;" id="selectedcompe">
                                        <label class="form-label">Selected Technical Competencies</label>
                                        <div class="card-tblspesific " id="selected-compe">

                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer  d-flex justify-content-end">
                                <div>
                                    <button class="btn btn-outline-light" type="button" data-bs-dismiss="modal"
                                            onclick="closeModalCompetency()"><i class="icon-arrow-left"></i> Back</button>
                                    <button id="btnDraftcompetency" class="btn btn-primary" type="button"
                                            onclick="handleSaveDraftCompe()">
                                        <div class="d-flex align-items-center">
                                            <div class="spinner-border spinner-border-sm text-light me-2" style="display: none;"
                                                 id="spinBtncompetency" role="status"></div>
                                            <span class="btn-text"> Save</span>
                                        </div>
                                    </button>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
<!-- Bootstrap JS and Popper.js -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/js/bootstrap.min.js"></script>



