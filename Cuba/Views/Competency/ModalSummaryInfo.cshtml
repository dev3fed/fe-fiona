<!-- Include Animate.css -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    .modal-dialog.modal-detailpos {
        max-width: 80% !important;
        margin: 50px auto;
    }

    /* Custom scrollbar styles */
    .scrollable-posdetail {
        max-height: 460px;
        overflow-y: auto;
        padding-right: 10px;
    }

    .scrollable-posdetail::-webkit-scrollbar {
        width: 10px;
        height: 8px;
    }

    .scrollable-posdetail::-webkit-scrollbar-track {
        box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.3);
        border-radius: 10px;
    }

    .scrollable-posdetail::-webkit-scrollbar-thumb {
        background: #006ca9;
        border-radius: 10px;
    }

    .scrollable-posdetail::-webkit-scrollbar-thumb:hover {
        background: #006ca9;
    }

    .tbl-border {
        width: 100%;
        border-top: 1px solid #b0d1e4;
        border-right: 1px solid #b0d1e4;
        border-bottom: 1px solid #b0d1e4;
        border-left: 1px solid #b0d1e4;
        border-collapse: collapse;
        font-size: 12px !important;
    }

    .tbl-border th {
        color: #006CA9;
        font-weight: bold;
        height: 40px;
    }

    .tbl-border thead th {
        position: sticky;
        top: 0;
        background-color: #E6F0F6;
        z-index: 1;
        /* To ensure it stays above the content */
    }

    .tbl-border th,
    .tbl-border td {
        padding: 8px !important;
        border-right: 1px solid #b0d1e4;
        border-bottom: 1px solid #b0d1e4;
        border-left: 1px solid #b0d1e4;
    }

    th,
    td {
        vertical-align: middle;
    }

    .split-card-row {
        display: flex;
        border: 1px solid #dee2e6;
        border-radius: 5px;
        background-color: #fff;
        overflow: hidden;
        /* agar garis tengah nyambung rapi dengan border luar */
    }

    .split-card-row>div {
        flex: 1;
        padding: 10px;
    }

    .split-card-row>div:first-child {
        border-right: 1px solid #dee2e6;
    }
</style>


