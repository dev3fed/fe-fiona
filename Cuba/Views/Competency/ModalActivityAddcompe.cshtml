<!-- Include Animate.css -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    .modal-dialog.custom-competency {
        max-width: 80% !important;
        margin: 30px auto;
    }

    .tbl-border-competency {
        width: 100%;
        border-top: 1px solid #b0d1e4;
        border-right: 1px solid #b0d1e4;
        border-bottom: 1px solid #b0d1e4;
        border-left: 1px solid #b0d1e4;
        border-collapse: collapse;
        font-size: 12px !important;
    }

    .tbl-border-competency th {
        color: #006CA9;
        font-weight: bold;
        height: 40px;
    }

    .tbl-border-competency thead th {
        position: sticky;
        top: 0;
        background-color: #E6F0F6;
        z-index: 1;
        /* To ensure it stays above the content */
    }

    .tbl-border-competency th,
    .tbl-border-competency td {
        padding: 8px !important;
        border-right: 1px solid #b0d1e4;
        border-bottom: 1px solid #b0d1e4;
        border-left: 1px solid #b0d1e4;
    }

    .checkbox-label {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        margin: 0;
    }

    .checkbox_animated {
        width: 12px;
        height: 12px;
        transform: scale(0.8);
        margin-right: 5px;
    }

    .radio-label {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        margin: 0;
        text-align: center;
    }

    .radio_animated {
        margin-right: 5px;
    }

    th,
    td {
        vertical-align: middle;
        padding: 0;
    }

    .card-tblspesific {
        height: 520px;
        border: 1px solid #BFBFC2;
        border-radius: 4px;
        padding: 15px;
        margin-top: 5px
    }

    .card-tablebusinessreference {
        height: 420px;
        border: 1px solid #BFBFC2;
        border-radius: 4px;
        padding: 15px;
        margin-top: 5px
    }

    .card-listjob {
        height: auto;
        border: 1px solid #BFBFC2;
        border-radius: 4px;
        padding: 15px;
    }

    /* Custom scrollbar styles */
    .scrollable-competency::-webkit-scrollbar {
        width: 10px;
        height: 8px;
    }

    .scrollable-competency::-webkit-scrollbar-track {
        box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.3);
        border-radius: 10px;
    }

    .scrollable-competency::-webkit-scrollbar-thumb {
        background: #006ca9;
        border-radius: 10px;
    }

    .scrollable-competency::-webkit-scrollbar-thumb:hover {
        background: #006ca9;
    }

    .scrollable-competency {
        max-height: 620px;
        overflow-y: auto;
        margin-right: 5px;
        margin-top: 5px;
        margin-bottom: 5px
    }


    .scrollable-cardbusiness::-webkit-scrollbar {
        width: 10px;
        height: 8px;
    }

    .scrollable-cardbusiness::-webkit-scrollbar-track {
        box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.3);
        border-radius: 10px;
    }

    .scrollable-cardbusiness::-webkit-scrollbar-thumb {
        background: #006ca9;
        border-radius: 10px;
    }

    .scrollable-cardbusiness::-webkit-scrollbar-thumb:hover {
        background: #006ca9;
    }

    .scrollable-cardbusiness {
        max-height: 520px;
        overflow-y: auto;
    }

    .warning-alert {
        display: inline-block;
        padding: 4px;
        margin-right: 4px;
        border: solid 1px #D53C50;
        background-color: #FAE9EB;
        border-radius: 4px;
        width: auto;
        word-wrap: break-word;
        color: #D02138;
        font-size: 10px;
    }

    .circle-option {
        display: inline-block;
        width: 25px;
        height: 25px;
        border: 1.5px solid #006CA9;
        color: #006CA9;
        font-size: 12px;
        font-weight: 500;
        text-align: center;
        line-height: 24px;
        border-radius: 50%;
        cursor: pointer;
        transition: 0.2s;
        background-color: white;
    }

    .circle-option:hover,
    .btn-check:checked+.circle-option {
        background-color: #006CA9;
        color: white;
        border-color: #006CA9;
    }

    .oval-option {
        display: inline-block;
        padding: 3px 16px;
        font-size: 14px;
        border-radius: 999px;
        border: 1.5px solid #006CA9;
        color: #006CA9;
        font-weight: 500;
        cursor: pointer;
        transition: 0.2s;
        background-color: white;
    }

    .oval-option:hover,
    .btn-check:checked+.oval-option {
        background-color: #006CA9;
        color: white;
        border-color: #006CA9;
    }

    /* container baris horizontal */
    .option-row {
        display: flex;
        align-items: flex-start;
        flex-wrap: wrap;
    }

    .competency-box {
        background-color: #f0f0f0;
        border-radius: 4px;
        padding: 30px 10px;
        text-align: center;
        position: relative;
    }

    .competency-box .icon {
        font-size: 24px;
        color: #b0b0b0;
        display: block;
        margin-bottom: 6px;
    }

    .competency-box .desc {
        color: #999;
        font-size: 13px;
    }

    /* Custom scrollbar styles */
    .scrollable-tbl::-webkit-scrollbar {
        width: 10px;
        height: 8px;
    }

    .scrollable-tbl::-webkit-scrollbar-track {
        box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.3);
        border-radius: 10px;
    }

    .scrollable-tbl::-webkit-scrollbar-thumb {
        background: #006ca9;
        border-radius: 10px;
    }

    .scrollable-tbl::-webkit-scrollbar-thumb:hover {
        background: #006ca9;
    }

    .scrollable-tbl {
        max-height: 120px;
        overflow-y: auto;
        padding-right: 6px;
    }
</style>


<div class="modal fade" id="ModalActivityAddcompe" tabindex="-1" role="dialog"
    aria-labelledby="ModalActivityAddcompeLabel" aria-hidden="true">
    <div class="modal-dialog custom-competency bounceInDown animated" role="document">
        <div class="modal-content" style="border-radius: 8px;">
            <div class="modal-header">
                <h5 class="modal-title" id="ModalActivityAddcompeTitle">Add Specific Competency</h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body scrollable-competency" id="modal-activity-content">
                <div class="row">
                    <div class="col-12">
                        <div class="row" id="form-activity-competency">

                        </div>
                    </div>
                    <div class="col-12" style="display: none;" id="activity-comperef">

                    </div>
                    <div class="col-12" style="display: none;margin-top:15px" id="activitycomperef">

                    </div>
                    @* <div class="col-6" style="display: none;" id="selectedBisproref">

                    </div> *@
                    <div class="col-6 mb-4" style="display: block;" id="activitySpeccompe">
                        <label class="form-label">Core & Specific Competencies</label>
                        <div class="card-tblspesific">
                            <div id="select-activitySpeccompe">
                            </div>
                            <div class="table-responsive  mt-2" style=" max-height: 450px;">
                                <table class="table tbl-border-competency">
                                    <thead id="tbl-activitycompetency-header">
                                    </thead>
                                    <tbody id="tbl-activitycompetency-body">
                                    </tbody>
                                </table>
                            </div>
                            <div class="d-flex mt-1 justify-content-end">
                                <button class="btn btn btn-primary" type="button" id="btn-activitySelectedCompe"
                                    onclick="triggleSelectActivityCompe()" disabled>
                                    Select Competency</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-6" style="display: block;" id="activitySelectedcompe">
                        <label class="form-label">Selected Technical Competencies</label>
                        <div class="card-tblspesific" id="selected-activitycompe">

                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer  d-flex justify-content-end">
                <div>
                    <button class="btn btn-outline-light" type="button" data-bs-dismiss="modal"
                        onclick="closeModalActivityCompetency()">
                        <i class="icon-arrow-left"></i> Back</button>
                    <button id="btnActivitycompetency" class="btn btn-primary" type="button"
                        onclick="handleSaveDraftActivityCompe()">
                        <div class="d-flex align-items-center">
                            <div class="spinner-border spinner-border-sm text-light me-2" style="display: none;"
                                id="spinBtnactivitycompetency" role="status"></div>
                            <span class="btn-text"> Save Change</span>
                        </div>
                    </button>
                </div>

            </div>
        </div>
    </div>
</div>
<!-- Bootstrap JS and Popper.js -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/js/bootstrap.min.js"></script>