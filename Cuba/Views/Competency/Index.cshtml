<link rel="stylesheet" type="text/css" href="~/assets/css/competency.css">
<link href="~/assets/css/clusterize.css" rel="stylesheet">

<style>
    #draft-detail {
        display: none;
    }

    #header-detail-draft {
        display: none;
    }

    #header-detail-approval {
        display: none;
    }

    #approval-detail {
        display: none;
    }

    #main-competency {
        display: block;
    }

    #header-competency {
        display: block;
    }

    #dictionary-page {
        display: none;
    }

    #header-dictionarypage {
        display: none;
    }

    .empty-bodycompetency {
        background-color: #EAEAEB;
        height: 400px;
        background-image: url("/assets/images/competency/empty_competency.svg");
        background-position: center 150px;
        background-repeat: no-repeat;
        background-size: 180px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        padding-top: 235px;
    }

    #table-competency {
        display: none;
    }

    #empty-competency {
        display: block;
    }

    /* Custom scrollbar styles */
    .scrollable-card {
        max-height: 560px;
        overflow-y: auto;
        overflow-x: hidden;
        padding-right: 10px;
    }

    .scrollable-card::-webkit-scrollbar {
        width: 10px;
        height: 8px;
    }

    .scrollable-card::-webkit-scrollbar-track {
        box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.3);
        border-radius: 10px;
    }

    .scrollable-card::-webkit-scrollbar-thumb {
        background: #006ca9;
        border-radius: 10px;
    }

    .scrollable-card::-webkit-scrollbar-thumb:hover {
        background: #006ca9;
    }
</style>
