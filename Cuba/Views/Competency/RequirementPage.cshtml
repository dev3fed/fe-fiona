<style>
    .tbl-border-summary {
        width: 100%;
        border-top: 1px solid #b0d1e4;
        border-right: 1px solid #b0d1e4;
        border-bottom: 1px solid #b0d1e4;
        border-left: 1px solid #b0d1e4;
        border-collapse: collapse;
        font-size: 12px !important;
    }

    .tbl-border-summary th {
        color: #006CA9;
        font-weight: bold;
        height: 40px;
    }

    .tbl-border-summary thead th {
        position: sticky;
        top: 0;
        background-color: #E6F0F6;
        z-index: 1;
        /* To ensure it stays above the content */
    }

    .tbl-border-summary th,
    .tbl-border-summary td {
        padding: 8px !important;
        border-right: 1px solid #b0d1e4;
        border-bottom: 1px solid #b0d1e4;
        border-left: 1px solid #b0d1e4;
    }

    th,
    td {
        vertical-align: middle;
        padding: 0;
    }
</style>
<div class="col-12">
    <div class="row">
        <div class="col-4">
            <span class="mt-2 mb-2" style="min-width: 130px;">Competency Data Source</span>
            <div class="faq-form">
                <select class="form-select digits" id="dataSource-summary">
                    <option value="master">Master data KKJ</option>

                </select>
            </div>
        </div>
        <div class="col-4">
            <span class="mt-2 mb-2" style="min-width: 130px;">Search</span>
            <div class="faq-form">
                <div class="btn-group w-100" role="group" aria-label="Button group with nested dropdown">
                    <div class="btn-group" role="group">
                        <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown"
                                id="searchTypeSummary" aria-haspopup="true" aria-expanded="false">Position</button>
                        <div class="dropdown-menu" aria-labelledby="btnSearchType">
                            <a class="dropdown-item" onclick="selectTypePosition('Position')"
                               value="position">Position</a>
                            <a class="dropdown-item" onclick="selectTypePosition('Division')"
                               value="Division">Division</a>
                            <a class="dropdown-item" onclick="selectTypePosition('Department')"
                               value="Department">Department</a>
                        </div>
                    </div>
                    <input class="form-control" type="text" placeholder="Search" id="inputSearchSummary"
                           style="border-top-left-radius: 0; border-bottom-left-radius: 0;">
                </div>
            </div>
        </div>
        <div class="col-2">
            <span class="mt-2 mb-2" style="min-width: 130px;">KKJ Status</span>
            <div class="faq-form">
                <select class="form-select" aria-label="Default select example" id="status-summary">
                    <option value="all">All Status</option>
                    <option value="available">Available</option>
                    <option value="not available">Not available</option>
                    <option value="waiting approval">Waiting approval</option>
                    <option value="on progress">On progress</option>
                </select>
            </div>
        </div>
        <div class="col-2">
            <span class="mt-2 mb-2" style="min-width: 130px; visibility: hidden;">Action</span>
            <div class="faq-form d-flex align-items-center" style="gap:8px; margin-top:0;">
                <button id="btnSearchCompe" class="btn btn-primary d-flex align-items-center" type="button"
                        onclick="triggerSearchSummary()">
                    <div class="spinner-border spinner-border-sm text-light me-2" style="display: none;"
                         id="loadingSearchSummary"></div>
                    <span class="btn-text">Search</span>
                </button>
                <button class="btn btn-outline-primary d-flex align-items-center" type="button" id="clearButton"
                        onclick="clearSearchSummary()">
                    <div class="spinner-border spinner-border-sm text-primary me-2" style="display: none;"
                         id="loadingClearSummary"></div>
                    <span class="btn-text">Clear</span>
                </button>
            </div>
        </div>
        <div class="col-12 ">
            <div style="
                display: none;
                white-space: nowrap;
                background: #FAE9EB;
                border: 1px solid #D02138;
                margin-top:12px;
                border-radius: 4px;
                padding: 6px 18px;
                color: #D02138;
                font-size: 12px;
                box-sizing: border-box;
                margin-bottom: 12px;
                " id="warning-list">
                
            </div>
            <div class="table-responsive" style=" max-height: 350px; margin-top: 10px;" id="table-summary">
                <table class="table tbl-border-summary">
                    <thead id="tbl-summary-header" style="background-color: #006CA9;">
                        <tr>
                            <th scope="col" style="width: 50px;text-align:center">
                                No
                            </th>
                            <th scope="col" style="width: 280px;">Position</th>
                            <th scope="col" style="width: 280px;">Function</th>
                            <th scope="col" style="width: 280px;">Division</th>
                            <th scope="col" style="width: 100px;text-align:center">Status</th>
                            <th scope="col" style="width: auto; text-align: center;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="body-summary">
                    </tbody>
                </table>
            </div>
        </div>
        <div class="col-9 mt-3">
            <div id="total-summary-page">
            </div>
        </div>
        <div class="col-3 mt-3 d-flex justify-content-end">
            <div id="list-summary-page">
            </div>
        </div>
    </div>
</div>