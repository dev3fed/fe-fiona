<style>
    .custom-card-draft {
        height: auto;
        border: 1px solid #BFBFC2;
        border-radius: 4px;
        padding: 20px 10px 10px 15px;
        margin-top: 20px;
        position: relative;
    }

    .header-card-draft {
        background-color: #F5F5F5;
        height: 35px;
        padding-left: 15px;
        display: flex;
        align-items: center;
        font-weight: 700;
        position: absolute;
        top: -5px;
        left: 0;
        right: 0;
        border-radius: 4px 4px 0 0;
        border: 1px solid #BFBFC2;
        border-bottom: none;
        width: calc(100% + 2px);
        font-size: 14px;
        margin-left: -1px;
    }

    .custom-col {
        border-right: 1px solid #BFBFC2;
        padding-right: 10px;
        text-align: center;
    }

    .custom-col:last-child {
        border-right: none;
    }

    .custom-col label {
        display: block;
        font-size: 12px;
        margin-bottom: 5px;
    }

    .custom-row-full {
        border-top: 1px solid #BFBFC2;
        padding-right: 10px;
        padding-top: 10px;
        text-align: left;

    }

    .custom-row-full label {
        display: block;
        font-size: 12px;
        margin-top: 10px;
    }

    .btn-outline-light:hover img {
        filter: brightness(0) invert(1);
    }

    .btn-small-icon {
        padding: 2px 5px;
        font-size: 12px;
    }

    .btn-small-icon img {
        font-size: 10px;
    }

    .btn-rounded {
        border-radius: 26px;
        margin: 5px;
    }

    .icon-svg {
        stroke: #000;
        /* Warna default stroke */
        transition: stroke 0.3s ease;
        /* Transisi untuk efek halus */
    }

    .btn:hover .icon-svg {
        stroke: #fffff;
        /* Warna stroke tetap saat tombol di-hover */
    }

    .long-text {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        overflow: hidden;
        text-overflow: ellipsis;
        -webkit-box-orient: vertical;
        white-space: normal;
        flex: 1;
    }

    .empty-activity-body {
        background-color: #EAEAEB;
        height: 300px;
        background-image: url("/assets/images/competency/empty_draftkkj.svg");
        background-position: center 60px;
        background-repeat: no-repeat;
        background-size: 300px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        padding-top: 200px;
        margin-top: 25px;
        border-radius: 7px;
    }
</style>

<div class="card" style="border-radius:8px">
    <div style="padding:15px">
        <h6 class="f-w-600">Draft Detail</h6>
        <!-- Card info start-->
        <div class="custom-card-draft">
            <div class="header-card-draft">
                Info
            </div>
            <div class="row" style="padding-top: 20px;" id="draft-competencyinfo">
            </div>
        </div>
        <!-- Card info end-->

        <!-- Card detail start-->
        <div class="custom-card-draft">
            <div class="header-card-draft">
                Detail
            </div>
            <div id="empty-activity">

            </div>
            <div class="row" style="padding-top: 20px;" id="draftactivity-competency">
            </div>
        </div>
        <div id="warning-draft-competency" style="display: none;">

        </div>
        <!-- Card detail end-->

        <!-- card footer start-->
        <div class="text-end mt-4 mb-2">
            <button class="btn btn-outline-light" type="button" onclick="handleBack()">
                <i class="icon-arrow-left"></i> Back
            </button>
            <button class="btn btn-outline-danger" type="button" onclick="deleteDetailDraft()">
                <i class="icon-trash" style="font-size: 1em;"></i> Delete Draft
            </button>
            @* <button class=" btn btn-outline-light" type="button" onclick="triggleEditCompetency()">
                <img src="~/assets/images/rasci/pen_outline.svg" alt="Filter Icon" style="margin-right: 8px;">Edit Draft
            </button> *@
            <button class="btn btn-primary" type="button" onclick="openDetailApproval()" id="detail-draft-submitted">
                Submit to Approval<i class="icon-arrow-right" style="font-size: 0.8em; margin-left: 5px;"></i> </button>
        </div>
        <!-- card footer end-->
    </div>
</div>