<!-- Include Animate.css -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    .modal-dialog.custom-width {
        max-width: 95%;
        margin: 30px auto;
    }

    .modal-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .btn-outline-light .icon-arrow-left {
        font-size: 12px;
        margin-right: 8px;
    }

    .reset-label {
        color: #D02138;
        cursor: pointer;
    }

    .job-card-scroll-container {
        display: flex;
        flex-wrap: nowrap;
        overflow-x: auto;
        gap: 12px;
        padding-bottom: 10px;
        margin-top: 15px;
    }

    .custom-card-wrapper {
        flex: 0 0 250px;
    }

    .custom-card {
        height: 300px;
        border: 1px solid #BFBFC2;
        border-radius: 4px;
        padding: 10px;
        margin-top: 10px
    }

    .custom-card-Bottom {
        height: 45px;
        border: 1px solid #BFBFC2;
        border-radius: 4px;
        padding: 10px;
        margin-top: 10px
    }

    .card-scrollable {
        max-height: 220px;
        overflow-y: auto;
        padding-right: 10px;
    }

    /* Scrollbar styling */
    .job-card-scroll-container::-webkit-scrollbar {
        height: 8px;
    }

    .job-card-scroll-container::-webkit-scrollbar-thumb {
        background-color: #006ca9;
        border-radius: 4px;
    }

    .card-scrollable::-webkit-scrollbar {
        width: 8px;
    }

    .card-scrollable::-webkit-scrollbar-track {
        box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.3);
        border-radius: 10px;
    }

    .card-scrollable::-webkit-scrollbar-thumb {
        background-color: #006ca9;
        border-radius: 4px;
    }

    .scrollable {
        max-height: 220px;
        overflow-y: auto;
        padding-right: 10px;
    }

    .scrollable::-webkit-scrollbar {
        width: 10px;
        height: 8px;
    }

    .scrollable::-webkit-scrollbar-track {
        box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.3);
        border-radius: 10px;
    }

    .scrollable::-webkit-scrollbar-thumb {
        background: #006ca9;
        border-radius: 10px;
    }

    .scrollable::-webkit-scrollbar-thumb:hover {
        background: #006ca9;
    }

    .tooltip-inner {
        background-color: #ffffff !important;
        color: #000000;
        border: 1px solid #cccccc;
    }

    .spinner-border {
        height: 16px;
        width: 16px;
    }

    .level-scroll-container {
        display: flex;
        flex-wrap: nowrap;
        overflow-x: auto;
        gap: 12px;
        padding-bottom: 10px;
        margin-top: 15px;
    }

    .level-column {
        flex: 0 0 250px;
    }

    .switch-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }

    .level-scroll-container::-webkit-scrollbar {
        height: 8px;
    }

    .level-scroll-container::-webkit-scrollbar-track {
        box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.3);
        border-radius: 10px;
    }

    .level-scroll-container::-webkit-scrollbar-thumb {
        background-color: #006ca9;
        border-radius: 4px;
    }

    .label-ellipsis {
        max-width: 150px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

