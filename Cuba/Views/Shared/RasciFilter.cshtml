<style>
    .modal-dialog.custom-width {
        max-width: 95%;
        margin: 30px auto;
    }

    .modal-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .btn-outline-light .icon-arrow-left {
        font-size: 12px;
        margin-right: 8px;
    }

    .reset-label {
        color: #D02138;
        cursor: pointer;
    }

    .custom-card {
        height: 300px;
        border: 1px solid #BFBFC2;
        border-radius: 4px;
        padding: 10px;
        margin-top: 10px
    }

    .scrollable {
        max-height: 200px;
        overflow-y: auto;
        padding-right: 10px;
    }

    /* Custom scrollbar styles */
    .scrollable::-webkit-scrollbar {
        width: 10px;
    }

    .scrollable::-webkit-scrollbar-track {
    @*box-shadow:inset005pxgrey;*@border-radius: 10px;
    }

    .scrollable::-webkit-scrollbar-thumb {
        background: #DEDEE0;
        border-radius: 10px;
    }

    .scrollable::-webkit-scrollbar-thumb:hover {
        background: #DEDEE0;
    }
</style>

