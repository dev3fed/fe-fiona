<!-- Include Animate.css -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    .modal-dialog.modal-deletedraft {
        max-width: 25%;
        margin: 190px auto;
    }

    .modal-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .spinner-border {
        height: 16px;
        width: 16px;
    }
</style>

<div class="modal fade" id="modalDeleteActivitydraft" tabindex="-1" role="dialog"
    aria-labelledby="modalDeleteActivitydraftLabel" aria-hidden="true">
    <div class="modal-dialog modal-deletedraft bounceInDown  animated" role="document">
        <div class="modal-content" style="border-radius: 8px;">
            <div class="modal-header">
                <h5 class="modal-title" id="modalDeleteActivitydraftLabel"><img
                        src="~/assets/images/rasci/red_trush.svg" alt="Filter Icon"
                        style="margin-right: 8px;margin-top:-10px">Delete Data</h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12" id="contentInformation">

                    </div>
                </div>
            </div>
            <div class="modal-footer  d-flex justify-content-end">
                <div>
                    <button class="btn btn-outline-light" type="button" data-bs-dismiss="modal"> Back</button>
                    <button class="btn btn-primary" type="button" onclick="deleteActivitydraft()">
                        <div class="d-flex align-items-center">
                            <div class="spinner-border spinner-border-sm text-light me-2" style="display: none;"
                                id="btnDeleteActivitydraft" role="status"></div>
                            <span class="btn-text">Delete</span>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Bootstrap JS and Popper.js -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/js/bootstrap.min.js"></script>
