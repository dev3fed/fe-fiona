<!-- Include Animate.css -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<div class="modal fade" id="modalAskAi" tabindex="-1" role="dialog" aria-labelledby="modalAskAiLabel" aria-hidden="true">
    <div class="modal-dialog custom-modal-search bounceInDown animated" role="document">
        <div class="modal-content" style="border-radius: 8px;">
            <div class="modal-header d-flex align-items-center justify-content-between">
                <h5 class="modal-title" id="modalAskAiLabel">
                    <img src="~/assets/images/rasci/icon_filter.svg" alt="Fiona Icon" style="width: 18px; margin-right: 8px; filter: invert(34%) sepia(85%) saturate(1900%) hue-rotate(186deg) brightness(92%) contrast(101%);"> Ask Fiona
                </h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="modalAskAiBody">
                <div class="mb-3">
                    <label for="askAiInput" class="form-label font-weight-bold">Pertanyaan / Kata Kunci Fiona</label>
                    <div class="input-group">
                        <input type="text" id="askAiInput" class="form-control" placeholder="Contoh: tanyakan ke Fiona tentang proses pengadaan lahan..." onkeypress="handleAskAiKeyPress(event)">
                        <button class="btn btn-primary" type="button" id="btnSubmitAskAi" onclick="submitAskAiPrompt()">
                            <div class="d-flex align-items-center">
                                <div class="spinner-border spinner-border-sm text-light me-2" style="display: none;" id="spinnerAskAi" role="status"></div>
                                <span id="textSubmitAskAi">Ask Fiona</span>
                            </div>
                        </button>
                    </div>
                </div>

                <div id="askAiResultsContainer" style="display: none;" class="mt-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label id="askAiResultLabel" class="fw-bold text-secondary mb-0"></label>
                        <div class="form-check me-2">
                            <input class="checkbox_animated" type="checkbox" id="chkSelectAllAskAi" checked onchange="toggleSelectAllAskAi(event)">
                            <label class="form-check-label small ms-1" for="chkSelectAllAskAi">Pilih Semua</label>
                        </div>
                    </div>
                    <div class="table-responsive scrollable-tbl-search" style="max-height: 350px;">
                        <table class="table tbl-border">
                            <thead style="background-color: #006CA9;">
                                <tr>
                                    <th scope="col" style="width: 50px; text-align: center;">Pilih</th>
                                    <th scope="col" style="width: 55px;">Level</th>
                                    <th scope="col" style="width: 75px;">Index</th>
                                    <th scope="col">Proses Bisnis</th>
                                    <th scope="col">Alasan Fiona (Reasoning)</th>
                                </tr>
                            </thead>
                            <tbody id="tblAskAiBody">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-end">
                <div>
                    <button class="btn btn-outline-light me-2" type="button" data-bs-dismiss="modal">
                        <i class="icon-arrow-left"></i> Batal
                    </button>
                    <button id="btnApplyAskAi" class="btn btn-primary" type="button" disabled onclick="applyAskAiToMatrix()">
                        <div class="d-flex align-items-center">
                            <div class="spinner-border spinner-border-sm text-light me-2" style="display: none;" id="spinnerApplyAskAi" role="status"></div>
                            <span class="btn-text">
                                <img src="~/assets/images/rasci/incon_success.svg" alt="Success Icon" style="margin-right: 8px;"> Terapkan ke Matrix
                            </span>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
