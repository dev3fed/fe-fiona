<!-- Include Animate.css -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<div class="modal fade" id="modalAskAi" tabindex="-1" role="dialog" aria-labelledby="modalAskAiLabel" aria-hidden="true">
    <div class="modal-dialog bounceInDown animated" role="document" style="max-width: calc(100vw - 32px); width: calc(100vw - 32px); height: calc(100vh - 32px); margin: 16px auto;">
        <div class="modal-content" style="border-radius: 12px; height: 100%; display: flex; flex-direction: column;">
            <div class="modal-header d-flex align-items-center justify-content-between">
                <h5 class="modal-title" id="modalAskAiLabel">
                    <img src="~/assets/images/icon_AI_blue.svg" alt="Fiona Icon" style="width: 18px; margin-right: 8px; margin-top: -2px;"> Ask Fiona
                </h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex flex-column flex-grow-1" id="modalAskAiBody" style="overflow-y: auto;">
                <div class="mb-3">
                    <label for="askAiInput" class="form-label font-weight-bold">Pertanyaan / Kata Kunci Fiona</label>
                    <div class="input-group">
                        <input type="text" id="askAiInput" class="form-control" placeholder="Contoh: tanyakan ke Fiona tentang proses pengadaan lahan..." onkeypress="handleAskAiKeyPress(event)">
                        <button class="btn btn-primary" type="button" id="btnSubmitAskAi" onclick="submitAskAiPrompt()">
                            <div class="d-flex align-items-center">
                                <div class="spinner-border spinner-border-sm text-light me-2" style="display: none;" id="spinnerAskAi" role="status"></div>
                                <span id="textSubmitAskAi">Ask Fiona</span>
                            </div>
                        </button>
                    </div>
                    <div class="mt-2 d-flex flex-wrap align-items-center gap-1">
                        <span class="text-muted small me-1" style="font-size: 12px;">Rekomendasi:</span>
                        <button type="button" class="btn btn-outline-primary btn-xs py-1 px-2 me-1 rounded-pill" style="font-size: 11px;" onclick="fillAskAiPrompt('Pengadaan barang dan jasa')">Pengadaan barang & jasa</button>
                        <button type="button" class="btn btn-outline-primary btn-xs py-1 px-2 me-1 rounded-pill" style="font-size: 11px;" onclick="fillAskAiPrompt('Manajemen risiko operasional')">Mitigasi Risiko</button>
                        <button type="button" class="btn btn-outline-primary btn-xs py-1 px-2 me-1 rounded-pill" style="font-size: 11px;" onclick="fillAskAiPrompt('Persetujuan anggaran holding')">Persetujuan Anggaran</button>
                        <button type="button" class="btn btn-outline-primary btn-xs py-1 px-2 me-1 rounded-pill" style="font-size: 11px;" onclick="fillAskAiPrompt('Keselamatan kerja K3LL')">K3LL & Keselamatan</button>
                    </div>
                </div>

                <div id="askAiResultsContainer" style="display: none;" class="mt-3 flex-grow-1 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label id="askAiResultLabel" class="fw-bold text-secondary mb-0"></label>
                        <div class="form-check me-2">
                            <input class="checkbox_animated" type="checkbox" id="chkSelectAllAskAi" checked onchange="toggleSelectAllAskAi(event)">
                            <label class="form-check-label small ms-1" for="chkSelectAllAskAi">Pilih Semua</label>
                        </div>
                    </div>
                    <div class="table-responsive scrollable-tbl-search flex-grow-1" style="max-height: calc(100vh - 340px); min-height: 250px;">
                        <table class="table tbl-border">
                            <thead style="background-color: #006CA9;">
                                <tr>
                                    <th scope="col" style="width: 50px; text-align: center;">Pilih</th>
                                    <th scope="col" style="width: 55px;">Level</th>
                                    <th scope="col" style="width: 75px;">Index</th>
                                    <th scope="col">Proses Bisnis</th>
                                    <th scope="col">Alasan Fiona (Reasoning)</th>
                                </tr>
                            </thead>
                            <tbody id="tblAskAiBody">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-end">
                <div>
                    <button class="btn btn-outline-light me-2" type="button" data-bs-dismiss="modal">
                        <i class="icon-arrow-left"></i> Batal
                    </button>
                    <button id="btnApplyAskAi" class="btn btn-primary" type="button" disabled onclick="applyAskAiToMatrix()">
                        <div class="d-flex align-items-center">
                            <div class="spinner-border spinner-border-sm text-light me-2" style="display: none;" id="spinnerApplyAskAi" role="status"></div>
                            <span class="btn-text">
                                <img src="~/assets/images/rasci/incon_success.svg" alt="Success Icon" style="margin-right: 8px;"> Terapkan ke Matrix
                            </span>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
