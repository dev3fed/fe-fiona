<div class="modal fade" id="modalSmartCompareResult" tabindex="-1" role="dialog" aria-labelledby="modalSmartCompareResultLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl custom-modal-search bounceInDown animated" role="document">
        <div class="modal-content" style="border-radius: 8px;">
            <div class="modal-header d-flex align-items-center justify-content-between" style="background-color: #006CA9; color: #ffffff;">
                <h5 class="modal-title text-white" id="modalSmartCompareResultLabel">
                    <img src="~/assets/images/rasci/icon_filter.svg" alt="Fiona" style="width: 20px; margin-right: 8px; filter: brightness(0) invert(1);"> Smart Position Compare - Analisis Fiona AI
                </h5>
                <button class="btn-close btn-close-white" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalSmartCompareResultBody">
                
                <!-- Executive Summary Banner -->
                <div class="alert alert-primary bg-light-primary text-primary border-primary p-3 rounded mb-4" role="alert">
                    <div class="d-flex align-items-start">
                        <i class="icofont icofont-brainstorm fs-3 me-3 mt-1 text-primary"></i>
                        <div>
                            <h6 class="alert-heading fw-bold mb-1">Executive Summary Fiona AI</h6>
                            <p class="mb-0 small" id="smartCompareExecSummary">Memuat analisis perbandingan posisi...</p>
                        </div>
                    </div>
                </div>

                <!-- Side-by-side Workload Metric Cards -->
                <h6 class="fw-bold mb-3 text-secondary"><i class="icofont icofont-chart-histogram me-2"></i>Perbandingan Beban Notasi RASCI</h6>
                <div class="row g-3 mb-4" id="smartCompareMetricsRow">
                    <!-- Dynamic metrics cards inserted via JS -->
                </div>

                <!-- Workload Balance & Recommendation Section -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm p-3 bg-light rounded h-100">
                            <h6 class="fw-bold text-dark mb-2"><i class="icofont icofont-balance-scale me-2 text-warning"></i>Keseimbangan Beban Kerja</h6>
                            <p class="mb-0 small text-muted" id="smartCompareWorkloadBalance">-</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm p-3 bg-light rounded h-100">
                            <h6 class="fw-bold text-dark mb-2"><i class="icofont icofont-bulb me-2 text-success"></i>Rekomendasi Distribusi Wewenang</h6>
                            <p class="mb-0 small text-muted" id="smartCompareRecommendation">-</p>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer d-flex justify-content-between">
                <span class="text-muted small" id="smartCompareSharedCountInfo">Terdapat 0 proses bisnis bersama</span>
                <div>
                    <button class="btn btn-outline-light me-2 text-dark" type="button" data-bs-dismiss="modal">Tutup</button>
                    <button id="btnFilterSharedMatrix" class="btn btn-primary" type="button" onclick="filterSharedProcessesToMatrix()">
                        <i class="icofont icofont-filter me-1"></i> Filter Matrix ke Prosbis Bersama
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
