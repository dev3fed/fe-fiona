<!-- Include Animate.css -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    .modal-dialog.modal-compare {
        max-width: 55%;
        margin: 30px auto;
    }

    .modal-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .btn-outline-light .icon-arrow-left {
        font-size: 12px;
        margin-right: 8px;
    }

    .reset-label-compare {
        color: #9F9FA5;
    }

    .custom-card {
        height: 300px;
        border: 1px solid #BFBFC2;
        border-radius: 4px;
        padding: 10px;
        margin-top: 10px
    }

    .custom-card-Bottom {
        height: 45px;
        border: 1px solid #BFBFC2;
        border-radius: 4px;
        padding: 10px;
        margin-top: 10px
    }

    .scrollable {
        max-height: 220px;
        overflow-y: auto;
        padding-right: 10px;
    }

    .scrollable::-webkit-scrollbar {
        width: 10px;
        height: 8px;
    }

    .scrollable::-webkit-scrollbar-track {
        box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.3);
        border-radius: 10px;
    }

    .scrollable::-webkit-scrollbar-thumb {
        background: #006ca9;
        border-radius: 10px;
    }

    .scrollable::-webkit-scrollbar-thumb:hover {
        background: #006ca9;
    }

    .tooltip-inner {
        background-color: #ffffff !important;
        color: #000000;
        border: 1px solid #cccccc;
    }

    .row-item {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
    }

    .column-checkbox {
        flex: 0 0 10px;
        margin-right: 10px;
    }

    .column-item-name {
        @* flex: 1; *@
        padding-right: 5px;
        word-wrap: break-word;
    }

    .remove-item {
        cursor: pointer;
        transition: color 0.3s ease;
        color: red;
        margin-top: 5px;
    }
</style>

<div class="modal fade" id="modalJobCompare" tabindex="-1" role="dialog" aria-labelledby="modalJobCompareLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-compare bounceInDown  animated" role="document">
        <div class="modal-content" style="border-radius: 8px;">
            <div class="modal-header">
                <h5 class="modal-title" id="modalJobCompareLabel">Position Compare</h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <div class="row">
                    <div class="col-6">
                        <div class="media">
                            <div class="media-body switch-sm d-flex align-items-center justify-content-between w-100">
                                <div class="d-flex align-items-center">
                                    <label class="col-form-label mb-0"
                                        style="margin-top: -4px; margin-left: 5px;">Search & Select Position</label>
                                </div>
                                <label class="reset-label-compare mb-0">Choose minimum 2 positions</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="media">
                            <div class="media-body switch-sm d-flex align-items-center justify-content-between w-100">
                                <div class="d-flex align-items-center">
                                    <label class="col-form-label mb-0"
                                        style="margin-top: -4px; margin-left: 5px;">Selected Position</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-6">
                        <div class="custom-card">
                            <input class="form-control" type="text" placeholder="Search" id="inputSearchCompare"
                                oninput="searchJobCompare(event)">
                            <div class="animate-chk mt-3 scrollable">
                                <div id="chk-job-list"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="custom-card">
                            <div class="mt-3 scrollable">
                                <div id="job-selected-list"></div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer  d-flex justify-content-end">
                <div>
                    <button class="btn btn-outline-light" type="button" data-bs-dismiss="modal"
                        onclick="handleCloseModal()"><i class="icon-arrow-left"></i> Back</button>
                    <button id="apply-compare-ai" class="btn btn-info text-white me-2" type="button" onclick="applySmartCompareAi()" disabled>
                        <div class="d-flex align-items-center">
                            <div class="spinner-border spinner-border-sm text-light me-2" style="display: none;" id="spinnerCompareAi" role="status"></div>
                            <span class="btn-text"><img src="~/assets/images/rasci/icon_filter.svg" alt="Fiona Icon" style="width: 16px; margin-right: 6px; filter: brightness(0) invert(1);"> Analisis Fiona AI</span>
                        </div>
                    </button>
                    <button id="apply-compare" class="btn btn-primary" type="button" onclick="applyCompare()" disabled>
                        <div class="d-flex align-items-center">
                            <div class="spinner-border spinner-border-sm text-light me-2" style="display: none;"
                                id="applyCompare" role="status"></div>
                            <span class="btn-text">  <img src="~/assets/images/rasci/incon_success.svg" alt="Filter Icon" style="margin-right: 8px;">Apply Compare</span>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Bootstrap JS and Popper.js -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/js/bootstrap.min.js"></script>
