<!-- Include Animate.css -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    .modal-dialog.custom-modal-search {
        max-width: 55% !important;
        margin: 30px auto;
    }

    .tbl-border {
        border-right: 1px solid #b0d1e4;
        border-bottom: 1px solid #b0d1e4;
        border-left: 1px solid #b0d1e4;
        border-collapse: collapse;
        font-size: 12px !important;
    }

    .tbl-border th {
        color: #FFFFFF;
        height: 40px;
    }

    .tbl-border thead th {
        position: sticky;
        top: 0;
        background-color: #006CA9;
        z-index: 1;
        /* To ensure it stays above the content */
    }

    .tbl-border th,
    .tbl-border td {
        padding: 8px !important;
        border-right: 1px solid #b0d1e4;
        border-bottom: 1px solid #b0d1e4;
        border-left: 1px solid #b0d1e4;
    }

    .checkbox-label {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        margin: 0;
    }

    .checkbox_animated {
        width: 12px;
        height: 12px;
        transform: scale(0.8);
        margin-right: 5px;
    }

    .radio-label {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        margin: 0;
        text-align: center;
    }

    .radio_animated {
        margin-right: 5px;
    }

    th,
    td {
        vertical-align: middle;
        padding: 0;
    }

    /* Custom scrollbar styles */
    .scrollable-tbl-search {
        overflow-y: auto;
    }

    .scrollable-tbl-search::-webkit-scrollbar {
        width: 10px;
        height: 8px;
    }

    .scrollable-tbl-search::-webkit-scrollbar-track {
        box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.3);
        border-radius: 10px;
    }

    .scrollable-tbl-search::-webkit-scrollbar-thumb {
        background: #006ca9;
        border-radius: 10px;
    }

    .scrollable-tbl-search::-webkit-scrollbar-thumb:hover {
        background: #006ca9;
    }

    .scrollable-tbl-search {
        max-height: 220px;
        overflow-y: auto;
        padding-right: 6px;
    }
</style>

<div class="modal fade" id="modalSearch" tabindex="-1" role="dialog" aria-labelledby="modalSearchLabel"
    aria-hidden="true">
    <div class="modal-dialog custom-modal-search bounceInDown animated" role="document">
        <div class="modal-content" style="border-radius: 8px;">
            <div class="modal-header">
                <h5 class="modal-title" id="modalSearchTitle"></h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="modalBodyContent">
                <div>
                    <label id="searchLabel" />
                </div>
                <div class="table-responsive scrollable-tbl-search" style=" max-height: 450px;">
                    <table class="table tbl-border">
                        <thead id="tbl-search-header" style="background-color: #006CA9;">
                        </thead>
                        <tbody id="tbl-search-body">
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer  d-flex justify-content-end">
                <div>
                    <button class="btn btn-outline-light" type="button" data-bs-dismiss="modal"
                        onclick="handleCloseModal()"><i class="icon-arrow-left"></i>
                        Back</button>
                    <button class="btn btn-primary" type="button" data-bs-dismiss="modal" id="apply-search" disabled>
                        <img src="~/assets/images/rasci/incon_success.svg" alt="Filter Icon" style="margin-right: 8px;">
                        Apply
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Bootstrap JS and Popper.js -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/js/bootstrap.min.js"></script>
