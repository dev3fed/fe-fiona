<!-- Include Animate.css -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    .modal-dialog.modal-save-draft {
        max-width: 35%;
        margin: 190px auto;
    }

    .modal-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
</style>

<div class="modal fade" id="modalSaveDraft" tabindex="-1" role="dialog" aria-labelledby="modalSaveDraftLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-save-draft bounceInDown  animated" role="document">
        <div class="modal-content" style="border-radius: 8px;">
            <div class="modal-header">
                <h5 class="modal-title" id="modalSaveDraftLabel"><img src="~/assets/images/rasci/warning_icon.svg"
                        alt="Filter Icon" style="margin-right: 8px;margin-top:-5px">Save as Draft</h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal" data-bs-target="#modalSaveDraft"
                    aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <div class="mb-3">
                            <label class="form-label">Draft Name</label>
                            <input class="form-control" type="text" placeholder="Input draft name" id="draftName"
                                oninput="handleInputDraftName(this.value)">
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer  d-flex justify-content-end">
                <div>
                    <button class="btn btn-outline-light" type="button" data-bs-dismiss="modal"
                        data-bs-target="#modalSaveDraft"> Back</button>
                    <button class="btn btn-primary" type="button" id="prosbisSavedraft" onclick="saveAsDraft()"
                        disabled>
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Bootstrap JS and Popper.js -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/js/bootstrap.min.js"></script>
