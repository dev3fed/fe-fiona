<!-- Include Animate.css -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    .modal-dialog.detail-editbp {
        max-width: 50% !important;
        margin: 80px auto;
    }
</style>


<div class="modal fade" id="ModalDetaileditbp" tabindex="-1" role="dialog" aria-labelledby="ModalDetaileditbpLabel"
    aria-hidden="true">
    <div class="modal-dialog detail-editbp bounceInDown animated" role="document">
        <div class="modal-content" style="border-radius: 8px;">
            <div class="modal-header">
                <h5 class="modal-title" id="ModalDetaileditbpTitle">Edit Business Process Activity Detail</h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-4" id="detail-editbp">

                </div>
            </div>
            <div class="modal-footer  d-flex justify-content-end">
                <div>
                    <button class="btn btn-outline-light" type="button" onclick="closeModaleditbp()"><i
                            class="icon-arrow-left"></i> Back</button>
                    <button id="deleteBpActivity" class="btn btn-outline-danger" type="button">
                        <i class="icon-trash" style="font-size: 1em;"></i> Delete Draft
                    </button>
                    <button id="editBpactivity" class=" btn btn-outline-light" type="button"
                        onclick="triggleEditBpActivity()">
                        <i class="icon-marker-alt"></i>
                        Edit
                    </button>
                    <button id="cancelEditBp" class="btn btn-outline-light d-none" type="button"
                        onclick="handleCancelEditbp()">Cancel Edit</button>
                    <button id="saveBpactivity" class="btn btn-primary d-none" type="button">
                        <div class="d-flex align-items-center">
                            <div class="spinner-border spinner-border-sm text-light me-2" style="display: none;"
                                id="loadingBpactivity" role="status"></div>
                            <span class="btn-text"> Save Change</span>
                        </div>
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>
