<!-- Include Animate.css -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    .modal-dialog.delete-bp {
        max-width: 35% !important;
        margin: 80px auto;
    }
</style>


<div class="modal fade" id="modalDeleteBp" tabindex="-1" role="dialog" aria-labelledby="modalDeleteBpLabel"
    aria-hidden="true">
    <div class="modal-dialog delete-bp bounceInDown animated" role="document">
        <div class="modal-content" style="border-radius: 8px;">
            <div class="modal-header">
                <h5 class="modal-title" id="modalDeleteBpTitle"><img src="~/assets/images/rasci/red_trush.svg"
                        alt="Filter Icon" style="margin-right: 8px;margin-top:-10px">Delete Business Process</h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="modal-body-content">
                <div class="row mb-4" id="form-deletebp">

                </div>
            </div>
            <div class="modal-footer  d-flex justify-content-end">
                <div>
                    <button class="btn btn-outline-light" type="button" data-bs-dismiss="modal"><i
                            class="icon-arrow-left"></i> Back</button>
                    <button id="applyFilterBtn" class="btn btn-primary" type="button" onclick="handleSaveDeletebp()">
                        <div class="d-flex align-items-center">
                            <div class="spinner-border spinner-border-sm text-light me-2" style="display: none;"
                                id="loadingDeletebp" role="status"></div>
                            <span class="btn-text"> Yes, Delete</span>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
