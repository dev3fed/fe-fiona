<!-- Include Animate.css -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    .modal-dialog.modal-formchoose {
        max-width: 35%;
        margin: 120px auto;
    }

    .modal-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .btn-outline-light .icon-arrow-left {
        font-size: 12px;
        margin-right: 8px;
    }

    .reset-label-compare {
        color: #9F9FA5;
    }

    .custom-card {
        height: 300px;
        border: 1px solid #BFBFC2;
        border-radius: 4px;
        padding: 10px;
        margin-top: 10px
    }

    .custom-card-Bottom {
        height: 45px;
        border: 1px solid #BFBFC2;
        border-radius: 4px;
        padding: 10px;
        margin-top: 10px
    }

    .scrollable {
        max-height: 220px;
        overflow-y: auto;
        padding-right: 10px;
    }

    .scrollable::-webkit-scrollbar {
        width: 10px;
        height: 8px;
    }

    .scrollable::-webkit-scrollbar-track {
        box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.3);
        border-radius: 10px;
    }

    .scrollable::-webkit-scrollbar-thumb {
        background: #006ca9;
        border-radius: 10px;
    }

    .scrollable::-webkit-scrollbar-thumb:hover {
        background: #006ca9;
    }

    .tooltip-inner {
        background-color: #ffffff !important;
        color: #000000;
        border: 1px solid #cccccc;
    }

    .row-item {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
    }

    .column-checkbox {
        flex: 0 0 10px;
        margin-right: 10px;
    }

    .column-item-name {
        flex: 1;
        word-wrap: break-word;
    }

    .remove-item {
        cursor: pointer;
        transition: color 0.3s ease;
        color: red;
        margin-top: 5px;
    }

    .spinner-border {
        height: 16px;
        width: 16px;
    }
</style>

<div class="modal fade" id="modalChoosedraft" tabindex="-1" role="dialog" aria-labelledby="modalChoosedraftLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-formchoose bounceInDown  animated" role="document">
        <div class="modal-content" style="border-radius: 8px;">
            <div class="modal-header">
                <h5 class="modal-title" id="modalChoosedraftTitle">Choose RASCI Matrix Draft</h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="body-choosedraft">

            </div>
            <div class="modal-footer  d-flex justify-content-end">
                <div>
                    <button class="btn btn-outline-light" type="button" data-bs-dismiss="modal"><i
                            class="icon-arrow-left"></i> Back</button>
                    <button id="applyFilterBtn" class="btn btn-primary" type="button" onclick="handleContinue()">
                        <div class="d-flex align-items-center">
                            <div class="spinner-border spinner-border-sm text-light me-2" style="display: none;"
                                id="loadingChoose" role="status"></div>
                            <span class="btn-text">Continue</span>
                        </div>
                    </button>

                </div>
            </div>
        </div>
    </div>
</div>
<!-- Bootstrap JS and Popper.js -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/js/bootstrap.min.js"></script>
