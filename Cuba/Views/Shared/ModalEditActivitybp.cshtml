<!-- Include Animate.css -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    .modal-dialog.custom-bp {
        max-width: 70% !important;
        margin: 30px auto;
    }

    .tbl-border-add-prosbis {
        width: 100%;
        border-top: 1px solid #b0d1e4;
        border-right: 1px solid #b0d1e4;
        border-bottom: 1px solid #b0d1e4;
        border-left: 1px solid #b0d1e4;
        border-collapse: collapse;
        font-size: 12px !important;
    }

    .tbl-border-add-prosbis th {
        color: #006CA9;
        font-weight: bold;
        height: 40px;
    }

    .tbl-border-add-prosbis thead th {
        position: sticky;
        top: 0;
        background-color: #E6F0F6;
        z-index: 1;
        /* To ensure it stays above the content */
    }

    .tbl-border-add-prosbis th,
    .tbl-border-add-prosbis td {
        padding: 8px !important;
        border-right: 1px solid #b0d1e4;
        border-bottom: 1px solid #b0d1e4;
        border-left: 1px solid #b0d1e4;
    }

    .checkbox-label {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        margin: 0;
    }

    .checkbox_animated {
        width: 12px;
        height: 12px;
        transform: scale(0.8);
        margin-right: 5px;
    }

    .radio-label {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        margin: 0;
        text-align: center;
    }

    .radio_animated {
        margin-right: 5px;
    }

    th,
    td {
        vertical-align: middle;
        padding: 0;
    }

    .card-tbljob {
        height: 420px;
        border: 1px solid #BFBFC2;
        border-radius: 4px;
        padding: 10px;
        margin-top: 5px
    }

    .card-listjob {
        height: auto;
        border: 1px solid #BFBFC2;
        border-radius: 4px;
        padding: 15px;
    }

    /* Custom scrollbar styles */
    .scrollable-addbusiness::-webkit-scrollbar {
        width: 10px;
        height: 8px;
    }

    .scrollable-addbusiness::-webkit-scrollbar-track {
        box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.3);
        border-radius: 10px;
    }

    .scrollable-addbusiness::-webkit-scrollbar-thumb {
        background: #006ca9;
        border-radius: 10px;
    }

    .scrollable-addbusiness::-webkit-scrollbar-thumb:hover {
        background: #006ca9;
    }

    .scrollable-addbusiness {
        max-height: 620px;
        overflow-y: auto;
        margin-right: 5px;
        margin-top: 5px;
        margin-bottom: 5px
    }


    .scrollable-cardjoblist::-webkit-scrollbar {
        width: 10px;
        height: 8px;
    }

    .scrollable-cardjoblist::-webkit-scrollbar-track {
        box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.3);
        border-radius: 10px;
    }

    .scrollable-cardjoblist::-webkit-scrollbar-thumb {
        background: #006ca9;
        border-radius: 10px;
    }

    .scrollable-cardjoblist::-webkit-scrollbar-thumb:hover {
        background: #006ca9;
    }

    .scrollable-cardjoblist {
        max-height: 520px;
        overflow-y: auto;
    }
</style>


<div class="modal fade" id="ModalEditActivitybp" tabindex="-1" role="dialog" aria-labelledby="ModalEditActivitybpLabel"
    aria-hidden="true">
    <div class="modal-dialog custom-bp bounceInDown animated" role="document">
        <div class="modal-content" style="border-radius: 8px;">
            <div class="modal-header">
                <h5 class="modal-title" id="ModalEditActivitybpTitle">Edit Data</h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body scrollable-addbusiness" id="modal-body-content">
                <div class="row">
                    <div class="col-12">
                        <div class="row" id="form-edit-content">

                        </div>
                    </div>
                    <div class="col-6">
                        <label class="form-label mt-3">Job</label>
                        <div class="card-tbljob">
                            <div id="select-job">
                            </div>
                            <div class="table-responsive mt-2" style=" max-height: 450px;">
                                <table class="table tbl-border-edit-bp">
                                    <thead id="tbl-edit-bp-header">
                                    </thead>
                                    <tbody id="tbl-edit-bp-body">
                                    </tbody>
                                </table>
                            </div>
                            <div class="d-flex mt-2 justify-content-end">
                                <button class="btn btn btn-primary" type="button">
                                    Selected
                                    Job</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <label class="form-label mt-3">Selected Job</label>
                        <div class="card-tbljob scrollable-cardjoblist" id="selected-edit-job">

                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer  d-flex justify-content-end">
                <div>
                    <button class="btn btn-outline-light" type="button" data-bs-dismiss="modal"><i
                            class="icon-arrow-left"></i> Back</button>
                    <button id="applyFilterBtn" class="btn btn-primary" type="button">
                        <div class="d-flex align-items-center">
                            <div class="spinner-border spinner-border-sm text-light me-2" style="display: none;"
                                id="saveDraftBtn" role="status"></div>
                            <span class="btn-text"> Save</span>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Bootstrap JS and Popper.js -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/js/bootstrap.min.js"></script>
