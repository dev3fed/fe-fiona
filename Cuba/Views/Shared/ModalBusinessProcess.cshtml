<!-- Include Animate.css -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    .modal-dialog.custom-modal-detail {
        max-width: 80% !important;
        margin: 50px auto;
    }

    .icon-small {
        font-size: 10px;
    }

    .tbl-border {
        width: 100%;
        border-top: 1px solid #b0d1e4;
        border-right: 1px solid #b0d1e4;
        border-bottom: 1px solid #b0d1e4;
        border-left: 1px solid #b0d1e4;
        border-collapse: collapse;
        font-size: 12px !important;
    }

    .tbl-border th {
        color: #006CA9;
        font-weight: bold;
        height: 40px;
    }

    .tbl-border thead th {
        position: sticky;
        top: 0;
        background-color: #E6F0F6;
        z-index: 1;
        /* To ensure it stays above the content */
    }

    .tbl-border th,
    .tbl-border td {
        padding: 8px !important;
        border-right: 1px solid #b0d1e4;
        border-bottom: 1px solid #b0d1e4;
        border-left: 1px solid #b0d1e4;
    }

    th,
    td {
        vertical-align: middle;
    }
</style>

<div class="modal fade" id="modalBusinessPro" tabindex="-1" role="dialog" aria-labelledby="modalBusinessProLabel"
    aria-hidden="true">
    <div class="modal-dialog custom-modal-detail bounceInDown animated" role="document">
        <div class="modal-content" style="border-radius: 8px;">
            <div class="modal-header">
                <h5 class="modal-title">Business Process Detail</h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="modalBodyContent">
                <div class="mb-2" id="prosbis-title">

                </div>
                <div>
                    <ul class="nav nav-tabs nav-primary" id="pills-business-tab" role="tablist">
                        <li class="nav-item"><a class="nav-link active" id="pills-related-tab" data-bs-toggle="pill"
                                href="#pills-related" role="tab" aria-controls="pills-related"
                                aria-selected="true">Related Job</a></li>
                        <li class="nav-item"><a class="nav-link" id="pills-hierarchy-tab" data-bs-toggle="pill"
                                href="#pills-hierarchy" role="tab" aria-controls="pills-hierarchy"
                                aria-selected="false">Business Process Hierarchy</a></li>
                        <li class="nav-item"><a class="nav-link" id="pills-competencies-tab" data-bs-toggle="pill"
                                href="#pills-competencies" role="tab" aria-controls="pills-competencies"
                                aria-selected="false">Competencies</a></li>
                    </ul>
                    <div class="tab-content" id="pills-businessContent">
                        <div class="tab-pane fade show active" id="pills-related" role="tabpanel"
                            aria-labelledby="pills-related-tab">
                            <div class="mb-0 m-t-10" id="total-job">
                            </div>
                            <div class="table-responsive scrollable" style=" max-height: 300px;">
                                <table class="table tbl-border ">
                                    <thead id="prosbis-details-header">
                                    </thead>
                                    <tbody id="prosbis-details-body">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="pills-hierarchy" role="tabpanel"
                            aria-labelledby="pills-hierarchy-tab">
                            <div class="table-responsive m-t-15">
                                <table class="table tbl-border rasci-matrix">
                                    <thead id="prosbis-hierarchy-header">
                                    </thead>
                                    <tbody id="prosbis-hierarchy-body">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="pills-competencies" role="tabpanel"
                            aria-labelledby="pills-competencies-tab">
                            <div class="table-responsive m-t-15">
                                <table class="table tbl-border">
                                    <thead id="prosbis-competencies-header">
                                    </thead>
                                    <tbody id="prosbis-competencies-body">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer ">
                <button class="btn btn-outline-light" type="button" data-bs-dismiss="modal">
                    <i class="icon-arrow-left"></i> Back
                </button>
                <div>
                    <button class="btn btn-outline-danger" type="button" onclick="handleDetailDeletebp()"><i
                            class="icon-trash"></i>
                        Delete</button>
                    <button class="btn btn-outline-light" type="button" onclick="handleDetailEditbp()">
                        <i class="icon-marker-alt"></i>
                        Edit
                    </button>
                    <button class="btn btn-primary" type="button" onclick="openSeiesOfProcess()">
                        Series of Process
                        <i class="icon-arrow-right icon-small"></i>
                    </button>
                    <button class="btn btn-primary" type="button" data-bs-dismiss="modal">
                        Show RASCI
                        <i class="icon-arrow-right icon-small"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Bootstrap JS and Popper.js -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/js/bootstrap.min.js"></script>
