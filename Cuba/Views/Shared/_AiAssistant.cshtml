@inject IConfiguration Configuration
<button type="button" id="fionaAiLauncher" class="fiona-ai-launcher" aria-label="Open Fiona AI assistant" title="Ask Fiona">
    <img src="~/assets/images/icon_AI.svg" alt="" />
    <span>Ask Fiona</span>
</button>
<aside id="fionaAiPanel" class="fiona-ai-panel is-empty" aria-label="Fiona AI assistant" aria-hidden="true"
       data-api-url="@Configuration["AppSettings:ApiUrl"]">
    <!-- Left Sidebar: Chat History -->
    <div id="fionaAiSidebar" class="fiona-ai-sidebar" aria-label="Riwayat Percakapan">
        <div class="fiona-ai-sidebar-header">
            <span class="fiona-ai-sidebar-title">Riwayat Obrolan</span>
            <button type="button" id="fionaAiHistoryNew" class="fiona-ai-history-new" aria-label="Percakapan baru" title="Percakapan baru">＋ Obrolan Baru</button>
        </div>
        <div class="fiona-ai-history-search-wrap">
            <input id="fionaAiHistorySearch" type="search" maxlength="200" autocomplete="off" placeholder="Cari percakapan..." aria-label="Cari percakapan" />
        </div>
        <div id="fionaAiHistoryLoading" class="fiona-ai-history-loading" hidden>
            <span class="fiona-ai-activity-spinner" aria-hidden="true"></span>
            <span>Memuat riwayat...</span>
        </div>
        <div id="fionaAiHistoryList" class="fiona-ai-history-list" aria-live="polite" aria-busy="false"></div>
        <div id="fionaAiHistoryEmpty" class="fiona-ai-history-empty" hidden>
            <strong>Belum ada percakapan</strong>
            <p>Riwayat obrolan Anda sebelumnya akan muncul di sini.</p>
        </div>
    </div>

    <!-- Right Main Pane: Active Chat / Memories -->
    <div id="fionaAiMain" class="fiona-ai-main">
        <header class="fiona-ai-header">
            <div class="fiona-ai-header-info">
                <button type="button" id="fionaAiToggleSidebar" class="fiona-ai-toggle-sidebar" aria-label="Buka/tutup riwayat" title="Buka/tutup riwayat">☰</button>
                <div>
                    <strong>Fiona AI</strong>
                    <small id="fionaAiContext">Asisten Matriks RASCI</small>
                </div>
            </div>
            <div class="fiona-ai-header-actions">
                <button type="button" id="fionaAiMemories" aria-label="Buka memori Fiona" title="Memori">Memori</button>
                <button type="button" id="fionaAiNew" aria-label="Percakapan baru" title="Percakapan baru">＋</button>
                <button type="button" id="fionaAiClose" aria-label="Tutup asisten">×</button>
            </div>
        </header>
        <div id="fionaAiModelPicker" class="fiona-ai-model-picker" aria-live="polite">
            <label for="fionaAiModelSelect">Model</label>
            <select id="fionaAiModelSelect" disabled aria-describedby="fionaAiModelHelp">
                <option value="">Memuat model…</option>
            </select>
            <span id="fionaAiModelHelp" class="fiona-ai-model-help" role="status">Memuat model…</span>
            <button type="button" id="fionaAiModelRetry" class="fiona-ai-model-retry" hidden>Coba lagi</button>
        </div>
        <section id="fionaAiMemoryPanel" class="fiona-ai-memory-panel" hidden aria-labelledby="fionaAiMemoryTitle">
            <div class="fiona-ai-memory-toolbar">
                <button type="button" id="fionaAiMemoryBack" class="fiona-ai-memory-back">← <span>Kembali ke obrolan</span></button>
                <button type="button" id="fionaAiMemoryRefresh" class="fiona-ai-memory-refresh" aria-label="Segarkan memori" title="Segarkan memori">↻</button>
            </div>
            <div class="fiona-ai-memory-heading">
                <span class="fiona-ai-empty-eyebrow">FIONA AI · MEMORI</span>
                <h2 id="fionaAiMemoryTitle">Memori Anda</h2>
                <p>Memori khusus pengguna ini membantu Fiona memberikan jawaban yang sesuai preferensi Anda.</p>
            </div>
            <div class="fiona-ai-memory-filters" aria-label="Filter memori">
                <label>
                    <span>Cari memori</span>
                    <input id="fionaAiMemorySearch" type="search" maxlength="200" autocomplete="off" placeholder="Cari preferensi atau memori" />
                </label>
                <label>
                    <span>Cakupan</span>
                    <select id="fionaAiMemoryScope">
                        <option value="">Semua cakupan</option>
                        <option value="user">Global</option>
                        <option value="source">Domain/sumber</option>
                    </select>
                </label>
                <label>
                    <span>Domain</span>
                    <select id="fionaAiMemoryDomain">
                        <option value="">Semua domain</option>
                        <option value="organization">Organisasi</option>
                        <option value="rasci">RASCI</option>
                        <option value="jobdesc">Deskripsi Jabatan</option>
                        <option value="competency">Kompetensi</option>
                    </select>
                </label>
            </div>
            <div id="fionaAiMemoryStatus" class="fiona-ai-memory-status" role="status" aria-live="polite" hidden></div>
            <div id="fionaAiMemoryList" class="fiona-ai-memory-list" aria-live="polite" aria-busy="false"></div>
            <div id="fionaAiMemoryEmpty" class="fiona-ai-memory-empty" hidden>
                <strong>Belum ada memori tersimpan</strong>
                <p>Fiona belum menyimpan preferensi untuk Anda. Anda dapat menambahkan preferensi umum atau memori domain.</p>
            </div>
            <button type="button" id="fionaAiMemoryAdd" class="fiona-ai-memory-add">＋ Tambah memori</button>
        </section>
        <div id="fionaAiUnavailable" class="fiona-ai-unavailable" hidden>
            <strong>Fiona sedang mempelajari halaman ini.</strong>
            <span>Asisten Fiona saat ini tersedia pada halaman Matriks RASCI.</span>
        </div>
        <div id="fionaAiMessages" class="fiona-ai-messages" role="log" aria-live="polite"></div>
        <section id="fionaAiEmptyState" class="fiona-ai-empty-state" aria-labelledby="fionaAiWelcomeTitle">
            <span class="fiona-ai-empty-eyebrow">FIONA AI · RASCI MATRIX</span>
            <h2 id="fionaAiWelcomeTitle">Apa yang ingin Anda ketahui?</h2>
            <p>Ajukan pertanyaan untuk meninjau peran, tanggung jawab, dan keterkaitan proses bisnis.</p>
            <div class="fiona-ai-suggestions" aria-label="Saran pertanyaan">
                <button type="button" data-prompt="Siapa yang bertanggung jawab untuk proses bisnis ini?">Siapa yang bertanggung jawab?</button>
                <button type="button" data-prompt="Tampilkan peran RASCI untuk unit yang dipilih.">Tampilkan peran RASCI unit ini</button>
                <button type="button" data-prompt="Ringkas temuan penting dari RASCI matrix ini.">Ringkas temuan penting</button>
            </div>
        </section>
        <div id="fionaAiStatus" class="fiona-ai-status" hidden></div>
        <div id="fionaAiCacheStatus" class="fiona-ai-cache-status" role="status" aria-live="polite" aria-busy="false" hidden></div>
        <div id="fionaAiComposerArea" class="fiona-ai-composer-area">
            <div id="fionaAiMentionPopup" class="fiona-ai-mention-popup" hidden role="listbox" aria-label="Mention entities">
                <div class="fiona-ai-mention-header">
                    <span class="fiona-ai-mention-header-badge is-position">Jabatan (@@)</span>
                    <span class="fiona-ai-mention-header-title">Pilih Jabatan</span>
                </div>
                <div id="fionaAiMentionList" class="fiona-ai-mention-list"></div>
            </div>
            <div class="fiona-ai-composer-meta">
                <span id="fionaAiDataSource" class="fiona-ai-data-source" hidden></span>
                <div class="fiona-ai-context-add-wrap">
                    <button type="button" id="fionaAiContextAdd" class="fiona-ai-context-add-btn" title="Katalog dan pencarian proses bisnis" aria-label="Katalog proses bisnis" aria-haspopup="menu" aria-expanded="false">＋ Konteks</button>
                    <div id="fionaAiContextMenu" class="fiona-ai-context-menu" role="menu" hidden>
                        <button type="button" role="menuitem" data-context-type="process">
                            <span class="menu-item-icon proc">#</span>
                            <span class="menu-item-text">Proses Bisnis</span>
                            <span class="menu-item-badge">Buka Katalog</span>
                        </button>
                        <button type="button" role="menuitem" data-context-type="position" disabled class="is-disabled" title="Pencarian lanjutan jabatan belum tersedia. Gunakan @@ pada pesan.">
                            <span class="menu-item-icon pos">@@</span>
                            <span class="menu-item-text">Jabatan</span>
                            <small class="menu-item-tag">Segera hadir</small>
                        </button>
                    </div>
                </div>
            </div>
            <div id="fionaAiMentionTags" class="fiona-ai-mention-tags" hidden></div>
            <form id="fionaAiForm" class="fiona-ai-composer">
                <div id="fionaAiInput" class="fiona-ai-input" contenteditable="true" role="textbox" aria-multiline="true" data-placeholder="Tanyakan seputar matriks RASCI ini… (ketik @@ untuk Jabatan, # untuk Proses Bisnis)" aria-label="Kirim pesan ke Fiona" spellcheck="false"></div>
                <button type="submit" id="fionaAiSend" aria-label="Kirim pesan">➤</button>
            </form>
        </div>
        <div class="fiona-ai-disclaimer">Fiona dapat membuat kekeliruan. Harap periksa kembali tindakan yang mengubah data.</div>
    </div>
    <dialog id="fionaAiContextModal" class="fiona-ai-context-modal fiona-prosbis-advanced-modal" aria-labelledby="fionaAiContextModalTitle">
        <div class="fiona-ai-context-modal-content">
            <div class="fiona-ai-context-modal-header">
                <div>
                    <span class="fiona-ai-empty-eyebrow">FIONA AI · KATALOG &amp; PENCARIAN PROSBIS</span>
                    <h2 id="fionaAiContextModalTitle">Katalog &amp; Pencarian Lanjutan Proses Bisnis</h2>
                </div>
                <button type="button" id="fionaAiContextModalClose" class="fiona-ai-memory-close" aria-label="Tutup pencarian konteks">×</button>
            </div>
            <div class="fiona-ai-context-tabs" role="tablist" hidden>
                <button type="button" id="fionaAiTabPosition" class="fiona-ai-context-tab" role="tab" aria-selected="false" hidden disabled>Jabatan / Posisi</button>
                <button type="button" id="fionaAiTabProcess" class="fiona-ai-context-tab is-active" role="tab" aria-selected="true">Proses Bisnis</button>
            </div>
            <div class="fiona-ai-context-search-bar">
                <div class="fiona-ai-context-search-wrap">
                    <svg class="fiona-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="search" id="fionaAiContextSearch" placeholder="Cari nama proses, kode, nomor indeks, input, atau output..." autocomplete="off" />
                    <button type="button" id="fionaAiContextSearchClear" class="fiona-ai-context-search-clear" title="Hapus pencarian" hidden>×</button>
                </div>
                <button type="button" id="fionaAiContextSearchButton" class="fiona-ai-context-search-button">Cari</button>
            </div>
            <div class="fiona-ai-context-filters-bar" role="toolbar" aria-label="Filter Level Proses">
                <span class="filter-label">Filter Level:</span>
                <div class="filter-pills" id="fionaAiContextLevelFilters">
                    <button type="button" class="fiona-filter-pill is-active" data-level="all">Semua Level</button>
                    <button type="button" class="fiona-filter-pill" data-level="1">L1 Enterprise</button>
                    <button type="button" class="fiona-filter-pill" data-level="2">L2 Utama</button>
                    <button type="button" class="fiona-filter-pill" data-level="3">L3 Sub-proses</button>
                    <button type="button" class="fiona-filter-pill" data-level="4">L4 Aktivitas</button>
                </div>
            </div>
            <div id="fionaAiContextSuggestions" class="fiona-ai-context-suggestions" hidden></div>
            <div id="fionaAiContextDidYouMean" class="fiona-ai-context-did-you-mean" hidden></div>
            <div id="fionaAiContextOverview" class="fiona-ai-context-overview" hidden></div>

            <div class="fiona-ai-context-body-grid">
                <!-- Left Pane: Catalog & Results List with Multi-Select -->
                <div class="fiona-ai-context-list-pane">
                    <div class="fiona-ai-context-pane-header">
                        <span id="fionaAiContextResultCount" class="result-count">Memuat proses bisnis...</span>
                        <div class="pane-header-actions">
                            <button type="button" id="fionaAiContextSelectAllVisible" class="select-all-btn">Pilih Semua di Layar</button>
                        </div>
                    </div>
                    <div id="fionaAiContextLoading" class="fiona-ai-context-loading" hidden>
                        <span class="fiona-ai-activity-spinner" aria-hidden="true"></span>
                        <span>Mencari proses bisnis...</span>
                    </div>
                    <div id="fionaAiContextList" class="fiona-ai-context-list" role="listbox" aria-multiselectable="true"></div>
                    <div id="fionaAiContextEmpty" class="fiona-ai-context-empty" hidden>
                        <strong>Tidak ada proses bisnis ditemukan</strong>
                        <p>Coba kata kunci pencarian lain atau sesuaikan filter level.</p>
                    </div>
                </div>

                <!-- Right Pane: Live Inspector Details -->
                <div class="fiona-ai-context-inspector-pane" id="fionaAiContextInspector">
                    <div class="fiona-ai-inspector-empty" id="fionaAiInspectorEmpty">
                        <div class="inspector-empty-icon">📁</div>
                        <strong>Pratinjau Proses Bisnis</strong>
                        <p>Pilih salah satu proses di sebelah kiri untuk melihat deskripsi lengkap, dokumen input, dan output.</p>
                    </div>
                    <div class="fiona-ai-inspector-content" id="fionaAiInspectorContent" hidden></div>
                </div>
            </div>

            <!-- Sticky Selection Footer -->
            <div id="fionaAiContextSelectionBar" class="fiona-ai-context-selection-bar" hidden>
                <div class="selection-meta">
                    <span class="selection-badge" id="fionaAiSelectedCountBadge">0</span>
                    <span class="selection-text">proses bisnis dipilih</span>
                </div>
                <div class="selection-actions">
                    <button type="button" id="fionaAiContextClearSelection" class="fiona-ai-memory-button secondary">Kosongkan Pilihan</button>
                    <button type="button" id="fionaAiContextInsertBatch" class="fiona-ai-memory-button primary">＋ Masukkan Konteks Terpilih</button>
                </div>
            </div>

            <div class="fiona-ai-context-modal-footer">
                <button type="button" id="fionaAiContextCancel" class="fiona-ai-memory-button secondary">Tutup</button>
            </div>
        </div>
    </dialog>
    <dialog id="fionaAiMemoryEditor" class="fiona-ai-memory-editor" aria-labelledby="fionaAiMemoryEditorTitle">
        <form id="fionaAiMemoryForm" method="dialog" novalidate>
            <div class="fiona-ai-memory-editor-header">
                <div>
                    <span class="fiona-ai-empty-eyebrow">FIONA AI · MEMORY</span>
                    <h2 id="fionaAiMemoryEditorTitle">Add memory</h2>
                </div>
                <button type="button" id="fionaAiMemoryCancel" class="fiona-ai-memory-close" aria-label="Close memory editor">×</button>
            </div>
            <div id="fionaAiMemoryFormError" class="fiona-ai-memory-form-error" role="alert" hidden></div>
            <label class="fiona-ai-memory-field">
                <span>Fact <em aria-hidden="true">*</em></span>
                <textarea id="fionaAiMemoryFact" name="fact" rows="4" maxlength="2000" required aria-describedby="fionaAiMemoryFactHelp"></textarea>
                <small id="fionaAiMemoryFactHelp">Keep this to a useful preference or working fact. Do not store sensitive information.</small>
            </label>
            <fieldset class="fiona-ai-memory-fieldset">
                <legend>Scope</legend>
                <label><input type="radio" name="scopeKind" value="user" checked /> Global preference</label>
                <label><input type="radio" name="scopeKind" value="source" /> Specific domain/source</label>
            </fieldset>
            <div id="fionaAiMemorySourceFields" class="fiona-ai-memory-source-fields" hidden>
                <label class="fiona-ai-memory-field">
                    <span>Domain</span>
                    <select id="fionaAiMemoryFormDomain" name="domain">
                        <option value="">Choose a domain</option>
                        <option value="organization">Organization</option>
                        <option value="rasci">RASCI</option>
                        <option value="jobdesc">Job description</option>
                        <option value="competency">Competency</option>
                    </select>
                </label>
                <label class="fiona-ai-memory-field">
                    <span>Source or draft key</span>
                    <input id="fionaAiMemoryScopeKey" name="scopeKey" type="text" maxlength="200" autocomplete="off" />
                </label>
            </div>
            <label id="fionaAiMemoryConfidenceField" class="fiona-ai-memory-field" hidden>
                <span>Confidence</span>
                <input id="fionaAiMemoryConfidence" name="confidence" type="number" min="0" max="100" step="1" />
                <small>Use the confidence Fiona currently shows for this memory.</small>
            </label>
            <label id="fionaAiMemoryReviewStateField" class="fiona-ai-memory-field" hidden>
                <span>Review state</span>
                <select id="fionaAiMemoryReviewState" name="reviewState">
                    <option value="active">Active</option>
                    <option value="needs_review">Needs review</option>
                </select>
            </label>
            <div class="fiona-ai-memory-editor-actions">
                <button type="button" id="fionaAiMemoryCancelSecondary" class="fiona-ai-memory-button secondary">Cancel</button>
                <button type="submit" id="fionaAiMemorySave" class="fiona-ai-memory-button primary">Save memory</button>
            </div>
        </form>
    </dialog>
</aside>
<div id="fionaAiBackdrop" class="fiona-ai-backdrop" hidden></div>
