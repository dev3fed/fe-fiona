<!-- Include Animate.css -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    .modal-dialog.edit-businesspro {
        max-width: 50% !important;
        margin: 80px auto;
    }
</style>


<div class="modal fade" id="modalEditBusinesspro" tabindex="-1" role="dialog"
    aria-labelledby="modalEditBusinessproLabel" aria-hidden="true">
