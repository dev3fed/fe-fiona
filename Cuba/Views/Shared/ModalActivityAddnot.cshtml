<!-- Include Animate.css -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    .modal-dialog.custom-notation {
        max-width: 85% !important;
        margin: 30px auto;
    }

    .tbl-border-notation {
        width: 100%;
        border-top: 1px solid #b0d1e4;
        border-right: 1px solid #b0d1e4;
        border-bottom: 1px solid #b0d1e4;
        border-left: 1px solid #b0d1e4;
        border-collapse: collapse;
        font-size: 12px !important;
    }

    .tbl-border-notation th {
        color: #006CA9;
        font-weight: bold;
        height: 40px;
    }

    .tbl-border-notation thead th {
        position: sticky;
        top: 0;
        background-color: #E6F0F6;
        z-index: 1;
        /* To ensure it stays above the content */
    }

    .tbl-border-notation th,
    .tbl-border-notation td {
        padding: 8px !important;
        border-right: 1px solid #b0d1e4;
        border-bottom: 1px solid #b0d1e4;
        border-left: 1px solid #b0d1e4;
    }

    .checkbox-label {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        margin: 0;
    }

    .checkbox_animated {
        width: 12px;
        height: 12px;
        transform: scale(0.8);
        margin-right: 5px;
    }

    .radio-label {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        margin: 0;
        text-align: center;
    }

    .radio_animated {
        margin-right: 5px;
    }

    th,
    td {
        vertical-align: middle;
        padding: 0;
    }

    .card-tblbusiness {
        height: 435px;
        border: 1px solid #BFBFC2;
        border-radius: 4px;
        padding: 10px;
        margin-top: 5px
    }

    .card-listjob {
        height: auto;
        border: 1px solid #BFBFC2;
        border-radius: 4px;
        padding: 15px;
    }

    /* Custom scrollbar styles */
    .scrollable-notation::-webkit-scrollbar {
        width: 10px;
        height: 8px;
    }

    .scrollable-notation::-webkit-scrollbar-track {
        box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.3);
        border-radius: 10px;
    }

    .scrollable-notation::-webkit-scrollbar-thumb {
        background: #006ca9;
        border-radius: 10px;
    }

    .scrollable-notation::-webkit-scrollbar-thumb:hover {
        background: #006ca9;
    }

    .scrollable-notation {
        max-height: 620px;
        overflow-y: auto;
        margin-right: 5px;
        margin-top: 5px;
        margin-bottom: 5px
    }


    .scrollable-cardbusiness::-webkit-scrollbar {
        width: 10px;
        height: 8px;
    }

    .scrollable-cardbusiness::-webkit-scrollbar-track {
        box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.3);
        border-radius: 10px;
    }

    .scrollable-cardbusiness::-webkit-scrollbar-thumb {
        background: #006ca9;
        border-radius: 10px;
    }

    .scrollable-cardbusiness::-webkit-scrollbar-thumb:hover {
        background: #006ca9;
    }

    .scrollable-cardbusiness {
        max-height: 520px;
        overflow-y: auto;
    }

    .warning-alert {
        display: inline-block;
        padding: 4px;
        margin-right: 4px;
        border: solid 1px #D53C50;
        background-color: #FAE9EB;
        border-radius: 4px;
        width: auto;
        word-wrap: break-word;
        color: #D02138;
        font-size: 10px;
    }
</style>


<div class="modal fade" id="modalActivityAddnot" tabindex="-1" role="dialog" aria-labelledby="modalActivityAddnotLabel"
    aria-hidden="true">
    <div class="modal-dialog custom-notation bounceInDown animated" role="document">
        <div class="modal-content" style="border-radius: 8px;">
            <div class="modal-header">
                <h5 class="modal-title" id="modalActivityAddnotTitle">Add RASCI Notation</h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body scrollable-notation" id="modal-body-content">
                <div class="row">
                    <div class="col-12">
                        <div class="row" id="form-activitynotation">

                        </div>
                    </div>
                    @* <div class="col-12" style="display: none;" id="activityposref">

                    </div>
                    <div class="col-6" style="display: none;" id="table-activityprosbisref">
                    </div>
                    <div class="col-6" style="display: none;" id="selectedActivityBisproref">

                    </div> *@

                    <div class="col-6 mt-2" style="display: block;" id="activity-bispro">
                        <label class="form-label">Business Process</label>
                        <div class="card-tblbusiness">
                            <div id="select-activitybusiness">
                            </div>
                            <div class="table-responsive  mt-2" style=" max-height: 450px;">
                                <table class="table tbl-border-notation">
                                    <thead id="tbl-activitynotation-header">
                                    </thead>
                                    <tbody id="tbl-activitynotation-body">
                                    </tbody>
                                </table>
                            </div>
                            <div class="d-flex mt-2 justify-content-end">
                                <button class="btn btn btn-primary" type="button" id="btn-activityselectedbusiness"
                                    onclick="triggleSelectActivitybp()" disabled>
                                    Select Business Process</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 mt-2" style="display: block;" id="selected-activitybispro">
                        <label class="form-label">Selected Business Process</label>
                        <div class="card-tblbusiness scrollable-cardbusiness" id="selected-activitybusiness">

                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer  d-flex justify-content-end">
                <div>
                    <button class="btn btn-outline-light" type="button" data-bs-dismiss="modal"
                        onclick="backChangeActivityNotation()"><i class="icon-arrow-left"></i> Back</button>
                    <button id="btnDraftActivitynotation" class="btn btn-primary" type="button"
                        onclick="saveNewActivityNotation()">
                        <div class="d-flex align-items-center">
                            <div class="spinner-border spinner-border-sm text-light me-2" style="display: none;"
                                id="spinBtnNotation" role="status"></div>
                            <span class="btn-text"> Save</span>
                        </div>
                    </button>
                </div>

            </div>
        </div>
    </div>
</div>
<!-- Bootstrap JS and Popper.js -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/js/bootstrap.min.js"></script>