<style>
    .custom-card-draft {
        height: auto;
        border: 1px solid #BFBFC2;
        border-radius: 4px;
        padding: 20px 5px 10px 15px;
        margin-top: 20px;
        position: relative;
    }

    .header-card-draft {
        background-color: #F5F5F5;
        height: 35px;
        padding-left: 15px;
        display: flex;
        align-items: center;
        font-weight: 700;
        position: absolute;
        top: -5px;
        left: 0;
        right: 0;
        border-radius: 4px 4px 0 0;
        border: 1px solid #BFBFC2;
        border-bottom: none;
        width: calc(100% + 2px);
        font-size: 14px;
        margin-left: -1px;
    }


    .custom-col {
        border-right: 1px solid #BFBFC2;
        padding-right: 10px;
        text-align: center;
    }

    .custom-col:last-child {
        border-right: none;
    }

    .custom-col label {
        display: block;
        font-size: 12px;
        margin-bottom: 5px;
    }

    .custom-row-full {
        border-top: 1px solid #BFBFC2;
        padding-right: 10px;
        padding-top: 10px;
        text-align: left;

    }

    .custom-row-full label {
        display: block;
        font-size: 12px;
        margin-top: 10px;
    }

    .btn-outline-light:hover img {
        filter: brightness(0) invert(1);
    }

    .btn-small-icon {
        padding: 2px 5px;
        font-size: 12px;
    }

    .btn-small-icon img {
        font-size: 10px;
    }

    .btn-rounded {
        border-radius: 26px;
        margin: 5px;
    }

    .icon-svg {
        stroke: #000;
        /* Warna default stroke */
        transition: stroke 0.3s ease;
        /* Transisi untuk efek halus */
    }

    .btn:hover .icon-svg {
        stroke: #fffff;
        /* Warna stroke tetap saat tombol di-hover */
    }

    .long-text {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        overflow: hidden;
        text-overflow: ellipsis;
        -webkit-box-orient: vertical;
        white-space: normal;
        flex: 1;
    }

    .empty-activity-body {
        background-color: #EAEAEB;
        height: 300px;
        background-image: url("/assets/images/rasci/empty_draftrasci.svg");
        background-position: center 60px;
        background-repeat: no-repeat;
        background-size: 230px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        padding-top: 200px;
        margin-top: 25px;
        border-radius: 7px;
        margin-right: 10px;
    }

    .activity-check-input {
        display: none;
    }

    .activity-check-label {
        border: 1px solid #BFBFC2;
        border-radius: 26px;
        padding: 8px 16px;
        margin-right: 0;
        cursor: pointer;
        background-color: #FFFFFF;
        color: #000000;
        font-size: 13px;
        transition: all 0.3s ease;
    }

    .activity-check-input:checked+.activity-check-label {
        background-color: #e6f0f6;
        color: #006ca9;
        border-color: #006ca9;
    }

    .activity-check {
        margin-bottom: 0;
        display: inline-block;
        margin-right: 15px;
    }
</style>

<div class="card" style="border-radius:8px">
    <!-- Start Modal Rename Draft  -->
    <partial name="ModalRenameDraft" />
    <!-- End Modal Rename Draft  -->

    <!-- Start Modal Draft Detail for edit notation  -->
    <partial name="ModalActivityEnot" />
    <!-- End Modal Draft Detail for edit notation  -->

    <!-- Start Modal Draft Detail for add notation from edit  -->
    <partial name="ModalActivityEditnot" />
    <!-- End Modal Draft Detail for add notation from edit  -->

    <!-- Start Modal Draft Detail for add notation from add  -->
    <partial name="ModalActivityAddnot" />
    <!-- End Modal Draft Detail for add notation from add  -->

    <!-- Start Modal Draft Detail for add new proses bisnis -->
    <partial name="ModalDetaildraftAddBp" />
    <!-- End Modal Draft Detail for add new proses bisnis -->

    <!-- Start Modal Delete Activity -->
    <partial name="ModalDeleteActivitydraft" />
    <!-- End Modal Delete Activity -->

    <!-- Start Modal Activity Detail Delete Bp  -->
    <partial name="ModalDetailDeletebp" />
    <!-- End Modal Activity Detail Delete Bp  -->

    <!-- Start Modal Activity Detail edit bp  -->
    <partial name="ModalEditActivitybp" />
    <!-- End Modal Activity Detail edit bp  -->

    <!-- Start Modal Activity Detail edit bp  -->
    <partial name="ModalDetaileditbp" />
    <!-- End Modal Activity Detail edit bp  -->


    <!-- Start Modal add notification -->
    <partial name="ModalRasciNotation" />
    <!-- End Modal add notification -->
    <div style="padding:15px">
        <h6 class="f-w-600">Draft Detail</h6>
        <!-- Card info start-->
        <div class="custom-card-draft">
            <div class="header-card-draft">
                Info
            </div>
            <div class="row" style="padding-top: 20px;" id="draft-info">
            </div>
        </div>
        <!-- Card info end-->

        <!-- Card detail start-->
        <div class="custom-card-draft">
            <div class="header-card-draft">
                Detail
            </div>
            <div id="empty-activity">

            </div>
            <div style="padding-top: 20px; display: none;" id="header-activity">
                <div style="text-align: left; margin-bottom: 15px;">
                    <span style="font-size:13px">Activity Type :</span>
                    <div class="activity-check">
                        <input class="activity-check-input" type="radio" id="activityTypeAll" name="activityType"
                               value="all" onchange="handleActivityTypeChange(event)">
                        <label class="activity-check-label" for="activityTypeAll">
                            All
                        </label>
                    </div>
                    <div class="activity-check">
                        <input class="activity-check-input" type="radio" id="activityTypeUpload" name="activityType"
                               value="upload" onchange="handleActivityTypeChange(event)">
                        <label class="activity-check-label" for="activityTypeUpload">
                            Upload
                        </label>
                    </div>
                    <div class="activity-check">
                        <input class="activity-check-input" type="radio" id="activityTypeAddNewBp" name="activityType"
                               value="addnew" onchange="handleActivityTypeChange(event)">
                        <label class="activity-check-label" for="activityTypeAddNewBp">
                            Add New Business Process
                        </label>
                    </div>
                    <div class="activity-check">
                        <input class="activity-check-input" type="radio" id="activityTypeAddEditRasci"
                               name="activityType" value="addedit" onchange="handleActivityTypeChange(event)">
                        <label class="activity-check-label" for="activityTypeAddEditRasci">
                            Add/Edit RASCI
                        </label>
                    </div>
                    <div class="activity-check">
                        <input class="activity-check-input" type="radio" id="activityTypeEditBp" name="activityType"
                               value="editbusiness" onchange="handleActivityTypeChange(event)">
                        <label class="activity-check-label" for="activityTypeEditBp">
                            Edit Business Process
                        </label>
                    </div>
                    <div class="activity-check">
                        <input class="activity-check-input" type="radio" id="activityTypeDeleteBp" name="activityType"
                               value="deletebusiness" onchange="handleActivityTypeChange(event)">
                        <label class="activity-check-label" for="activityTypeDeleteBp">
                            Delete Business Process
                        </label>
                    </div>
                </div>
                <div
                    style="display: flex; gap: 15px; justify-content: space-between; align-items: center; flex-wrap: wrap;">
                    <div style="max-width: 500px; flex: 1; text-align: left;">
                        <div class="faq-form">
                            <input class="form-control" type="text" placeholder="Search.."
                                   onchange="inputSearchActivity(event)"><i class="search-icon" data-feather="search"></i>
                        </div>
                    </div>
                    <div class="col-8 text-end mt-3" style="padding-right:23px">
                        <button class="btn btn-primary" type="button">
                            <img src="/assets/images/icon_import.svg" alt="Filter Icon" style="margin-top: -5px;">
                            Import</button>
                            @* <button class="btn btn-primary" type="button" onclick="exportDraftrasci()">
                                <img src="/assets/images/icon_export.svg" alt="Filter Icon" style="margin-top: -5px;">
                                Export</button> *@

                            <button id="btnExportDraftrasci" class="btn btn-primary" type="button"
                                    onclick="exportDraftrasci()">
                                <div class="d-flex align-items-center">
                                    <div class="spinner-border spinner-border-sm text-light me-2" style="display: none;"
                                         id="loadingExportDraftrasci" role="status"></div>
                                    <img src="/assets/images/icon_export.svg" alt="Filter Icon" style="margin-top: -5px;">
                                    <span class="btn-text">Export</span>
                                </div>
                            </button>
                        </div>

                    </div>
                </div>
                <div class="row" style="padding-top: 20px;" id="detail-prosbis">
                </div>
                @* <div style="padding-top: 20px;" id="detail-job">
            </div> *@
            </div>
            <div id="warning-draft" style="display: none;">

            </div>
            <!-- Card detail end-->

            <!-- card footer start-->
            <div class="text-end mt-2 mb-2">
                <button class="btn btn-outline-light" type="button" onclick="handleBack()">
                    <i class="icon-arrow-left"></i> Back
                </button>
                <button class="btn btn-outline-danger" type="button" onclick="deleteDraftFromdetail()"
                        id="delete-detail-draft">
                    <i class="icon-trash" style="font-size: 1em;"></i> Delete Draft
                </button>
                @* <button class=" btn btn-outline-light" type="button" onclick="handleOpenDetailBp()">
                <img src="~/assets/images/rasci/pen_outline.svg" alt="Filter Icon" style="margin-right: 8px;">Edit Draft
            </button> *@
                <button class="btn btn-primary" type="button" onclick="openDetailApproval()" id="detail-draft-submitted">
                    Submit to Approval<i class="icon-arrow-right" style="font-size: 0.8em; margin-left: 5px;"></i> </button>
                </div>
                <!-- card footer end-->
            </div>
        </div>