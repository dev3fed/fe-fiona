<style>
    .custom-card-draft {
        height: auto;
        border: 1px solid #BFBFC2;
        border-radius: 4px;
        padding: 20px 10px 10px 15px;
        margin-top: 20px;
        position: relative;
    }

    .header-card-draft {
        background-color: #F5F5F5;
        height: 35px;
        padding-left: 15px;
        display: flex;
        align-items: center;
        font-weight: 700;
        position: absolute;
        top: -5px;
        left: 0;
        right: 0;
        border-radius: 4px 4px 0 0;
        border: 1px solid #BFBFC2;
        border-bottom: none;
        width: calc(100% + 2px);
        font-size: 14px;
        margin-left: -1px;
    }


    .custom-col {
        border-right: 1px solid #BFBFC2;
        padding-right: 10px;
