        margin-bottom: 5px;
    }

    .custom-row-full {
        border-top: 1px solid #BFBFC2;
        padding-right: 10px;
        text-align: left;

    }

    .custom-row-full label {
        display: block;
        font-size: 12px;
        margin-top: 10px;
    }

    .btn-outline-light:hover img {
        filter: brightness(0) invert(1);
    }
</style>

