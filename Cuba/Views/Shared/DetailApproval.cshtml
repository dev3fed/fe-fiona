                    <label style="color:#9F9FA5">Request ID</label>
                    <label style="font-weight: 600;font-size: 14px"> Req/090924/001</label>
                </div>
                <div class="col-3 custom-col">
                    <label style="color:#9F9FA5">Requestor</label>
                    <label style="font-weight: 600;font-size: 14px">Gaiman Hutagalung</label>
