<!-- Include Animate.css -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    .modal-dialog.custom-notatrow {
        max-width: 58% !important;
        margin: 30px auto;
    }

    .tbl-border-notatrow {
        width: 100%;
        border-top: 1px solid #b0d1e4;
        border-right: 1px solid #b0d1e4;
        border-bottom: 1px solid #b0d1e4;
        border-left: 1px solid #b0d1e4;
        border-collapse: collapse;
        font-size: 12px !important;
    }

    .tbl-border-notatrow th {
        color: #006CA9;
        font-weight: bold;
        height: 40px;
    }

    .tbl-border-notatrow thead th {
        position: sticky;
        top: 0;
        background-color: #E6F0F6;
        z-index: 1;
    }

    .tbl-border-notatrow th,
    .tbl-border-notatrow td {
        padding: 8px !important;
        border-right: 1px solid #b0d1e4;
        border-bottom: 1px solid #b0d1e4;
        border-left: 1px solid #b0d1e4;
    }

    .checkbox-label {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        margin: 0;
    }

    .checkbox_animated {
        width: 12px;
        height: 12px;
        transform: scale(0.8);
        margin-right: 5px;
    }

    .radio-label {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        margin: 0;
        text-align: center;
    }

    .radio_animated {
        margin-right: 5px;
    }

    th,
    td {
        vertical-align: middle;
        padding: 0;
    }
</style>


<div class="modal fade" id="modalNotationRow" tabindex="-1" role="dialog" aria-labelledby="modalNotationRowLabel"
    aria-hidden="true">
    <div class="modal-dialog custom-notatrow bounceInDown animated" role="document">
        <div class="modal-content" style="border-radius: 8px;">
            <div class="modal-header">
                <h5 class="modal-title" id="modalNotationRowTitle">Edit RASCI</h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="modal-body-content">
                <div class="row mb-2" id="form-notatrow">

                </div>
                <div class="table-responsive" style=" max-height: 450px;">
                    <table class="table tbl-border-notatrow">
                        <thead id="tbl-notatrow-header" style="background-color: #006CA9;">
                        </thead>
                        <tbody id="tbl-notatrow-body">
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer  d-flex justify-content-end">
                <button class="btn btn-outline-light" type="button" data-bs-dismiss="modal"><i
                        class="icon-arrow-left"></i>
                    Back</button>
                <div>
                    <button class="btn btn btn-primary" type="button" data-bs-toggle="modal"
                        data-bs-target="#modalSaveDraft" id="saveDraftBtn" disabled> Save Change</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Bootstrap JS and Popper.js -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/js/bootstrap.min.js"></script>
