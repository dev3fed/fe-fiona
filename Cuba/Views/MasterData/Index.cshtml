@{
    ViewData["Title"] = "Chart-Widget";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="page-body">
    <div class="container-fluid">
        <div class="page-title">
            <div class="row">
                <div class="col-6">
                    <h3>Master Data</h3>
                </div>
                <div class="col-6">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-controller="HomePage" asp-action="Index">
                                <svg class="stroke-icon">
                                    <use href="../assets/svg/icon-sprite.svg#stroke-home"></use>
                                </svg>
                            </a>
                        </li>
                        <li class="breadcrumb-item active">Master Data</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <!-- Container-fluid starts-->
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-12">
                <div class="card" style="border-radius:8px">
                    <div class="card-body">
                        <div class="card-body">
                            <h6 class="mb-4">Please upload all the following data files and click the submit button.</h6>
                            @* row *@
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="table-responsive">
                                        <table class="tableMasterData table table-hover w-100" id="examplee">
                                            @* <tr>
                                                <th>Id</th>
                                                <th>Code</th>
                                                <th>Name</th>
                                                <th>Actions</th>
                                            </tr> *@
                                        </table>
                                    </div>
                                    @* button reset and submit *@
                                        <div class="col-md-12 mt-4">
                                            <div class="
                                                text-end">
                                                <button type="button" class="btn btn-lg btn-outline-light" style="margin-right: 10px;"><i class="fa fa-times-circle"></i> Reset</button>
                                                <button type="button" class="btn btn-lg btn-outline-primary" ><i class="icofont icofont-upload-alt"></i> Submit</button>
                                            </div>
                                        </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Container-fluid Ends-->
</div>
@section Script {
    <!-- Plugins JS start-->
    <script src="../assets/js/sidebar-menu.js"></script>
    <script src="../assets/js/slick/slick.min.js"></script>
    <script src="../assets/js/slick/slick.js"></script>
    <script src="../assets/js/header-slick.js"></script>


    <script src="../assets/js/datatable/datatables/jquery.dataTables.min.js"></script>
    <script src="../assets/js/datatable/datatables/datatable-custom-cnt.js"></script>
    <!-- Plugins JS Ends-->
    <script src="../assets/js/master-data/custom.js"></script>

    <!-- Theme js-->
    <script src="../assets/js/script.js"></script>

    <script src="../assets/js/icons/icons-notify.js"></script>
    <script src="../assets/js/icons/feather-icon/feather-icon-clipart.js"></script>
}